<Window x:Class="TMDT.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Auth"
        xmlns:helpers="clr-namespace:TMDT.Helpers"
        mc:Ignorable="d"
        Title="LogisticsPro Manager - Đăng ký" Height="850" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#C0C1FF"/>
        <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1000A9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#0B1326"/>
        <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#C7C4D7"/>

        <!-- Custom TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="Padding" Value="45,15,15,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="placeholder" Text="Nhập dữ liệu..."
                                           Foreground="#40FFFFFF" Padding="45,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#C0C1FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="45,15,15,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#C0C1FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Layer -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="Black" Opacity="0.5" ShadowDepth="0"/>
            </Border.Effect>
        </Border>

        <!-- Glow effects -->
        <Ellipse Fill="#C0C1FF" Opacity="0.1" Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-200,-200,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Main Card -->
        <Border Margin="1" CornerRadius="20" BorderBrush="#20FFFFFF" BorderThickness="1" Background="#10FFFFFF">
            <StackPanel Margin="45,40">

                <!-- Logo & Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Border Width="60" Height="60" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Margin="0,0,0,15">
                        <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                   Foreground="{StaticResource OnPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tạo tài khoản" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tham gia hệ thống Thương Mại Điện Tử" FontSize="13" Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Input Fields -->
                <StackPanel>
                    <TextBlock Text="Họ và tên" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <Grid Margin="0,0,0,15">
                        <TextBox Style="{StaticResource ModernTextBox}" x:Name="txtName"
                                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="Email" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <Grid Margin="0,0,0,15">
                        <TextBox Style="{StaticResource ModernTextBox}" x:Name="txtEmail"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="Số điện thoại" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <Grid Margin="0,0,0,15">
                        <TextBox Style="{StaticResource ModernTextBox}" x:Name="txtPhone"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Text="Mật khẩu" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,8"/>
                    <Grid Margin="0,0,0,25">
                        <PasswordBox x:Name="txtPass"
                                     Style="{StaticResource ModernPasswordBox}"
                                     helpers:PasswordBoxHelper.BindPassword="True"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"
                                   VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Register Button -->
                    <Button Content="Đăng ký tài khoản"
                            Command="{Binding RegisterCommand}"
                            Height="55"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource OnPrimaryBrush}"
                            FontWeight="Bold" FontSize="16" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Resources>
                        <Button.Effect>
                            <DropShadowEffect Color="#C0C1FF" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>

                <Button Content="Đã có tài khoản? Đăng nhập"
                        Click="BackToLogin_Click"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Margin="0,25,0,0" Cursor="Hand"/>

                <Button Content="Thoát"
                        Click="Exit_Click"
                        Background="Transparent"
                        Foreground="#40FFFFFF"
                        BorderThickness="0" Margin="0,10,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
