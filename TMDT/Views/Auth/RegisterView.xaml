<Window x:Class="TMDT.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Auth"
        xmlns:helpers="clr-namespace:TMDT.Helpers"
        mc:Ignorable="d"
        Title="Đăng ký | MyShop" Height="480" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Modern Color Palette -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#593AD8"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#451EC5"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F8F9FF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#121C2A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#484555"/>
        
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#EFF3FF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#DFE9FD"/>
        <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#593AD8"/>

        <!-- Modern TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="45,10,15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"
                                           Padding="0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputFocusedBorderBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="45,10,45,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InputFocusedBorderBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="220" CenterY="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Window Close/Minimize Style -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Entry Fade-In-Up Animation on Load -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainContainer"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.6" DecelerationRatio="0.9"/>
                    <DoubleAnimation Storyboard.TargetName="MainTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="30" To="0" Duration="0:0:0.6" DecelerationRatio="0.9"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Main Outer Border -->
        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="16" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="#2D3282" Opacity="0.08" ShadowDepth="3"/>
            </Border.Effect>
        </Border>

        <!-- Mesh Background Glow effects -->
        <Ellipse Fill="{StaticResource PrimaryBrush}" Opacity="0.04" Width="400" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-150,0,0">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Fill="{StaticResource PrimaryBrush}" Opacity="0.04" Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-150">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Custom Window Drag Layer & Header -->
        <Grid Height="48" VerticalAlignment="Top" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title Drag Space (Empty Area) -->
            <Border Background="Transparent" Grid.Column="0"/>

            <!-- Window Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area Grid (Contains landscape split card) -->
        <Grid x:Name="MainContainer" Margin="0,48,0,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainTransform" Y="0"/>
            </Grid.RenderTransform>
            
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,15">
                <!-- Landscape Card Container -->
                <Border Width="740" Height="370" Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" BorderThickness="1" BorderBrush="#DFE9FD">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" Color="#2D3282" Direction="270" ShadowDepth="4" Opacity="0.05"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left Column: Purple Branding Banner -->
                            <ColumnDefinition Width="260"/>
                            <!-- Right Column: Form Area -->
                            <ColumnDefinition Width="478"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: BRANDING SPLIT -->
                        <Border Grid.Column="0" CornerRadius="15,0,0,15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#593AD8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            
                            <Grid Margin="24">
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                    <TextBlock Text="MyShop" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Retail Ecosystem" FontSize="11" Foreground="#C9BFFF" Opacity="0.8" FontWeight="Medium" Margin="2,2,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" Margin="0,30,0,0">
                                    <TextBlock Text="Tạo tài khoản mới!" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Đăng ký tài khoản MyShop để khám phá tính năng mua sắm toàn diện và nhận nhiều ưu đãi đặc biệt." FontSize="11.5" Foreground="#E2E8F0" Opacity="0.9" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="17" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <!-- SSL Trust tag at bottom of purple band -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Opacity="0.8">
                                    <TextBlock Text="&#xE727;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bảo mật SSL 256-bit" FontSize="10.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="5,0,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- RIGHT COLUMN: FORM AREA (GRID 2x2) -->
                        <Grid Grid.Column="1" Margin="32,24">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Title -->
                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Đăng ký tài khoản" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Tham gia hệ thống phân phối thông minh MyShop" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.75" Margin="0,3,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <!-- 2x2 Fields Grid -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0, Column 0: Họ và tên -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Họ và tên" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,4" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <Grid>
                                            <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}" Tag="Nguyễn Văn A"
                                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 0, Column 2: Email -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Email" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,4" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <Grid>
                                            <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBox}" Tag="username@email.com"
                                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2, Column 0: Số điện thoại -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Số điện thoại" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,4" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <Grid>
                                            <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBox}" Tag="0901234567"
                                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="38"/>
                                            <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2, Column 2: Mật khẩu -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Mật khẩu" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,4" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <Grid>
                                            <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"
                                                         helpers:PasswordBoxHelper.BindPassword="True"
                                                         helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         PasswordChanged="txtPassword_PasswordChanged"
                                                         Height="38"/>
                                            
                                            <TextBlock x:Name="txtPasswordPlaceholder" Text="Mật khẩu" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.4"
                                                       Padding="45,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            
                                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            
                                            <Button x:Name="btnToggleShowPassword" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand" Click="TogglePassword_Click" Width="28" Height="28">
                                                <TextBlock x:Name="tbEyeIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                            
                                            <TextBox x:Name="txtPasswordPlain" Style="{StaticResource ModernTextBox}" Tag="Mật khẩu"
                                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     Height="38" Visibility="Collapsed" Padding="45,10,45,10"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Submit Button (Full Width of Form) -->
                                <Button Content="Đăng ký tài khoản" Style="{StaticResource AccentButtonStyle}" Height="40"
                                        Command="{Binding RegisterCommand}">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#593AD8" BlurRadius="12" ShadowDepth="1" Opacity="0.2"/>
                                    </Button.Effect>
                                </Button>

                                <!-- Navigation Switch -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <TextBlock Text="Bạn đã có tài khoản MyShop?" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.8" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Đăng nhập ngay" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="5,0,0,0" Cursor="Hand" MouseLeftButtonDown="BackToLogin_Click" FontFamily="Be Vietnam Pro, Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
