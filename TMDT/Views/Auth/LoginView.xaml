<Window x:Class="TMDT.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Auth"
        xmlns:helpers="clr-namespace:TMDT.Helpers"
        mc:Ignorable="d"
        Title="Đăng nhập | MyShop" Height="480" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Design System Color Palette — MyShop Brand Sync -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#5B5CEB"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#6C63FF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3AED0"/>
        
        <!-- Modern TextBox Style with Focus Glow & Soft Error -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#2A1F72"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="BorderBrush" Value="#5B5CEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Glow border for focus -->
                            <Border x:Name="glow" CornerRadius="8" Opacity="0" Background="Transparent" BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6C63FF" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Border BorderBrush="#6C63FF" BorderThickness="1.5" CornerRadius="8"/>
                            </Border>
                            
                            <!-- Glow border for error -->
                            <Border x:Name="errorGlow" CornerRadius="8" Opacity="0" Background="Transparent" BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <Border BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8"/>
                            </Border>

                            <!-- Main Border -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="#8080C0" Opacity="0.35"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>

                            <!-- Content Grid -->
                            <Grid Margin="1">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="40,0,40,0"/>
                                
                                <!-- Placeholder (Hidden by default, shown via triggers) -->
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" 
                                           Foreground="#94A3B8" Opacity="0.5" Visibility="Collapsed"
                                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <!-- Warning Icon (Hidden by default) -->
                                <TextBlock x:Name="warningIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" 
                                           FontSize="13" Foreground="#EF4444" Opacity="0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Placeholder display logic -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>

                            <!-- Focus Glow Animation -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6C63FF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Soft Error Glow Trigger -->
                            <DataTrigger Binding="{Binding DataContext.IsLoginFailed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="warningIcon" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" 
                                                             From="8" To="14" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="2x"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="warningIcon" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A1F72"/>
            <Setter Property="Foreground" Value="#F0F4FF"/>
            <Setter Property="BorderBrush" Value="#5B5CEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <!-- Glow border for focus -->
                            <Border x:Name="glow" CornerRadius="8" Opacity="0" Background="Transparent" BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6C63FF" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Border BorderBrush="#6C63FF" BorderThickness="1.5" CornerRadius="8"/>
                            </Border>
                            
                            <!-- Glow border for error -->
                            <Border x:Name="errorGlow" CornerRadius="8" Opacity="0" Background="Transparent" BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Border.Effect>
                                <Border BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8"/>
                            </Border>

                            <!-- Main Border -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="#8080C0" Opacity="0.35"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>

                            <!-- Content Grid -->
                            <Grid Margin="1">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="40,0,40,0"/>
                                
                                <!-- Placeholder (Hidden by default) -->
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" 
                                           Foreground="#94A3B8" Opacity="0.5" Visibility="Collapsed"
                                           Margin="40,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>

                                <!-- Warning Icon (Hidden by default) -->
                                <TextBlock x:Name="warningIcon" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" 
                                           FontSize="13" Foreground="#EF4444" Opacity="0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Placeholder display logic via PasswordBoxHelper.BoundPassword -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(helpers:PasswordBoxHelper.BoundPassword)}" Value=""/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>

                            <!-- Focus Glow Animation -->
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#6C63FF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Soft Error Glow Trigger -->
                            <DataTrigger Binding="{Binding DataContext.IsLoginFailed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="warningIcon" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" 
                                                             From="8" To="14" Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="2x"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="errorGlow" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="warningIcon" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style with Morph Loading -->
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="buttonGrid" HorizontalAlignment="Center">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Grid.RenderTransform>
                            <!-- Background Border -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="19" Height="38" Width="160">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="buttonShadow" Color="#5B5CEB" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                </Border.Effect>
                                
                                <Grid>
                                    <!-- Regular Content -->
                                    <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <!-- Spinner (Hidden by default) -->
                                    <Grid x:Name="spinnerGrid" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Stroke="#FFFFFF" StrokeThickness="2" StrokeDashArray="3 1.5" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="spinnerRotate" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Magnetic Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonGrid" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-2" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonShadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonShadow" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonGrid" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonShadow" Storyboard.TargetProperty="BlurRadius" To="8" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="buttonShadow" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Press Feedback -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.98" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.98" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Morph Loading State -->
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Shrink button to a circle -->
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Width" To="38" Duration="0:0:0.25" DecelerationRatio="0.9"/>
                                            <!-- Hide content, show spinner -->
                                            <DoubleAnimation Storyboard.TargetName="contentPresenter" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="spinnerGrid" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.10" Duration="0:0:0.15"/>
                                            <!-- Rotate Spinner -->
                                            <DoubleAnimation Storyboard.TargetName="spinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="Width" To="160" Duration="0:0:0.25" DecelerationRatio="0.9"/>
                                            <DoubleAnimation Storyboard.TargetName="contentPresenter" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="spinnerGrid" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Social Login Button Style with Glassmorphic design -->
        <Style x:Key="SocialButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Opacity" Value="0.06"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1.0" ScaleY="1.0" CenterX="20" CenterY="19"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.12"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Action Buttons (Minimize/Exit) -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Opacity" Value="0.1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cover and Uncover Eyes Storyboards for Mascot Password Cover -->
        <Storyboard x:Key="CoverEyesStoryboard">
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-80" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="16" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
            
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="-80" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="-16" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>

            <DoubleAnimation Storyboard.TargetName="leftPupil" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="rightPupil" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
            
            <DoubleAnimation Storyboard.TargetName="leftEyeClosed" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="rightEyeClosed" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
        </Storyboard>

        <Storyboard x:Key="UncoverEyesStoryboard">
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="0" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="leftHand" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
            
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" To="0" Duration="0:0:0.22" DecelerationRatio="0.9"/>
            <DoubleAnimation Storyboard.TargetName="rightHand" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>

            <DoubleAnimation Storyboard.TargetName="leftPupil" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="rightPupil" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
            
            <DoubleAnimation Storyboard.TargetName="leftEyeClosed" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetName="rightEyeClosed" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18"/>
        </Storyboard>

        <!-- Mascot Error Feedback Storyboard -->
        <Storyboard x:Key="ErrorFeedbackStoryboard">
            <DoubleAnimation Storyboard.TargetName="mouthNeutral" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="mouthSad" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="MascotErrorGlow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="RobotBorderBrush" Storyboard.TargetProperty="Color" To="#EF4444" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="RobotBodyTransform" Storyboard.TargetProperty="(TransformGroup.Children)[0].(RotateTransform.Angle)" From="0" To="-5" Duration="0:0:0.08" AutoReverse="True" RepeatBehavior="2x"/>
        </Storyboard>

        <!-- Mascot Error Reset Feedback Storyboard -->
        <Storyboard x:Key="ErrorFeedbackResetStoryboard">
            <DoubleAnimation Storyboard.TargetName="mouthNeutral" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="mouthSad" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="MascotErrorGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="RobotBorderBrush" Storyboard.TargetProperty="Color" To="#6366F1" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- Mascot Success Feedback Storyboard -->
        <Storyboard x:Key="SuccessFeedbackStoryboard">
            <DoubleAnimation Storyboard.TargetName="mouthNeutral" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="mouthSmile" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="leftPupil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="rightPupil" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="MascotCheckmark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="MascotCheckmark" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.3" DecelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetName="MascotCheckmark" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.3" DecelerationRatio="0.8"/>
            <DoubleAnimation Storyboard.TargetName="MascotSuccessGlow" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="RobotBorderBrush" Storyboard.TargetProperty="Color" To="#10B981" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <!-- Window Loaded Entrance & Background Floating Shapes Animations -->
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Background Shapes Animating Forever -->
                    <DoubleAnimation Storyboard.TargetName="BlurShape1Transform" Storyboard.TargetProperty="X"
                                     From="-80" To="180" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="BlurShape1Transform" Storyboard.TargetProperty="Y"
                                     From="-40" To="100" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
                    
                    <DoubleAnimation Storyboard.TargetName="BlurShape2Transform" Storyboard.TargetProperty="X"
                                     From="80" To="-180" Duration="0:0:25" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="BlurShape2Transform" Storyboard.TargetProperty="Y"
                                     From="40" To="-120" Duration="0:0:20" AutoReverse="True" RepeatBehavior="Forever"/>
                    
                    <!-- Mascot Floating & Blinking Animations -->
                    <DoubleAnimation Storyboard.TargetName="MascotFloatTransform" Storyboard.TargetProperty="Y"
                                     From="0" To="-6" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever" DecelerationRatio="0.5" AccelerationRatio="0.5"/>
                    <DoubleAnimation Storyboard.TargetName="leftPupil" Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1.0" To="0.0" Duration="0:0:0.1" BeginTime="0:0:4.0" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="rightPupil" Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1.0" To="0.0" Duration="0:0:0.1" BeginTime="0:0:4.0" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="leftPupil" Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1.0" To="0.0" Duration="0:0:0.1" BeginTime="0:0:8.5" AutoReverse="True"/>
                    <DoubleAnimation Storyboard.TargetName="rightPupil" Storyboard.TargetProperty="RenderTransform.(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="1.0" To="0.0" Duration="0:0:0.1" BeginTime="0:0:8.5" AutoReverse="True"/>

                    <!-- Soft Entrance Fade & Scale -->
                    <DoubleAnimation Storyboard.TargetName="MainContainer" Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0" Duration="0:0:0.75" DecelerationRatio="0.9"/>
                    <DoubleAnimation Storyboard.TargetName="MainScaleTransform" Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1.0" Duration="0:0:0.75" DecelerationRatio="0.9"/>
                    <DoubleAnimation Storyboard.TargetName="MainScaleTransform" Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1.0" Duration="0:0:0.75" DecelerationRatio="0.9"/>

                    <!-- Staggered Reveal Animations -->
                    <DoubleAnimation Storyboard.TargetName="RevealTitleTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.12" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealTitle" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.5"/>

                    <DoubleAnimation Storyboard.TargetName="RevealUsernameTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.22" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealUsername" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.22" Duration="0:0:0.5"/>

                    <DoubleAnimation Storyboard.TargetName="RevealPasswordTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.32" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealPassword" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.32" Duration="0:0:0.5"/>

                    <DoubleAnimation Storyboard.TargetName="RevealOptionsTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.42" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealOptions" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.42" Duration="0:0:0.5"/>

                    <DoubleAnimation Storyboard.TargetName="RevealButtonsTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.52" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealButtons" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.52" Duration="0:0:0.5"/>

                    <DoubleAnimation Storyboard.TargetName="RevealLinkTransform" Storyboard.TargetProperty="Y" From="15" To="0" BeginTime="0:0:0.62" Duration="0:0:0.5" DecelerationRatio="0.95"/>
                    <DoubleAnimation Storyboard.TargetName="RevealLink" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.62" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- ========================================== -->
        <!-- ANIMATED GRADIENT BACKGROUND WITH BLUR SHAPES -->
        <!-- ========================================== -->
        <Grid Panel.ZIndex="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F1445" Offset="0"/>
                    <GradientStop Color="#2B1B69" Offset="0.6"/>
                    <GradientStop Color="#3A2A82" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <!-- Shape 1 (Brand Purple blur) -->
            <Ellipse Width="350" Height="350" Fill="#5B5CEB" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-50,-50,0,0">
                <Ellipse.Effect>
                    <BlurEffect Radius="120"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlurShape1Transform"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            
            <!-- Shape 2 (Indigo blur) -->
            <Ellipse Width="400" Height="400" Fill="#6C63FF" Opacity="0.10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-80,-80">
                <Ellipse.Effect>
                    <BlurEffect Radius="140"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlurShape2Transform"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- Drag Layer & Window Header Control -->
        <Grid Height="48" VerticalAlignment="Top" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="Transparent" Grid.Column="0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Entrance Animated Grid -->
        <Grid x:Name="MainContainer" Margin="0,48,0,0" Opacity="0">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="MainScaleTransform" ScaleX="0.96" ScaleY="0.96" CenterX="380" CenterY="210"/>
            </Grid.RenderTransform>
            
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,10,15">
                <!-- ========================================== -->
                <!-- GLASSMORPHISM CONTAINER (CARD REDESIGN) -->
                <!-- ========================================== -->
                <Border Width="680" Height="370" CornerRadius="20" BorderThickness="1.2">
                    <Border.Background>
                        <SolidColorBrush Color="#241A68" Opacity="0.75"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7B72FF" Offset="0" />
                            <GradientStop Color="#4C3FAA" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="#2B1B69" Direction="270" ShadowDepth="8" Opacity="0.5"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Left: Branding Side -->
                            <ColumnDefinition Width="260"/>
                            <!-- Right: Login Form -->
                            <ColumnDefinition Width="418"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: MASCOT & BRANDING -->
                        <Border Grid.Column="0" CornerRadius="19,0,0,19" BorderThickness="0,0,1.2,0" BorderBrush="#30FFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2C1F6D" Offset="0"/>
                                    <GradientStop Color="#3D2D8A" Offset="0.6"/>
                                    <GradientStop Color="#5B5CEB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            
                            <Grid Margin="16">
                                <!-- Top Branding -->
                                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Text="MyShop AI" FontSize="16" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#5B5CEB" BlurRadius="10" Opacity="0.6" ShadowDepth="0"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="Trợ lý vận hành thông minh" FontSize="9.5" Foreground="#D4D8FF" Opacity="0.85" FontWeight="Medium" Margin="0,2,0,0" HorizontalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <!-- Mascot Container (Floating) -->
                                <Grid x:Name="MascotContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Width="180" Height="180" Margin="0,0,0,10">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="MascotFloatTransform" Y="0"/>
                                    </Grid.RenderTransform>
                                    
                                    <!-- Ambient Glow behind Mascot -->
                                    <Ellipse Width="120" Height="120" Fill="#5B5CEB" Opacity="0.20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="45"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="MascotSuccessGlow" Width="120" Height="120" Fill="#10B981" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="45"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse x:Name="MascotErrorGlow" Width="120" Height="120" Fill="#EF4444" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="45"/>
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Robot Body Outer Border (Cyber Capsule) -->
                                    <Border x:Name="RobotBody" Width="110" Height="130" CornerRadius="55" BorderThickness="1.5" Background="#1A183C" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border.BorderBrush>
                                            <SolidColorBrush x:Name="RobotBorderBrush" Color="#6C63FF"/>
                                        </Border.BorderBrush>
                                        <Border.RenderTransform>
                                            <TransformGroup x:Name="RobotBodyTransform">
                                                <RotateTransform Angle="0" CenterX="55" CenterY="65"/>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="55" CenterY="65"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#5B5CEB" BlurRadius="14" ShadowDepth="0" Opacity="0.3"/>
                                        </Border.Effect>
                                        
                                        <Grid>
                                            <!-- Visor (Kính Led) -->
                                            <Border x:Name="RobotVisor" Width="86" Height="48" CornerRadius="24" Background="#0C0A21" BorderThickness="1" BorderBrush="#312E81" VerticalAlignment="Top" Margin="0,22,0,0">
                                                <Grid x:Name="MascotCenter">
                                                    <!-- Eye Lights (Sclera) -->
                                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="66">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Left Eye -->
                                                        <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                            <Ellipse Width="18" Height="18" Fill="#1E1B4B" Stroke="#4338CA" StrokeThickness="1"/>
                                                            <!-- Pupil with glow -->
                                                            <Ellipse x:Name="leftPupil" Width="8" Height="8" Fill="#67E8F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="4" CenterY="4"/>
                                                                        <TranslateTransform x:Name="leftPupilTransform"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>
                                                            
                                                            <!-- Eye Close Line -->
                                                            <Line x:Name="leftEyeClosed" X1="2" Y1="9" X2="16" Y2="9" Stroke="#67E8F9" StrokeThickness="2" Opacity="0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                                <Line.Effect>
                                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                                </Line.Effect>
                                                            </Line>
                                                        </Grid>
                                                        
                                                        <!-- Right Eye -->
                                                        <Grid Grid.Column="1" HorizontalAlignment="Center">
                                                            <Ellipse Width="18" Height="18" Fill="#1E1B4B" Stroke="#4338CA" StrokeThickness="1"/>
                                                            <!-- Pupil with glow -->
                                                            <Ellipse x:Name="rightPupil" Width="8" Height="8" Fill="#67E8F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Ellipse.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="4" CenterY="4"/>
                                                                        <TranslateTransform x:Name="rightPupilTransform"/>
                                                                    </TransformGroup>
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>

                                                            <!-- Eye Close Line -->
                                                            <Line x:Name="rightEyeClosed" X1="2" Y1="9" X2="16" Y2="9" Stroke="#67E8F9" StrokeThickness="2" Opacity="0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                                <Line.Effect>
                                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                                </Line.Effect>
                                                            </Line>
                                                        </Grid>
                                                    </Grid>

                                                    <!-- Checkmark (for Success reaction) -->
                                                    <Path x:Name="MascotCheckmark" Data="M 2,7 L 6,11 L 14,3" Stroke="#10B981" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                                                        <Path.RenderTransform>
                                                            <ScaleTransform ScaleX="0.0" ScaleY="0.0" CenterX="8" CenterY="7"/>
                                                        </Path.RenderTransform>
                                                        <Path.Effect>
                                                            <DropShadowEffect Color="#10B981" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                                        </Path.Effect>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            
                                            <!-- Mouth Area -->
                                            <Grid VerticalAlignment="Bottom" Margin="0,0,0,26" Height="16">
                                                <!-- Neutral Mouth -->
                                                <Line x:Name="mouthNeutral" X1="45" Y1="8" X2="65" Y2="8" Stroke="#4F46E5" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"/>
                                                
                                                <!-- Smile Mouth (Success) -->
                                                <Path x:Name="mouthSmile" Data="M 0,0 Q 8,8 16,0" Stroke="#10B981" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Opacity="0">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Path.Effect>
                                                </Path>
                                                
                                                <!-- Sad Mouth (Error) -->
                                                <Path x:Name="mouthSad" Data="M 0,8 Q 8,0 16,8" Stroke="#EF4444" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Opacity="0">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Path.Effect>
                                                </Path>
                                            </Grid>

                                            <!-- Inner Chest LED Indicator -->
                                            <Ellipse Width="8" Height="8" Fill="#22D3EE" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#22D3EE" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- Hands / Visor cover (Password cover animation) -->
                                    <Canvas Width="180" Height="180" IsHitTestVisible="False">
                                        <!-- Left Hand -->
                                        <Border x:Name="leftHand" Width="18" Height="18" CornerRadius="9" Background="#1E1B4B" BorderThickness="1.5" BorderBrush="#6366F1" Canvas.Left="34" Canvas.Top="115" Opacity="0">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="0" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <!-- Right Hand -->
                                        <Border x:Name="rightHand" Width="18" Height="18" CornerRadius="9" Background="#1E1B4B" BorderThickness="1.5" BorderBrush="#6366F1" Canvas.Left="128" Canvas.Top="115" Opacity="0">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="0" X="0"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Canvas>
                                </Grid>

                                <!-- Bottom Status / Footer info -->
                                <TextBlock Text="Mascot v1.0 • Chờ đăng nhập" VerticalAlignment="Bottom" FontSize="9.5" Foreground="#94A3B8" Opacity="0.5" HorizontalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </Grid>
                        </Border>

                        <!-- RIGHT COLUMN: LOGIN FORM -->
                        <Grid Grid.Column="1" Margin="32,24">
                            <StackPanel VerticalAlignment="Center">
                                
                                <!-- Stagger 1: Title -->
                                <StackPanel x:Name="RevealTitle" Margin="0,0,0,20" Opacity="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="RevealTitleTransform" Y="15"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Đăng nhập" FontSize="22" FontWeight="Bold" Foreground="#F0F4FF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Quản lý hệ thống bán hàng của bạn" FontSize="12" Foreground="#A3AED0" Margin="0,3,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <!-- Stagger 2: Username -->
                                <Grid x:Name="RevealUsername" Margin="0,0,0,12" Opacity="0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RevealUsernameTransform" Y="15"/>
                                    </Grid.RenderTransform>
                                    <TextBox x:Name="txtUsername" Style="{StaticResource ModernTextBox}" Tag="Tên đăng nhập hoặc Email"
                                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" Opacity="0.5" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>

                                <!-- Stagger 3: Password -->
                                <Grid x:Name="RevealPassword" Margin="0,0,0,12" Opacity="0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RevealPasswordTransform" Y="15"/>
                                    </Grid.RenderTransform>
                                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"
                                                 helpers:PasswordBoxHelper.BindPassword="True"
                                                 helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 PasswordChanged="txtPassword_PasswordChanged" Tag="Mật khẩu"/>
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" Opacity="0.5" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    
                                    <Button x:Name="btnToggleShowPassword" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand" Click="TogglePassword_Click" Width="28" Height="28">
                                        <TextBlock x:Name="tbEyeIcon" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#94A3B8" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    
                                    <TextBox x:Name="txtPasswordPlain" Style="{StaticResource ModernTextBox}" Tag="Mật khẩu"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Visibility="Collapsed"/>
                                </Grid>

                                <!-- Stagger 4: Options -->
                                <Grid x:Name="RevealOptions" Margin="4,0,4,16" Opacity="0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RevealOptionsTransform" Y="15"/>
                                    </Grid.RenderTransform>
                                    <CheckBox Content="Ghi nhớ đăng nhập" Foreground="#94A3B8" 
                                              FontSize="11.5" FontWeight="Medium" VerticalContentAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI">
                                        <CheckBox.Resources>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Style>
                                        </CheckBox.Resources>
                                    </CheckBox>
                                    <TextBlock Text="Quên mật khẩu?" Foreground="#6C63FF" 
                                               FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Cursor="Hand" FontFamily="Be Vietnam Pro, Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Stagger 5: Buttons (Submit & Socials) -->
                                <Grid x:Name="RevealButtons" Opacity="0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RevealButtonsTransform" Y="15"/>
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Submit Button -->
                                    <Button Grid.Column="0" Content="Đăng nhập" Style="{StaticResource AccentButtonStyle}" Height="38"
                                            Command="{Binding LoginCommand}"/>

                                    <!-- Social Logins -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Google -->
                                        <Button Style="{StaticResource SocialButtonStyle}" Height="38">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#EA4335" Data="M12 5.04c1.67 0 3.17.58 4.35 1.71l3.25-3.25C17.65 1.58 15.01 1 12 1 7.37 1 3.4 3.63 1.48 7.48l3.79 2.94C6.21 7.15 8.87 5.04 12 5.04z"/>
                                                    <Path Fill="#4285F4" Data="M23.49 12.27c0-.81-.07-1.59-.2-2.36H12v4.51h6.46c-.29 1.48-1.14 2.73-2.42 3.58v2.98h3.91c2.28-2.1 3.54-5.19 3.54-8.71z"/>
                                                    <Path Fill="#FBBC05" Data="M5.27 14.58c-.24-.71-.37-1.47-.37-2.26s.13-1.55.37-2.26L1.48 7.12C.67 8.74.2 10.56.2 12.5s.47 3.76 1.28 5.38l3.79-2.94C5.14 16.13 5.14 15.22 5.27 14.58z"/>
                                                    <Path Fill="#34A853" Data="M12 23c3.24 0 5.97-1.07 7.96-2.91l-3.91-2.98c-1.08.72-2.48 1.15-4.05 1.15-3.13 0-5.79-2.11-6.73-4.94l-3.79 2.94C3.4 20.37 7.37 23 12 23z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>

                                        <!-- Facebook -->
                                        <Button Grid.Column="2" Style="{StaticResource SocialButtonStyle}" Height="38">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#1877F2" Data="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Grid>

                                <!-- Stagger 6: Navigation Link -->
                                <StackPanel x:Name="RevealLink" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Opacity="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="RevealLinkTransform" Y="15"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="Bạn chưa có tài khoản MyShop?" FontSize="11.5" Foreground="#94A3B8" Opacity="0.8" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Đăng ký ngay" FontSize="11.5" FontWeight="Bold" Foreground="#6C63FF" Margin="5,0,0,0" Cursor="Hand" MouseLeftButtonDown="GoToRegister_Click" FontFamily="Be Vietnam Pro, Segoe UI">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
