<Window x:Class="TMDT.Views.Auth.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Auth"
        xmlns:helpers="clr-namespace:TMDT.Helpers"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Volox - Đăng nhập" Height="550" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        TextElement.FontFamily="Segoe UI, sans-serif">

    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#5221E7"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="TextMain" Color="#1A1B22"/>
        <SolidColorBrush x:Key="TextMuted" Color="#797588"/>

        <!-- TextBox Style -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="CleanPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#FFFFFF" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="20" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Branding Pane -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6B46FF" Offset="0"/>
                        <GradientStop Color="#3B1C9B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Decorative shapes -->
                    <Ellipse Fill="#FFFFFF" Opacity="0.05" Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
                    <Ellipse Fill="#FFFFFF" Opacity="0.1" Width="200" Height="200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>
                    
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                        <TextBlock Text="Volox" FontSize="56" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Nền tảng thương mại điện tử đột phá." FontSize="16" Foreground="#D5C9FF" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right Login Form -->
            <Grid Grid.Column="1" Margin="48,32,48,32">
                <!-- Close Button -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Margin="0,-16,-32,0" Background="Transparent" BorderThickness="0" Click="ExitButton_Click" Cursor="Hand" Padding="0">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="{StaticResource TextMuted}"/>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đăng nhập" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
                    <TextBlock Text="Vui lòng đăng nhập để tiếp tục" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,0,32"/>

                    <!-- Email Field -->
                    <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CleanTextBoxStyle}" materialDesign:HintAssist.Hint="Nhập email của bạn" materialDesign:TextFieldAssist.DecorationVisibility="Hidden" Margin="0,0,0,20"/>

                    <!-- Password Field -->
                    <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="txtPassword" helpers:PasswordBoxHelper.BindPassword="True" helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CleanPasswordBoxStyle}" materialDesign:HintAssist.Hint="Nhập mật khẩu" materialDesign:TextFieldAssist.DecorationVisibility="Hidden" Margin="0,0,0,16"/>

                    <!-- Remember & Forgot Password -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <CheckBox Grid.Column="0" Content="Ghi nhớ đăng nhập" FontSize="13" Foreground="{StaticResource TextMuted}">
                            <CheckBox.Resources>
                                <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#5221E7"/>
                            </CheckBox.Resources>
                        </CheckBox>
                        
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Hyperlink Command="{Binding ShowForgotPasswordCommand}" Foreground="{StaticResource Primary}" TextDecorations="None" FontWeight="SemiBold" FontSize="13">
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                                Quên mật khẩu?
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}" Height="44" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8B6EFF" Offset="0"/>
                                <GradientStop Color="#6B46FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" x:Name="bgBorder">
                                    <Grid>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="loading" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" Width="20" Height="20" Foreground="White" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bgBorder" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Foreground" Value="Transparent"/>
                                        <Setter TargetName="loading" Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Đăng nhập" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </Button>

                    <!-- Google Login -->
                    <Button Command="{Binding LoginWithGoogleCommand}" Height="44" Background="White" BorderThickness="1" BorderBrush="#E3E1EC" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" x:Name="bgBorder">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bgBorder" Property="Background" Value="#F4F5F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Google" Width="18" Height="18" Foreground="#4285F4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Đăng nhập bằng Google" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sign Up -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                        <TextBlock Text="Bạn chưa có tài khoản?" FontSize="14" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Margin="4,0,0,0">
                            <Hyperlink Click="GoToRegister_Click" Foreground="{StaticResource Primary}" TextDecorations="None" FontWeight="SemiBold" FontSize="14">
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                                Đăng ký
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
