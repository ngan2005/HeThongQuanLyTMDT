<UserControl x:Class="TMDT.Views.Buyer.BuyerMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:buyerViews="clr-namespace:TMDT.Views.Buyer"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="#F4F5F7"
             TextElement.FontFamily="Segoe UI, sans-serif">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse"/>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVis"/>

        <!-- Templates -->
        <DataTemplate DataType="{x:Type vmBuyer:BuyerHomeViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerHomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:ProductDetailViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:ProductDetailView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:CartViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:CartView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerOrdersViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerProfileViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:WishlistViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:WishlistView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerProductsViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerPromotionsViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerPromotionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerGuideViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerGuideView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerContactViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerContactView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerShopViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerShopView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerComparisonViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerComparisonView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmBuyer:BuyerNotificationViewModel}" xmlns:vmBuyer="clr-namespace:TMDT.ViewModels.Buyer">
            <buyerViews:BuyerNotificationView/>
        </DataTemplate>

        <SolidColorBrush x:Key="Primary" Color="#5221E7"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceVariant" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="TextMain" Color="#1A1B22"/>
        <SolidColorBrush x:Key="TextMuted" Color="#797588"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Section (Logo, Search, Actions) -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- Top Utility Bar (Small) -->
                <Border Background="{StaticResource SurfaceVariant}" Padding="24,6">
                    <Grid>
                        <!-- Left Info -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Phone" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="Hỗ trợ: 1900 1234" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="4,0,16,0" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="Email" Width="14" Height="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="support@volox.vn" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Chua dang nhap -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVisInverse}}">
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource Primary}" Command="{Binding LoginCommand}" Padding="8,0" Height="24">
                                    <TextBlock Text="Đăng nhập / Đăng ký" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>

                            <!-- Da dang nhap -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UserName, StringFormat='Xin chào, {0}'}" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource TextMuted}" Command="{Binding GoProfileCommand}" Padding="8,0" Height="24" Cursor="Hand">
                                    <TextBlock Text="Tài khoản" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="{StaticResource TextMuted}" Command="{Binding GoOrdersCommand}" Padding="8,0" Height="24" Cursor="Hand">
                                    <TextBlock Text="Đơn mua" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Foreground="#BA1A1A" Command="{Binding LogoutCommand}" Padding="8,0" Height="24" Cursor="Hand">
                                    <TextBlock Text="Đăng xuất" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Header Area -->
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Logo -->
                        <ColumnDefinition Width="*"/>    <!-- Search -->
                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding GoHomeCommand}" Padding="0" Height="Auto" Margin="0,0,32,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Gradient Text Logo -->
                            <TextBlock Text="Volox" FontSize="36" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#8B6EFF" Offset="0"/>
                                        <GradientStop Color="#5221E7" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Search Box -->
                    <Grid Grid.Column="1" MaxWidth="800" MinWidth="300" HorizontalAlignment="Stretch" Margin="32,0">
                        <Border Background="{StaticResource SurfaceVariant}" CornerRadius="24" BorderThickness="1" BorderBrush="#E3E1EC">
                            <Grid>
                                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="Transparent" BorderThickness="0"
                                         FontSize="14" Foreground="{StaticResource TextMain}"
                                         Padding="24,0,56,0" VerticalContentAlignment="Center"
                                         materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm, thương hiệu..."
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6"
                                        Background="{StaticResource Primary}" BorderThickness="0"
                                        Width="36" Height="36" Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Command="{Binding SearchCommand}" Cursor="Hand">
                                    <materialDesign:PackIcon Kind="Search" Width="20" Height="20" Foreground="White"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                        <!-- Seller Portal / Become Seller Buttons -->
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#6B46FF" BorderBrush="#6B46FF"
                                FontWeight="SemiBold" Command="{Binding OpenSellerPortalCommand}" Margin="0,0,24,0" Padding="16,8" Height="Auto"
                                Visibility="{Binding IsSeller, Converter={StaticResource BoolToVis}}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Store" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Kênh Người bán" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#6B46FF" BorderBrush="#6B46FF"
                                FontWeight="SemiBold" Command="{Binding BecomeSellerCommand}" Margin="0,0,24,0" Padding="16,8" Height="Auto"
                                Visibility="{Binding IsBuyer, Converter={StaticResource BoolToVis}}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StorePlusOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Trở thành Người bán" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Comparison -->
                        <Grid Margin="8,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextMain}"
                                    Command="{Binding GoComparisonCommand}" ToolTip="So sánh" Cursor="Hand" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="ScaleBalance" Width="24" Height="24"/>
                            </Button>
                            <Border Background="#BA1A1A" CornerRadius="10" MinWidth="20" Height="20" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                    Visibility="{Binding ComparisonBadgeCount, Converter={StaticResource GreaterThanZeroToVis}}">
                                <TextBlock Text="{Binding ComparisonBadgeCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Notification -->
                        <Grid Margin="8,0" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextMain}"
                                    Command="{Binding GoNotificationCommand}" ToolTip="Thông báo" Cursor="Hand" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="BellOutline" Width="24" Height="24"/>
                            </Button>
                            <Border Background="#BA1A1A" CornerRadius="10" MinWidth="20" Height="20" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                    Visibility="{Binding UnreadNotificationCount, Converter={StaticResource GreaterThanZeroToVis}}">
                                <TextBlock Text="{Binding UnreadNotificationCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Wishlist -->
                        <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextMain}" Margin="8,0"
                                Command="{Binding GoWishlistCommand}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                                ToolTip="Yêu thích" Cursor="Hand" Width="48" Height="48">
                            <materialDesign:PackIcon Kind="HeartOutline" Width="24" Height="24"/>
                        </Button>

                        <!-- Cart -->
                        <Grid Margin="8,0,0,0" x:Name="CartIconArea">
                            <Button Style="{StaticResource MaterialDesignIconButton}" Foreground="{StaticResource TextMain}"
                                    Command="{Binding GoCartCommand}" ToolTip="Giỏ hàng" Cursor="Hand" Width="48" Height="48">
                                <materialDesign:PackIcon Kind="CartOutline" Width="24" Height="24"/>
                            </Button>
                            <!-- Badge -->
                            <Border Background="#BA1A1A" CornerRadius="10" MinWidth="20" Height="20" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                                <TextBlock Text="{Binding CartBadgeCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Navigation Menu -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="#E3E1EC" BorderThickness="0,0,0,1" Panel.ZIndex="9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0"
                        Content="Trang chủ" Command="{Binding GoHomeCommand}"
                        Foreground="{Binding CurrentPage, Converter={StaticResource PageToNavForeground}, ConverterParameter=Home}"
                        FontWeight="{Binding CurrentPage, Converter={StaticResource PageToNavFontWeight}, ConverterParameter=Home}"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0"
                        Content="Sản phẩm" Command="{Binding GoProductsCommand}"
                        Foreground="{Binding CurrentPage, Converter={StaticResource PageToNavForeground}, ConverterParameter=Products}"
                        FontWeight="{Binding CurrentPage, Converter={StaticResource PageToNavFontWeight}, ConverterParameter=Products}"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0"
                        Content="Khuyến mãi" Command="{Binding GoPromotionsCommand}"
                        Foreground="{Binding CurrentPage, Converter={StaticResource PageToNavForeground}, ConverterParameter=Promotions}"
                        FontWeight="{Binding CurrentPage, Converter={StaticResource PageToNavFontWeight}, ConverterParameter=Promotions}"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0"
                        Content="Hướng dẫn" Command="{Binding GoGuideCommand}"
                        Foreground="{Binding CurrentPage, Converter={StaticResource PageToNavForeground}, ConverterParameter=Guide}"
                        FontWeight="{Binding CurrentPage, Converter={StaticResource PageToNavFontWeight}, ConverterParameter=Guide}"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Height="40" Padding="24,0"
                        Content="Liên hệ" Command="{Binding GoContactCommand}"
                        Foreground="{Binding CurrentPage, Converter={StaticResource PageToNavForeground}, ConverterParameter=Contact}"
                        FontWeight="{Binding CurrentPage, Converter={StaticResource PageToNavFontWeight}, ConverterParameter=Contact}"/>
            </StackPanel>
        </Border>

        <!-- 3. Main Content -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}"/>

        <!-- 4. Animation Overlay -->
        <Canvas x:Name="AnimationOverlay" Grid.RowSpan="3" Panel.ZIndex="100" IsHitTestVisible="False"/>

        <!-- 5. Floating Chat Widget -->
        <buyerViews:BuyerChatWidget Grid.RowSpan="3" DataContext="{Binding ChatViewModel}" Panel.ZIndex="105"/>

        <!-- 6. Toast Notification Snackbar -->
        <materialDesign:Snackbar x:Name="MainSnackbar" Grid.RowSpan="3" Panel.ZIndex="110"/>
    </Grid>
</UserControl>
