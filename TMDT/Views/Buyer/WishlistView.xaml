<UserControl x:Class="TMDT.Views.Buyer.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding BackCommand}"
                    Foreground="{StaticResource TextBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,5,0"/>
                    <TextBlock Text="Quay lại"/>
                </StackPanel>
            </Button>
            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Yêu thích" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}"/>
            <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="14">
                <Run Text="("/>
                <Run Text="{Binding Items.Count, Mode=OneWay}"/>
                <Run Text=" sản phẩm)"/>
            </TextBlock>
        </StackPanel>

        <!-- Loading -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,16"/>

        <!-- Empty State -->
        <Border Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="HeartOffOutline" Width="80" Height="80"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="Chưa có sản phẩm yêu thích nào" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,16,0,8"/>
                <TextBlock Text="Lưu lại sản phẩm bạn thích để mua sắm dễ dàng hơn!"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding BackCommand}"
                        Foreground="{StaticResource BrandPrimaryBrush}"
                        Content="Khám phá sản phẩm"
                        Margin="0,20,0,0" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Product Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12"
                                Width="220" Margin="0,0,16,16"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Image -->
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#F1F5F9" Margin="5"
                                        MouseLeftButtonUp="CardBorder_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="ImageOutline" Width="50" Height="50"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Visibility="{Binding ImageUrl, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}"/>
                                        <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="2"/>

                                        <!-- Discount Badge -->
                                        <Border Background="#EF4444" CornerRadius="8" Padding="6,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="8,8,0,0"
                                                Visibility="{Binding DiscountPercent, Converter={StaticResource NullToVis}}">
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White">
                                                <Run Text="-"/><Run Text="{Binding DiscountPercent, Mode=OneWay}"/><Run Text="%"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Remove Button -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Width="28" Height="28"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="5" Padding="0"
                                                ToolTip="Xóa khỏi yêu thích"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="#FEF2F2" CornerRadius="14" Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="Heart" Width="14" Height="14"
                                                                         Foreground="#EF4444"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>

                                        <!-- Out of Stock Overlay -->
                                        <Border Background="#80000000" CornerRadius="12,12,0,0"
                                                Visibility="{Binding Product.StockQuantity, Converter={StaticResource NullToVis}, ConverterParameter=Inverse}">
                                            <TextBlock Text="HẾT HÀNG" FontSize="13" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="12,8,12,12">
                                    <!-- Shop Name -->
                                    <TextBlock Text="{Binding Product.Shop.ShopName}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                               Visibility="{Binding Product.Shop, Converter={StaticResource NullToVis}}"/>

                                    <!-- Product Name -->
                                    <TextBlock Text="{Binding Product.ProductName}"
                                               FontSize="13.5" FontWeight="Medium"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Margin="0,0,0,6"
                                               ToolTip="{Binding Product.ProductName}"/>

                                    <!-- Price -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N0}đ}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource PriceBrush}"/>
                                        <TextBlock Text="{Binding Product.OriginalPrice, StringFormat={}{0:N0}đ}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,1"/>
                                    </StackPanel>

                                    <!-- Rating + Sold -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="Star" Foreground="#FBBF24"
                                                                 Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Product.Rating, StringFormat={}{0:N1}}"
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Run Text="Đã bán "/><Run Text="{Binding Product.SoldCount, TargetNullValue=0, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Added Date -->
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10">
                                        <Run Text="Yêu thích "/>
                                        <Run Text="{Binding AddedAtText, Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Actions -->
                                    <Grid>
                                        <Button Content="THÊM VÀO GIỎ"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                FontSize="12" FontWeight="Bold"
                                                Foreground="{StaticResource BrandPrimaryBrush}"
                                                Padding="0" Height="34"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
