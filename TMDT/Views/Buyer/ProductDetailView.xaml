<UserControl x:Class="TMDT.Views.Buyer.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Back Button + Breadcrumb -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{Binding BackCommand}"
                        Foreground="{StaticResource TextBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,5,0"/>
                        <TextBlock Text="Quay lại"/>
                    </StackPanel>
                </Button>
                <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}"/>
            </StackPanel>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Image -->
                <Border Background="White" CornerRadius="16" Padding="20"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <!-- Placeholder Image -->
                        <Border Background="#F1F5F9" CornerRadius="12"
                                Height="450" VerticalAlignment="Top">
                            <Grid>
                                <materialDesign:PackIcon Kind="ImageOutline" Width="80" Height="80"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{StaticResource TextMutedBrush}"/>

                                <!-- Discount Badge -->
                                <Border Background="#FF3D00" CornerRadius="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="10" Padding="8,4"
                                        Visibility="{Binding DiscountPercent, Converter={StaticResource GreaterThanZeroToVis}}">
                                    <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}"
                                               Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thumbnail Row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,470,0,0">
                            <Border Background="{StaticResource BrandPrimaryBrush}"
                                    CornerRadius="8" Width="70" Height="70" Margin="3">
                                <materialDesign:PackIcon Kind="Image" Width="30" Height="30"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right: Product Info -->
                <StackPanel Grid.Column="2">

                    <!-- Name + Rating -->
                    <Border Background="White" CornerRadius="16" Padding="24"
                            Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ProductName}" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <!-- Rating Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Star" Foreground="#FFB800" Width="18" Height="18"/>
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:N1}}"
                                               FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text=" | " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SoldCount, StringFormat={}{0} đã bán}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" | " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource BrandPrimaryBrush}"
                                           FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,5,0,15"/>

                            <!-- Price -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0}đ}"
                                           FontSize="32" FontWeight="Bold"
                                           Foreground="{StaticResource PriceBrush}"/>
                                <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N0}đ}"
                                           FontSize="18" Foreground="{StaticResource TextMutedBrush}"
                                           TextDecorations="Strikethrough" VerticalAlignment="Bottom"
                                           Margin="12,0,0,4"/>
                            </StackPanel>

                            <!-- Stock Status -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#10B981"
                                                         VerticalAlignment="Center" Width="18" Height="18"
                                                         Visibility="{Binding IsInStock, Converter={StaticResource BoolToVis}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Foreground="#EF4444"
                                                         VerticalAlignment="Center" Width="18" Height="18"
                                                         Visibility="{Binding IsInStock, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                                <TextBlock Text="{Binding StockQuantity, StringFormat=Còn {0} trong kho}"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Shop Info -->
                    <Border Background="White" CornerRadius="16" Padding="24"
                            Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BrandPrimaryBrush}" CornerRadius="50"
                                    Width="50" Height="50">
                                <TextBlock Text="{Binding ShopName[0]}" Foreground="White"
                                           FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="15,0,0,0">
                                <TextBlock Text="Cửa hàng" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ShopName}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quantity Selector -->
                    <Border Background="White" CornerRadius="16" Padding="24"
                            Effect="{StaticResource CardShadow}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Số lượng" FontWeight="SemiBold" Margin="0,0,0,12"
                                       Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="-" Width="40" Height="40"
                                        Command="{Binding DecreaseCommand}"
                                        FontSize="18" Padding="0"/>
                                <TextBlock Text="{Binding Quantity}" Width="60" TextAlignment="Center"
                                           FontSize="18" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Padding="0,10"/>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="+" Width="40" Height="40"
                                        Command="{Binding IncreaseCommand}"
                                        FontSize="18" Padding="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Description -->
                    <Border Background="White" CornerRadius="16" Padding="24"
                            Effect="{StaticResource CardShadow}" Margin="0,0,0,16"
                            Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Mô tả sản phẩm" FontWeight="Bold" FontSize="16"
                                       Margin="0,0,0,12" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource BrandSecondaryBrush}"
                                Foreground="White"
                                Width="220" Height="52"
                                Command="{Binding AddToCartCommand}"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartPlus" Width="22" Height="22" Margin="0,0,8,0"/>
                                <TextBlock Text="Thêm vào giỏ hàng" FontSize="16"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Background="{StaticResource BrandPrimaryBrush}"
                                Foreground="White"
                                Width="220" Height="52"
                                Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShoppingOutline" Width="22" Height="22" Margin="0,0,8,0"/>
                                <TextBlock Text="Tiếp tục mua sắm" FontSize="16"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
