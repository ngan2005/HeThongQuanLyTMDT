<UserControl x:Class="TMDT.Views.Buyer.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TMDT.Views.Components"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse"/>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid MaxWidth="1280" Margin="40" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Breadcrumb -->
                    <RowDefinition Height="Auto"/> <!-- Hero -->
                    <RowDefinition Height="Auto"/> <!-- Tabs & Content -->
                </Grid.RowDefinitions>

                <!-- Breadcrumb -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,30">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding BackCommand}" Padding="0" Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock Text="Trang chủ"/>
                    </Button>
                    <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="5,0"/>
                    <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <materialDesign:PackIcon Kind="ChevronRight" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="5,0"/>
                    <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource BrandPrimaryBrush}"/>
                </StackPanel>

                <!-- Product Hero Section -->
                <Grid Grid.Row="1" Margin="0,0,0,60">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="450"/> <!-- Left: Image -->
                        <ColumnDefinition Width="50"/> <!-- Gap -->
                        <ColumnDefinition Width="*"/> <!-- Right: Info -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Image Gallery -->
                    <StackPanel Grid.Column="0">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,15" Height="450">
                            <!-- Show real image if we had ImageUrl, otherwise placeholder -->
                            <Grid>
                                <materialDesign:PackIcon Kind="ImageOutline" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding MainImageUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                
                                <Image x:Name="MainProductImage" Source="{Binding MainImageUrl}" Stretch="Uniform" Margin="2" Cursor="Hand" MouseLeftButtonUp="MainProductImage_MouseLeftButtonUp"/>
                                <Border Background="#FF3D00" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15" Padding="10,5" Visibility="{Binding DiscountPercent, Converter={StaticResource GreaterThanZeroToVis}}">
                                    <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <!-- Thumbnails -->
                        <ItemsControl ItemsSource="{Binding Thumbnails}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,10"
                                            Cursor="Hand">
                                        <Border Width="80" Height="80" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White">
                                            <Image Source="{Binding}" Stretch="Uniform" Margin="2"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Right: Product Info -->
                    <StackPanel Grid.Column="2">
                        <!-- Bán chạy nhất badge (optional, hidden or static) -->
                        <Border Background="{StaticResource BrandAccentBrush}" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,10">
                            <TextBlock Text="BÁN CHẠY NHẤT" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>

                        <TextBlock Text="{Binding ProductName}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="Star" Foreground="{StaticResource RatingBrush}" Width="20" Height="20"/>
                                <materialDesign:PackIcon Kind="Star" Foreground="{StaticResource RatingBrush}" Width="20" Height="20"/>
                                <materialDesign:PackIcon Kind="Star" Foreground="{StaticResource RatingBrush}" Width="20" Height="20"/>
                                <materialDesign:PackIcon Kind="Star" Foreground="{StaticResource RatingBrush}" Width="20" Height="20"/>
                                <materialDesign:PackIcon Kind="StarHalf" Foreground="{StaticResource RatingBrush}" Width="20" Height="20"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SoldCount, StringFormat=({0} đánh giá)}" Foreground="{StaticResource TextMutedBrush}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0}đ}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"/>
                            <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N0}đ}" FontSize="18" Foreground="{StaticResource TextMutedBrush}" TextDecorations="Strikethrough" VerticalAlignment="Bottom" Margin="12,0,0,6"/>
                        </StackPanel>

                        <!-- Stock Info instead of Colors -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="TÌNH TRẠNG KHO" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#10B981" Width="24" Height="24" Visibility="{Binding IsInStock, Converter={StaticResource BoolToVis}}"/>
                                <materialDesign:PackIcon Kind="CloseCircle" Foreground="#EF4444" Width="24" Height="24" Visibility="{Binding IsInStock, Converter={StaticResource BoolToVisInverse}}"/>
                                <TextBlock Text="{Binding StockQuantity, StringFormat=Còn {0} sản phẩm}" FontSize="16" Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Shop Info -->
                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="CỬA HÀNG" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <Grid Cursor="Hand">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding ViewShopCommand}"/>
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="20" Width="40" Height="40">
                                    <TextBlock Text="{Binding ShopName[0]}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding ShopName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                
                                <!-- Xem Shop Button -->
                                <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}" 
                                        Content="XEM SHOP" Height="32" 
                                        BorderBrush="{StaticResource BrandPrimaryBrush}" 
                                        Foreground="{StaticResource BrandPrimaryBrush}" 
                                        Command="{Binding ViewShopCommand}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Quantity -->
                        <StackPanel Margin="0,0,0,40">
                            <TextBlock Text="SỐ LƯỢNG" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="White" Width="140" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="-" Width="40" Command="{Binding DecreaseCommand}" FontSize="20" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Quantity}" Width="58" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="+" Width="40" Command="{Binding IncreaseCommand}" FontSize="20" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Yeu thich & Share & Barcode -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding ToggleWishlistCommand}" Height="40" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="Heart" Width="20" Height="20" Foreground="{StaticResource BrandPrimaryBrush}"
                                                                 Visibility="{Binding IsWishlisted, Converter={StaticResource BoolToVis}}"/>
                                        <materialDesign:PackIcon Kind="HeartOutline" Width="20" Height="20" Foreground="{StaticResource BrandPrimaryBrush}"
                                                                 Visibility="{Binding IsWishlisted, Converter={StaticResource BoolToVisInverse}}"/>
                                    </Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="YÊU THÍCH"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWishlisted}" Value="True">
                                                        <Setter Property="Text" Value="ĐÃ YÊU THÍCH"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding ShareCommand}" Height="40" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShareVariant" Width="20" Height="20" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="CHIA SẺ" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding ShowBarcodeCommand}" Height="40" Background="Transparent" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Barcode" Width="20" Height="20" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="MÃ VẠCH" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Actions -->
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddToCart" Grid.Column="0" Style="{StaticResource ModernButtonStyle}" Command="{Binding AddToCartCommand}" Height="50" Background="{StaticResource BrandPrimaryBrush}" Foreground="White" FontSize="15" FontWeight="Bold" Content="THÊM VÀO GIỎ HÀNG"/>
                            <Button Grid.Column="2" Style="{StaticResource ModernButtonStyle}" Command="{Binding BackCommand}" Height="50" Background="White" BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="2" Foreground="{StaticResource BrandPrimaryBrush}" FontSize="15" FontWeight="Bold" Content="TIẾP TỤC MUA SẮM"/>
                        </Grid>

                        <!-- Trust Badges -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TruckFastOutline" Foreground="{StaticResource BrandPrimaryBrush}" Width="24" Height="24"/>
                                    <TextBlock Text="Giao hàng miễn phí" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Foreground="{StaticResource BrandPrimaryBrush}" Width="24" Height="24"/>
                                    <TextBlock Text="Bảo hành chính hãng" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tabs & Content -->
                <StackPanel Grid.Row="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal">
                            <Border BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,40,0">
                                <TextBlock Text="MÔ TẢ SẢN PHẨM" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Description Content -->
                    <Border Background="White" CornerRadius="12" Padding="30" Effect="{StaticResource CardShadow}" Margin="0,0,0,40">
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="16" LineHeight="26" Foreground="{StaticResource TextBrush}"/>
                    </Border>

                    <!-- Reviews Section -->
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,30">
                        <StackPanel Orientation="Horizontal">
                            <Border BorderBrush="{StaticResource BrandPrimaryBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,10" Margin="0,0,40,0">
                                <TextBlock Text="ĐÁNH GIÁ TỪ KHÁCH HÀNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- No Reviews Message -->
                    <TextBlock Text="Chưa có đánh giá nào cho sản phẩm này." 
                               Foreground="{StaticResource TextMutedBrush}" FontSize="15" FontStyle="Italic" 
                               Margin="0,0,0,40" HorizontalAlignment="Center"
                               Visibility="{Binding Reviews.Count, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}"/>

                    <!-- Reviews List -->
                    <ItemsControl ItemsSource="{Binding Reviews}" Margin="0,0,0,40">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,15" Effect="{StaticResource CardShadow}">
                                    <StackPanel>
                                        <!-- Header: Avatar, Name, Stars, Date -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Avatar -->
                                            <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" ClipToBounds="True">
                                                <Image Source="{Binding BuyerAvatar}" Stretch="UniformToFill"/>
                                            </Border>
                                            
                                            <!-- Name and Stars -->
                                            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BuyerName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding StarRating}" FontSize="12" FontWeight="Bold" Foreground="#D97706" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                            <materialDesign:PackIcon Kind="Star" Foreground="#D97706" Width="12" Height="12" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Date -->
                                            <TextBlock Grid.Column="2" Text="{Binding ReviewDate}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Top"/>
                                        </Grid>
                                        
                                        <!-- Review Content -->
                                        <TextBlock Text="{Binding Content}" FontSize="15" Foreground="{StaticResource TextBrush}" Margin="0,15,0,0" TextWrapping="Wrap" LineHeight="24"/>
                                        
                                        <!-- Seller Reply (If exists) -->
                                        <Border Background="#F9FAFB" CornerRadius="8" Padding="15" Margin="0,15,0,0" BorderBrush="#E5E7EB" BorderThickness="1"
                                                Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <materialDesign:PackIcon Kind="StorefrontOutline" Foreground="{StaticResource BrandPrimaryBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Phản hồi của Cửa hàng" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandPrimaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ReplyDate}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReplyContent}" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="22"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <components:BuyerFooterView />
        </StackPanel>
    </ScrollViewer>

    <!-- LIGHTBOX OVERLAY: IMAGE ZOOM -->
    <Grid x:Name="LightboxOverlay" Visibility="Collapsed" Panel.ZIndex="100">
        <!-- Semi-transparent overlay background -->
        <Border Background="#B2000000" MouseDown="LightboxOverlay_MouseDown" Cursor="Hand"/>
        
        <!-- Image Container with nice drop shadow and rounded corners -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                Background="White" CornerRadius="16" Padding="15" Margin="60"
                MaxWidth="800" MaxHeight="800">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Direction="270" Color="Black"/>
            </Border.Effect>
            <Border CornerRadius="8" ClipToBounds="True">
                <Image Source="{Binding MainImageUrl}" Stretch="Uniform"/>
            </Border>
        </Border>
        
        <!-- Close Button -->
        <Button Click="CloseLightbox_Click" Background="Transparent" BorderThickness="0" Width="50" Height="50" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="#80000000" CornerRadius="25">
                        <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#CC000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
    </Grid>
</UserControl>
