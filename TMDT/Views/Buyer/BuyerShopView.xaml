<UserControl x:Class="TMDT.Views.Buyer.BuyerShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TMDT.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="#F1F5F9"
             FontFamily="Be Vietnam Pro, Segoe UI, sans-serif">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">
            <!-- SHOP HEADER -->
            <Border Background="White" CornerRadius="0,0,16,16" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/> <!-- Cover -->
                        <RowDefinition Height="Auto"/> <!-- Info -->
                    </Grid.RowDefinitions>

                    <!-- Cover Background -->
                    <Border Grid.Row="0" CornerRadius="0,0,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#818CF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <!-- Pattern overlay -->
                        <materialDesign:PackIcon Kind="Storefront" Width="200" Height="200" 
                                                 Foreground="White" Opacity="0.1" 
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-30,0"/>
                    </Border>

                    <!-- Info Section -->
                    <Grid Grid.Row="1" Margin="40,-40,40,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="50" 
                                Background="White" BorderBrush="White" BorderThickness="4"
                                VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <Border CornerRadius="46" Background="{StaticResource BrandPrimaryBrush}" ClipToBounds="True">
                                <TextBlock Text="{Binding ShopLogoChar}" Foreground="White" 
                                           FontSize="40" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>

                        <!-- Name & Stats -->
                        <StackPanel Grid.Column="1" Margin="24,48,0,0" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ShopName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            
                            <WrapPanel Margin="0,12,0,0">
                                <!-- Rating -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                    <materialDesign:PackIcon Kind="Star" Foreground="#F59E0B" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" FontWeight="SemiBold" FontSize="14" Foreground="#F59E0B" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="/ 5.0" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Total Products -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                    <materialDesign:PackIcon Kind="PackageVariant" Foreground="{StaticResource TextMutedBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalProducts}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="sản phẩm" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Joined -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                    <materialDesign:PackIcon Kind="CalendarMonth" Foreground="{StaticResource TextMutedBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tham gia:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OpenedAt, StringFormat=dd/MM/yyyy}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Address -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="MapMarker" Foreground="{StaticResource TextMutedBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding WarehouseAddress}" MaxWidth="250" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,48,0,0" VerticalAlignment="Top">
                            <!-- Theo Dõi -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Command="{Binding ToggleFollowCommand}"
                                    BorderBrush="{StaticResource BrandPrimaryBrush}" Foreground="{StaticResource BrandPrimaryBrush}"
                                    Height="36" Padding="16,0" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Margin="0,0,4,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Visibility="{Binding IsFollowed, Converter={StaticResource BoolToVis}}"/>
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Visibility="{Binding IsFollowed, Converter={StaticResource InverseBoolToVis}}"/>
                                    </Grid>
                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Theo dõi"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFollowed}" Value="True">
                                                        <Setter Property="Text" Value="Đang theo dõi"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <!-- Chat -->
                            <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                                    Command="{Binding ChatCommand}"
                                    Background="{StaticResource BrandPrimaryBrush}" BorderBrush="{StaticResource BrandPrimaryBrush}" Foreground="White"
                                    Height="36" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Chat" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Chat ngay" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- SHOP PRODUCTS -->
            <Border Background="White" CornerRadius="16" Padding="24" Margin="32,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Width="4" Height="24" Background="{StaticResource BrandPrimaryBrush}" CornerRadius="2" Margin="0,0,12,0"/>
                        <TextBlock Text="Tất cả sản phẩm" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <!-- Products Grid -->
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Using ProductCard Component -->
                                <components:ProductCard Margin="0,0,16,24"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel Visibility="{Binding Products.Count, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0, FallbackValue=Collapsed}"
                                HorizontalAlignment="Center" Margin="0,40,0,40">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="64" Height="64" 
                                                 Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cửa hàng chưa có sản phẩm nào" FontSize="15" 
                                   Foreground="#94A3B8" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
