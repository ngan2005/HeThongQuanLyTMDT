<UserControl x:Class="TMDT.Views.Buyer.BuyerOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding BackCommand}"
                    Foreground="{StaticResource TextBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,5,0"/>
                    <TextBlock Text="Quay lại"/>
                </StackPanel>
            </Button>
            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Đơn hàng của tôi" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}"/>
        </StackPanel>

        <!-- Filter Tabs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <RadioButton Style="{StaticResource NavItemStyle}" Content="Tất cả"
                         Command="{Binding SetFilterCommand}" CommandParameter="Tất cả"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Tất cả, Mode=OneWay}"
                         Margin="0,0,8,0"/>
            <RadioButton Style="{StaticResource NavItemStyle}" Content="Chờ duyệt"
                         Command="{Binding SetFilterCommand}" CommandParameter="Pending"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Pending, Mode=OneWay}"
                         Margin="0,0,8,0"/>
            <RadioButton Style="{StaticResource NavItemStyle}" Content="Đang giao"
                         Command="{Binding SetFilterCommand}" CommandParameter="Shipping"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Shipping, Mode=OneWay}"
                         Margin="0,0,8,0"/>
            <RadioButton Style="{StaticResource NavItemStyle}" Content="Hoàn thành"
                         Command="{Binding SetFilterCommand}" CommandParameter="Completed"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Completed, Mode=OneWay}"
                         Margin="0,0,8,0"/>
            <RadioButton Style="{StaticResource NavItemStyle}" Content="Đã hủy"
                         Command="{Binding SetFilterCommand}" CommandParameter="Cancelled"
                         IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Cancelled, Mode=OneWay}"/>
        </StackPanel>

        <!-- Orders List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Loading -->
                <ProgressBar IsIndeterminate="True" Height="4"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,0,16"/>

                <!-- No Orders -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,60,0,0"
                            Visibility="{Binding Orders.Count, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=0}">
                    <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="80" Height="80"
                                             Foreground="{StaticResource TextMutedBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Chưa có đơn hàng nào" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               Margin="0,16,0,8"/>
                    <TextBlock Text="Bắt đầu mua sắm để tạo đơn hàng!"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Order Cards -->
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="16" Margin="0,0,0,16"
                                    Padding="20" Effect="{StaticResource CardShadow}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Order Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding OrderCode}" FontWeight="Bold" FontSize="15"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <Border Margin="12,0,0,0" CornerRadius="20" Padding="10,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Pending">
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                <Setter Property="TextElement.Foreground" Value="#D97706"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Shipping">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                                <Setter Property="TextElement.Foreground" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Completed">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                                <Setter Property="TextElement.Foreground" Value="#059669"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OrderStatus}" Value="Cancelled">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                                <Setter Property="TextElement.Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OrderStatus}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Order Details (Products) -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding OrderDetails}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="#F1F5F9" CornerRadius="6"
                                                            Width="44" Height="44" VerticalAlignment="Top">
                                                        <materialDesign:PackIcon Kind="Package" Width="22" Height="22"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Foreground="{StaticResource TextMutedBrush}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                        <TextBlock Text="{Binding ProductNameSnapshot}" FontSize="14"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat={}x{0}}"
                                                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TotalPrice, StringFormat={}{0:N0}đ}"
                                                               FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Top"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Order Footer -->
                                    <Border Grid.Row="2" BorderThickness="0,1,0,0"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            Padding="0,12,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Thành tiền: " FontSize="14"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}đ}"
                                                           FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource PriceBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Content="Hủy đơn"
                                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#EF4444" BorderBrush="#EF4444"
                                                        FontSize="12" Height="32" Margin="0,0,8,0"
                                                        Visibility="{Binding OrderStatus, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Pending}"/>
                                                
                                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                        Content="Đã Nhận Hàng"
                                                        Command="{Binding DataContext.ReceiveOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="#059669" Foreground="White"
                                                        FontSize="12" FontWeight="Bold" Height="32"
                                                        Visibility="{Binding OrderStatus, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Shipping}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
