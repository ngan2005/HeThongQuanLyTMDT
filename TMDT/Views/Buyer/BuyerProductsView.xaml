<UserControl x:Class="TMDT.Views.Buyer.BuyerProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TMDT.Views.Components"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVis"/>
        <converters:InverseStringToVisibilityConverter x:Key="StringToVisInverse"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar for Filters -->
            <ColumnDefinition Width="280"/>
            <!-- Main Content for Products -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR: FILTERS -->
        <Border Grid.Column="0" Background="White" Margin="20,20,10,20" Padding="20" CornerRadius="8" Effect="{StaticResource CardShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="BỘ LỌC TÌM KIẾM" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="{StaticResource BrandPrimaryBrush}"/>

                    <!-- Category Filter -->
                    <TextBlock Text="Theo Danh mục" FontWeight="SemiBold" Margin="0,10,0,5" Foreground="{StaticResource TextBrush}"/>
                    <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding SelectedCategory}" 
                              DisplayMemberPath="CategoryName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Padding="10"/>

                    <Separator Margin="0,20" Background="#EEEEEE"/>

                    <!-- Price Filter -->
                    <TextBlock Text="Khoảng Giá (VNĐ)" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource TextBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="TỪ"/>
                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                 Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="ĐẾN"/>
                    </Grid>

                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                            Background="{StaticResource BrandPrimaryBrush}" Foreground="White"
                            Content="ÁP DỤNG" 
                            Command="{Binding FilterCommand}"
                            Margin="0,15,0,0" Height="40"/>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Foreground="{StaticResource TextMutedBrush}" BorderBrush="{StaticResource TextMutedBrush}"
                            Content="XÓA TẤT CẢ" 
                            Command="{Binding ClearFilterCommand}"
                            Margin="0,10,0,0" Height="40"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- RIGHT AREA: PRODUCTS -->
        <Border Grid.Column="1" Margin="10,20,20,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Info Header -->
                <Border Grid.Row="0" Background="White" Padding="20,15" CornerRadius="8" Effect="{StaticResource CardShadow}" Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Search" Width="24" Height="24" Foreground="{StaticResource BrandSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Kết quả tìm kiếm cho: " FontSize="16" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding SearchQuery}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Text="Tất cả sản phẩm" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryBrush}"
                                   Visibility="{Binding SearchQuery, Converter={StaticResource StringToVisInverse}}"/>
                        <TextBlock Text="{Binding Products.Count, StringFormat=' ({0} kết quả)'}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Product Grid -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Products}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <components:ProductCard
                                    ClickCommand="{Binding DataContext.OpenProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    ClickCommandParameter="{Binding}"
                                    WishlistCommand="{Binding DataContext.ToggleWishlistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    WishlistCommandParameter="{Binding}"
                                    IsWishlisted="{Binding IsWishlisted, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
