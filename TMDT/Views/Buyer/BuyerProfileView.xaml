<UserControl x:Class="TMDT.Views.Buyer.BuyerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:TMDT.Converters"
             xmlns:helpers="clr-namespace:TMDT.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding BackCommand}"
                    Foreground="{StaticResource TextBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,5,0"/>
                    <TextBlock Text="Quay lại"/>
                </StackPanel>
            </Button>
            <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Tài khoản của tôi" VerticalAlignment="Center"
                       FontWeight="Bold" FontSize="20" Foreground="{StaticResource BrandPrimaryBrush}"/>
        </StackPanel>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Margin="0,0,0,20" Padding="20 16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalOrders}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrandPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tổng đơn hàng" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="16,8"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PendingOrders}" FontSize="26" FontWeight="Bold"
                               Foreground="#F59E0B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Đang xử lý" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="3" Width="1" Background="{StaticResource BorderBrush}" Margin="16,8"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CompletedOrders}" FontSize="26" FontWeight="Bold"
                               Foreground="#059669" HorizontalAlignment="Center"/>
                    <TextBlock Text="Đã hoàn thành" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Avatar & Info -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="20" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Avatar -->
                    <Grid Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Ellipse Fill="{StaticResource CardBackgroundBrush}"/>
                        <Grid>
                            <Grid.Clip>
                                <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                            </Grid.Clip>
                            <Image Source="{Binding Avatar, Converter={StaticResource Base64ToImageConverter}}"
                                   Stretch="UniformToFill"
                                   Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}, ConverterParameter=Inverse}"/>
                        </Grid>
                        <TextBlock Text="{Binding FullName[0]}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource BrandPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}}"/>
                        <Button Command="{Binding ChangeAvatarCommand}"
                                Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Cursor="Hand" ToolTip="Đổi ảnh đại diện">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{StaticResource BrandPrimaryBrush}"
                                            CornerRadius="12" BorderThickness="2" BorderBrush="White">
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BrandAccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Background="#A0000000" CornerRadius="40" Visibility="{Binding IsUploadingAvatar, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="30" Height="4"
                                         Foreground="White" Background="Transparent" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Phone" Grid.Column="0" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Calendar" Grid.Column="0" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="Tham gia: "/><Run Text="{Binding JoinedDateText, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="WalletOutline" Grid.Column="0" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Ví: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding WalletBalanceText}" FontSize="12" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="StarCircleOutline" Grid.Column="0" Width="16" Height="16"
                                                 Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Điểm: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LoyaltyPoints}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: Edit Forms -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Form 1: Edit Profile -->
                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Chỉnh sửa thông tin" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="38" Padding="10,0">
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 FontSize="13" Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="{StaticResource TextBrush}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="38" Padding="10,0">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 FontSize="13" Foreground="{StaticResource TextBrush}"
                                                 CaretBrush="{StaticResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Email (không thể thay đổi)" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Height="38" Padding="10,0" Opacity="0.7">
                                    <TextBox Text="{Binding Email}" IsReadOnly="True"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Command="{Binding SaveProfileCommand}"
                                    HorizontalAlignment="Right" Width="150" Height="36"
                                    Background="{StaticResource BrandPrimaryBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lưu thay đổi" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Form 2: Addresses -->
                    <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Sổ địa chỉ" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Button Command="{Binding ToggleAddAddressCommand}"
                                        HorizontalAlignment="Right" Height="30"
                                        Background="{StaticResource BrandPrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="Thêm địa chỉ" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Add Address Form -->
                            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10"
                                    Padding="14" Margin="0,0,0,12"
                                    Visibility="{Binding IsAddingAddress, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Nhấn nút bên dưới để thêm địa chỉ mới"
                                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                    <Button Content="Chọn địa chỉ" Height="34"
                                            Background="#059669" Foreground="White" BorderThickness="0"
                                            Padding="0" Cursor="Hand"
                                            Command="{Binding OpenAddressPickerCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="Chọn địa chỉ giao hàng" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#047857"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Hủy" Command="{Binding ToggleAddAddressCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Address List -->
                            <ItemsControl ItemsSource="{Binding Addresses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                                Padding="12" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding RecipientName}" FontWeight="Bold"
                                                                   FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text=" | " Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding Phone}" FontSize="12"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                        <Border Background="#059669" CornerRadius="6" Padding="5,1"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Mặc định" FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FullAddress}" FontSize="12"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,0" Height="26"
                                                            Command="{Binding DataContext.SetDefaultAddressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="{StaticResource BrandPrimaryBrush}"
                                                            ToolTip="Đặt mặc định">
                                                        <materialDesign:PackIcon Kind="StarOutline" Width="14" Height="14"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,0" Height="26"
                                                            Command="{Binding DataContext.DeleteAddressCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Foreground="#EF4444"
                                                            ToolTip="Xóa địa chỉ">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Chưa có địa chỉ nào."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13" Margin="0,6,0,0"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Form 3: Change Password -->
                    <Border Background="White" CornerRadius="16" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Đổi mật khẩu" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu hiện tại" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="38" Padding="10,0">
                                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     FontSize="13" Foreground="{StaticResource TextBrush}"
                                                     CaretBrush="{StaticResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Mật khẩu mới" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="38" Padding="10,0">
                                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     FontSize="13" Foreground="{StaticResource TextBrush}"
                                                     CaretBrush="{StaticResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Xác nhận mật khẩu" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Height="38" Padding="10,0">
                                        <PasswordBox helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     FontSize="13" Foreground="{StaticResource TextBrush}"
                                                     CaretBrush="{StaticResource TextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding ChangePasswordCommand}"
                                    HorizontalAlignment="Right" Width="150" Height="36" Margin="0,14,0,0"
                                    Background="{StaticResource BrandPrimaryBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LockReset" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Đổi mật khẩu" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
