<UserControl x:Class="TMDT.Views.Admin.AdminShopsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#121C2A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#593AD8"/>
        
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command button styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Table + Detail Inspector -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE & SEARCH ROW -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Phê duyệt &amp; Quản lý Shop" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <TextBlock Text="Quản lý đối tác người bán, phê duyệt đăng ký mở cửa hàng mới toàn sàn" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#DFE9FD" Height="38" Padding="12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" 
                             VerticalAlignment="Center" FontSize="12.5" Padding="6,0,0,0" Margin="0" 
                             Tag="Tìm tên Shop, Email..." FontFamily="Be Vietnam Pro, Segoe UI"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. FILTER STATUS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Tất cả Shop" Style="{StaticResource FilterButton}" IsChecked="True" Command="{Binding FilterCommand}" CommandParameter="All" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Chờ duyệt" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Pending" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Đang hoạt động" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Active" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Đang khóa" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Suspended" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN CONTENT: TABLE + INSPECTOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Shop DataGrid -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <!-- Detail Inspector Card -->
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid List -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#2D3282" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>
                
                <DataGrid ItemsSource="{Binding Shops}" SelectedItem="{Binding SelectedShop}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column" RowHeight="44" FontFamily="Be Vietnam Pro, Segoe UI">
                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Shop ID -->
                        <DataGridTextColumn Header="MÃ ID" Binding="{Binding ShopId}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Shop Name -->
                        <DataGridTemplateColumn Header="TÊN CỬA HÀNG" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Mock Round Logo avatar -->
                                        <Border Width="28" Height="28" Background="#EFF3FF" CornerRadius="14" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding ShopName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Owner Name -->
                        <DataGridTextColumn Header="CHỦ SỞ HỮU" Binding="{Binding User.FullName}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Commission Rate -->
                        <DataGridTextColumn Header="CHIẾT KHẤU" Binding="{Binding CommissionRate, StringFormat={}{0:N1}%}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Balance -->
                        <DataGridTextColumn Header="DOANH THU VÍ" Binding="{Binding WalletBalance, StringFormat={}{0:N0} đ}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#E6FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="Chờ duyệt"/>
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Đang bán"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Đang khóa"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Shop Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#2D3282" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <Grid>
                    <!-- Displayed only when a Shop is selected -->
                    <Grid Visibility="{Binding SelectedShop, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Shop logo avatar large -->
                            <RowDefinition Height="*"/>    <!-- Detail fields -->
                            <RowDefinition Height="Auto"/> <!-- Actions footer -->
                        </Grid.RowDefinitions>

                        <!-- Avatar and Shop Title -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,24">
                            <Border Width="60" Height="60" Background="#EFF3FF" CornerRadius="30" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedShop.ShopName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,4" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            
                            <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="{x:Null}">
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="True">
                                                <Setter Property="Background" Value="#E6FDF4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="False">
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="YÊU CẦU MỞ SHOP MỚI"/>
                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="True">
                                                    <Setter Property="Text" Value="SHOP ĐANG HOẠT ĐỘNG"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="False">
                                                    <Setter Property="Text" Value="ĐÃ KHÓA TẠM THỜI"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Detail Fields ScrollView -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Owner Field -->
                                <TextBlock Text="CHỦ CỬA HÀNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedShop.User.FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,2" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedShop.User.Email}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Warehouse address -->
                                <TextBlock Text="ĐỊA CHỈ KHO HÀNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedShop.WarehouseAddress}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Financial balance -->
                                <TextBlock Text="DOANH THU TÍCH LŨY TRÊN VÍ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedShop.WalletBalance, StringFormat={}{0:N0} đ}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Opened date -->
                                <TextBlock Text="NGÀY THÀNH LẬP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedShop.OpenedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Rating -->
                                <TextBlock Text="ĐÁNH GIÁ CỦA KHÁCH" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedShop.Rating, StringFormat={}{0:N1} / 5.0}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="4,0,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons Footer -->
                        <StackPanel Grid.Row="2">
                            <!-- Approve button (Only when pending) -->
                            <Button Content="Phê duyệt cho hoạt động" 
                                    Background="{StaticResource BrandPurple}" Foreground="#FFFFFF"
                                    Command="{Binding ApproveShopCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Suspend button (Only when active) -->
                            <Button Content="Tạm khóa cửa hàng" 
                                    Background="#EF4444" Foreground="#FFFFFF"
                                    Command="{Binding SuspendShopCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Activate button (Only when suspended) -->
                            <Button Content="Mở khóa hoạt động" 
                                    Background="#10B981" Foreground="#FFFFFF"
                                    Command="{Binding ActivateShopCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedShop.IsActive}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Unselected state placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedShop}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#DFE9FD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một Shop từ danh sách để kiểm duyệt" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextAlignment="Center" Width="160" TextWrapping="Wrap" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
