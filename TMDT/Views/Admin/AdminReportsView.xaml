<UserControl x:Class="TMDT.Views.Admin.AdminReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#414750"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#004277"/>
        
        <Style x:Key="MetricCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>

        <Style x:Key="ReportActionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DFE9FD"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & period -->
            <RowDefinition Height="Auto"/>
            <!-- KPI Metrics overview cards -->
            <RowDefinition Height="Auto"/>
            <!-- Reports Action Panel list -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE ROW -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Báo cáo &amp; Thống kê Doanh thu" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
            <TextBlock Text="Kết xuất toàn bộ cơ sở dữ liệu bán hàng hệ thống ra file CSV/Excel phục vụ kế toán &amp; tài chính" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
        </StackPanel>

        <!-- 2. KPI METRICS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: System revenue -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH SỐ SÀN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalSystemRevenue, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="0,6,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Commission Fee sàn 5% -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}">
                <StackPanel>
                    <TextBlock Text="HOA HỒNG THU VỀ (5%)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalCommissionEarned, StringFormat={}{0:N0} đ}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,6,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Orders completed -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardBorder}">
                <StackPanel>
                    <TextBlock Text="ĐƠN HÀNG HOÀN TẤT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalOrdersProcessed}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Active Shops -->
            <Border Grid.Column="6" Style="{StaticResource MetricCardBorder}">
                <StackPanel>
                    <TextBlock Text="CỬA HÀNG ĐANG BÁN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding TotalActiveShopsCount}" FontSize="18" FontWeight="Bold" Foreground="#EA580C" Margin="0,6,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTIONS PANEL -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Action Row 1: Sales Transaction Report -->
                <Border Style="{StaticResource ReportActionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" Background="#E6FDF4" CornerRadius="8" Padding="10">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Báo cáo Doanh thu &amp; Giao dịch toàn diện" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="Xuất toàn bộ lịch sử đơn hàng hoàn tất bao gồm doanh thu bán lẻ, phí chiết khấu 5% trích sàn, người mua và trạng thái đơn." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>

                        <!-- Action -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Xuất Báo Cáo CSV" Width="140" Background="#10B981" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportTransactionsReportCommand}" Margin="0,0,8,0"/>
                            <Button Content="Xuất Báo Cáo PDF" Width="140" Background="#059669" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportTransactionsPdfCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Row 2: Shops list balance Report -->
                <Border Style="{StaticResource ReportActionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" Background="#EEF2FF" CornerRadius="8" Padding="10">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Báo cáo Dữ liệu &amp; Số dư ví các Cửa hàng" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="Kết xuất danh sách các Shop, số điện thoại liên kết, địa chỉ hoạt động, trạng thái kiểm duyệt và số tiền tích lũy ví hiện có." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>

                        <!-- Action -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Xuất Báo Cáo CSV" Width="140" Background="{StaticResource BrandPurple}" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportShopsReportCommand}" Margin="0,0,8,0"/>
                            <Button Content="Xuất Báo Cáo PDF" Width="140" Background="#4338CA" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportShopsPdfCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Action Row 3: Withdraw financial Report -->
                <Border Style="{StaticResource ReportActionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" Background="#FFF7ED" CornerRadius="8" Padding="10">
                            <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Báo cáo Lịch sử Rút tiền ngân hàng" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="Lịch sử các lệnh đề nghị chi lương ngân hàng của các Shop, bao gồm tên ngân hàng, số tài khoản, số tiền và trạng thái chuyển khoản." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>

                        <!-- Action -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Xuất Báo Cáo CSV" Width="140" Background="#EA580C" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportWithdrawsReportCommand}" Margin="0,0,8,0"/>
                            <Button Content="Xuất Báo Cáo PDF" Width="140" Background="#C2410C" Foreground="#FFFFFF" Style="{StaticResource ExportButton}" Command="{Binding ExportWithdrawsPdfCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

