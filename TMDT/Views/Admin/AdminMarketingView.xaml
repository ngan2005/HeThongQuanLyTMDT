<UserControl x:Class="TMDT.Views.Admin.AdminMarketingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#121C2A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#593AD8"/>
        
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Info -->
            <RowDefinition Height="Auto"/>
            <!-- Marketing Category Tab switching -->
            <RowDefinition Height="Auto"/>
            <!-- Main active tab content workspace -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE ROW -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Kênh Marketing &amp; Khuyến mãi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
            <TextBlock Text="Thiết lập banner quảng cáo, mã giảm giá do sàn tài trợ và các chiến dịch Flash Sale đếm ngược" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
        </StackPanel>

        <!-- 2. MARKETING TABS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Banners quảng cáo" Style="{StaticResource TabRadioButton}" IsChecked="True" Command="{Binding SelectTabCommand}" CommandParameter="Banners" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Vouchers toàn sàn" Style="{StaticResource TabRadioButton}" Command="{Binding SelectTabCommand}" CommandParameter="Vouchers" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Cấu hình Flash Sale" Style="{StaticResource TabRadioButton}" Command="{Binding SelectTabCommand}" CommandParameter="FlashSales" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3. WORKSPACE FOR ACTIVE TAB -->
        <Grid Grid.Row="2">
            
            <!-- ============================================== -->
            <!-- SUB-TAB A: BANNERS QUẢNG CÁO -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Banners">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Banner list table -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                    <DataGrid ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỨ TỰ" Binding="{Binding SortOrder}" Width="70"/>
                            <DataGridTextColumn Header="TIÊU ĐỀ BANNER" Binding="{Binding Title}" Width="1.5*"/>
                            <DataGridTextColumn Header="ĐƯỜNG DẪN LIÊN KẾT" Binding="{Binding LinkUrl}" Width="1*"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#E6FDF4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Hoạt động"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Tạm ẩn"/>
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Add banner form & Details -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                    <StackPanel>
                        <TextBlock Text="THIẾT LẬP BANNER MỚI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,16"/>
                        
                        <!-- Inputs -->
                        <TextBlock Text="Tiêu đề chiến dịch" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding BannerTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Đường dẫn ảnh (URL Unsplash/Web)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding BannerImageUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Liên kết khi click (Link URL)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding BannerLinkUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Thứ tự hiển thị (Sort Order)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding BannerSortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,20" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <!-- Save/Delete buttons -->
                        <Button Content="Kích hoạt Banner lên trang chủ" Background="{StaticResource BrandPurple}" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding AddBannerCommand}" Margin="0,0,0,10"/>
                        <Button Content="Xóa Banner được chọn" Background="#EF4444" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding DeleteBannerCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- SUB-TAB B: VOUCHERS TOÀN SÀN -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Vouchers">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Voucher table -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                    <DataGrid ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ GIẢM" Binding="{Binding VoucherCode}" Width="100"/>
                            <DataGridTextColumn Header="TÊN CHIẾN DỊCH VOUCHER" Binding="{Binding VoucherName}" Width="1.5*"/>
                            <DataGridTextColumn Header="MỨC GIẢM" Binding="{Binding DiscountValue, StringFormat={}{0:N0} đ}" Width="1*"/>
                            <DataGridTextColumn Header="ĐƠN TỐI THIỂU" Binding="{Binding MinOrderValue, StringFormat={}{0:N0} đ}" Width="1.1*"/>
                            <DataGridTextColumn Header="SL PHÁT HÀNH" Binding="{Binding TotalQuantity}" Width="100"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#E6FDF4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Hoạt động"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Vô hiệu"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Add voucher form -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                    <StackPanel>
                        <TextBlock Text="TẠO VOUCHER SÀN TÀI TRỢ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,16"/>
                        
                        <!-- Inputs -->
                        <TextBlock Text="Mã giảm giá (Ví dụ: SALE66)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding VoucherCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Tên chương trình voucher" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding VoucherName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Số tiền giảm (đ)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding VoucherDiscountValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Giá trị đơn hàng tối thiểu (đ)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding VoucherMinOrderValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Tổng số lượng phát hành" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding VoucherTotalQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,20" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <!-- Save/Delete buttons -->
                        <Button Content="Tạo và kích hoạt Voucher" Background="#10B981" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding AddVoucherCommand}" Margin="0,0,0,10"/>
                        <Button Content="Dừng hoạt động Voucher" Background="#EF4444" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding DeleteVoucherCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- SUB-TAB C: CẤU HÌNH FLASH SALE GIỜ VÀNG -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="FlashSales">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: FlashSale campaign table -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                    <DataGrid ItemsSource="{Binding FlashSales}" SelectedItem="{Binding SelectedFlashSale}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN ĐỢT SALE" Binding="{Binding CampaignName}" Width="1.2*"/>
                            <DataGridTextColumn Header="SẢN PHẨM" Binding="{Binding Product.ProductName}" Width="1.5*"/>
                            <DataGridTextColumn Header="GIÁ GỐC" Binding="{Binding Product.Price, StringFormat={}{0:N0} đ}" Width="1*"/>
                            <DataGridTextColumn Header="GIÁ FLASH SALE" Binding="{Binding FlashPrice, StringFormat={}{0:N0} đ}" Width="1.1*"/>
                            <DataGridTextColumn Header="TỒN KHO SALE" Binding="{Binding StockLimit}" Width="100"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Background="#E6FDF4">
                                            <TextBlock Text="Đang diễn ra" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Setup FlashSale form -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH FLASH SALE MỚI" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,16"/>
                        
                        <!-- Inputs -->
                        <TextBlock Text="Tên chiến dịch đợt Flash Sale" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding FlashCampaignName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Chọn sản phẩm tham gia" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding FlashSelectedProduct}" DisplayMemberPath="ProductName" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Giá bán giờ vàng (đ)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding FlashPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <TextBlock Text="Giới hạn tồn kho bán Flash Sale" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBox Text="{Binding FlashStockLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,20" Height="36" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0"/>

                        <!-- Save/Delete buttons -->
                        <Button Content="Kích hoạt đếm ngược giờ vàng" Background="#EA580C" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding AddFlashSaleCommand}" Margin="0,0,0,10"/>
                        <Button Content="Hủy chương trình Flash Sale" Background="#EF4444" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Command="{Binding DeleteFlashSaleCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
