<UserControl x:Class="TMDT.Views.Admin.AdminMarketingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        
        <Style x:Key="TabRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BorderSlate}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Info -->
            <RowDefinition Height="Auto"/>
            <!-- Marketing Category Tab switching -->
            <RowDefinition Height="Auto"/>
            <!-- Main active tab content workspace -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE ROW -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Kênh Marketing &amp; Khuyến mãi" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
            <TextBlock Text="Thiết lập banner quảng cáo, mã giảm giá do sàn tài trợ và các chiến dịch Flash Sale đếm ngược" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
        </StackPanel>

        <!-- 2. MARKETING TABS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Banners quảng cáo" Style="{StaticResource TabRadioButton}" IsChecked="True" Command="{Binding SelectTabCommand}" CommandParameter="Banners" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Vouchers toàn sàn" Style="{StaticResource TabRadioButton}" Command="{Binding SelectTabCommand}" CommandParameter="Vouchers" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Cấu hình Flash Sale" Style="{StaticResource TabRadioButton}" Command="{Binding SelectTabCommand}" CommandParameter="FlashSales" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3. WORKSPACE FOR ACTIVE TAB -->
        <Grid Grid.Row="2">
            
            <!-- ============================================== -->
            <!-- SUB-TAB A: BANNERS QUẢNG CÁO -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Banners">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Banner list table -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="16">
                    <DataGrid ItemsSource="{Binding Banners}" SelectedItem="{Binding SelectedBanner}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="THỨ TỰ" Binding="{Binding SortOrder}" Width="70"/>
                            <DataGridTextColumn Header="TIÊU ĐỀ BANNER" Binding="{Binding Title}" Width="1.5*"/>
                            <DataGridTextColumn Header="ĐƯỜNG DẪN LIÊN KẾT" Binding="{Binding LinkUrl}" Width="1*"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#E6FDF4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="{DynamicResource BorderSlate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Hoạt động"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Tạm ẩn"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Banner Form — Bento Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="14" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSlate}">
                    <Border.Effect>
                        <DropShadowEffect Color="#818CF8" BlurRadius="20" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#818CF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FFFFFF20">
                                    <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BANNER QUẢNG CÁO" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFFFFFCC" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Thiết lập banner trang chủ" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Form Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="20,16,20,20">

                                <TextBlock Text="TIÊU ĐỀ CHIẾN DỊCH" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding BannerTitle, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>

                                <TextBlock Text="ĐỊA CHỈ ẢNH (URL)" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding BannerImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>

                                <TextBlock Text="LIÊN KẾT KHI CLICK" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding BannerLinkUrl, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>

                                <TextBlock Text="THỨ TỰ HIỂN THỊ" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                                    <TextBox Text="{Binding BannerSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>

                                <!-- Action Buttons -->
                                <Button Command="{Binding AddBannerCommand}" Height="40" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#6366F1" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Kích hoạt Banner" Foreground="White" FontSize="12.5"
                                                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding DeleteBannerCommand}" Height="40" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource DangerRedBg}" CornerRadius="8"
                                                    BorderBrush="{DynamicResource DangerRed}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{DynamicResource DangerRed}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Xóa Banner" Foreground="{DynamicResource DangerRed}"
                                                               FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- SUB-TAB B: VOUCHERS TOÀN SÀN -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="Vouchers">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Voucher table -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="16">
                    <DataGrid ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MÃ GIẢM" Binding="{Binding VoucherCode}" Width="100"/>
                            <DataGridTextColumn Header="TÊN CHIẾN DỊCH VOUCHER" Binding="{Binding VoucherName}" Width="1.5*"/>
                            <DataGridTextColumn Header="MỨC GIẢM" Binding="{Binding DiscountValue, StringFormat={}{0:N0} đ}" Width="1*"/>
                            <DataGridTextColumn Header="ĐƠN TỐI THIỂU" Binding="{Binding MinOrderValue, StringFormat={}{0:N0} đ}" Width="1.1*"/>
                            <DataGridTextColumn Header="SL PHÁT HÀNH" Binding="{Binding TotalQuantity}" Width="100"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#E6FDF4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Hoạt động"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Vô hiệu"/>
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: Voucher Form — Bento Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="14" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSlate}">
                    <Border.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#059669" Offset="0"/>
                                    <GradientStop Color="#10B981" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FFFFFF20">
                                    <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="VOUCHER TOÀN SÀN" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFFFFFCC" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Tạo mã giảm giá sàn tài trợ" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Form Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="20,16,20,20">
                                <TextBlock Text="MÃ GIẢM GIÁ" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding VoucherCode, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="TÊN CHƯƠNG TRÌNH" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding VoucherName, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="SỐ TIỀN GIẢM (đ)" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding VoucherDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="ĐƠN HÀNG TỐI THIỂU (đ)" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding VoucherMinOrderValue, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="SỐ LƯỢNG PHÁT HÀNH" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                                    <TextBox Text="{Binding VoucherTotalQuantity, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <Button Command="{Binding AddVoucherCommand}" Height="40" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#10B981" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Tạo &amp; Kích hoạt Voucher" Foreground="White" FontSize="12.5"
                                                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding DeleteVoucherCommand}" Height="40" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource DangerRedBg}" CornerRadius="8"
                                                    BorderBrush="{DynamicResource DangerRed}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{DynamicResource DangerRed}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Dừng Voucher" Foreground="{DynamicResource DangerRed}"
                                                               FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- SUB-TAB C: CẤU HÌNH FLASH SALE GIỜ VÀNG -->
            <!-- ============================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTab}" Value="FlashSales">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: FlashSale campaign table -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="16">
                    <DataGrid ItemsSource="{Binding FlashSales}" SelectedItem="{Binding SelectedFlashSale}" AutoGenerateColumns="False" 
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True" HeadersVisibility="Column" RowHeight="46">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÊN ĐỢT SALE" Binding="{Binding CampaignName}" Width="1.2*"/>
                            <DataGridTextColumn Header="SẢN PHẨM" Binding="{Binding Product.ProductName}" Width="1.5*"/>
                            <DataGridTextColumn Header="GIÁ GỐC" Binding="{Binding Product.Price, StringFormat={}{0:N0} đ}" Width="1*"/>
                            <DataGridTextColumn Header="GIÁ FLASH SALE" Binding="{Binding FlashPrice, StringFormat={}{0:N0} đ}" Width="1.1*"/>
                            <DataGridTextColumn Header="TỒN KHO SALE" Binding="{Binding StockLimit}" Width="100"/>
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" Background="{DynamicResource ActionBtnHoverBg}">
                                            <TextBlock Text="Đang diễn ra" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Column: FlashSale Form — Bento Card -->
                <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="14" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderSlate}">
                    <Border.Effect>
                        <DropShadowEffect Color="#EA580C" BlurRadius="20" ShadowDepth="0" Opacity="0.08"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header -->
                        <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="20,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#C2410C" Offset="0"/>
                                    <GradientStop Color="#EA580C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FFFFFF20">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="FLASH SALE GIỜ VÀNG" FontSize="11" FontWeight="Bold"
                                               Foreground="#FFFFFFCC" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    <TextBlock Text="Cấu hình chiến dịch đếm ngược" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="White" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Form Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="20,16,20,20">
                                <TextBlock Text="TÊN CHIẾN DỊCH" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding FlashCampaignName, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="SẢN PHẨM THAM GIA" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <ComboBox ItemsSource="{Binding AvailableProducts}" SelectedItem="{Binding FlashSelectedProduct}"
                                              DisplayMemberPath="ProductName" BorderThickness="0" Height="36" Background="Transparent"
                                              Padding="6,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="GIÁ BÁN GIỜ VÀNG (đ)" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                                    <TextBox Text="{Binding FlashPrice, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <TextBlock Text="GIỚI HẠN TỒN KHO" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <Border BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                                    <TextBox Text="{Binding FlashStockLimit, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Height="36" Background="Transparent"
                                             Padding="10,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                                </Border>
                                <Button Command="{Binding AddFlashSaleCommand}" Height="40" Cursor="Hand" Margin="0,0,0,10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#EA580C" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Kích hoạt Flash Sale" Foreground="White" FontSize="12.5"
                                                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Command="{Binding DeleteFlashSaleCommand}" Height="40" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{DynamicResource DangerRedBg}" CornerRadius="8"
                                                    BorderBrush="{DynamicResource DangerRed}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{DynamicResource DangerRed}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Hủy Flash Sale" Foreground="{DynamicResource DangerRed}"
                                                               FontSize="12.5" FontWeight="Bold" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>




