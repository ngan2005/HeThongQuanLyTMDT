<UserControl x:Class="TMDT.Views.Admin.AdminUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#414750"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#004277"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & search filter row -->
            <RowDefinition Height="Auto"/>
            <!-- Content layout: DataGrid + Inspector Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE & FILTERS -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý Thành viên hệ thống" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <TextBlock Text="Xem chi tiết lý lịch người dùng, thay đổi vai trò tài khoản, khóa hoặc khôi phục hoạt động" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
            </StackPanel>

            <!-- Quick Filters & Search -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- Search Box -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Width="200" Height="36" Padding="8,0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                    </Grid>
                </Border>

                <!-- Role Filter -->
                <ComboBox SelectedValue="{Binding RoleFilter}" SelectedValuePath="Tag" Width="100" Height="36" Margin="0,0,10,0" Padding="8,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12">
                    <ComboBoxItem Content="Tất cả Vai trò" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Admin" Tag="Admin"/>
                    <ComboBoxItem Content="Buyer" Tag="Buyer"/>
                    <ComboBoxItem Content="Seller" Tag="Seller"/>
                </ComboBox>

                <!-- Status Filter -->
                <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag" Width="110" Height="36" Padding="8,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12">
                    <ComboBoxItem Content="Tất cả Trạng thái" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Hoạt động" Tag="Active"/>
                    <ComboBoxItem Content="Tạm khóa" Tag="Locked"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN LAYOUT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Users DataGrid list -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column" RowHeight="46" FontFamily="Be Vietnam Pro, Segoe UI">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- ID -->
                        <DataGridTextColumn Header="MÃ" Binding="{Binding UserId}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Name -->
                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding FullName}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Email -->
                        <DataGridTextColumn Header="EMAIL LIÊN LẠC" Binding="{Binding Email}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Role -->
                        <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding Role.RoleName}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Points -->
                        <DataGridTextColumn Header="ĐIỂM LOYALTY" Binding="{Binding LoyaltyPoints, TargetNullValue=0}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#E6FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Đang hoạt động"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Tạm khóa"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: User Detail Inspector & Moderation Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <Grid>
                    <!-- Display when selected user is null -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn thành viên để cấu hình" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Display when selected user is NOT null -->
                    <ScrollViewer>
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedUser}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="CHI TIẾT THÀNH VIÊN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,0,0,16"/>

                            <!-- Avatar -->
                            <Border Width="68" Height="68" CornerRadius="34" Background="#F1F5F9" BorderBrush="{StaticResource BrandPurple}" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Grid>
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Profile details -->
                            <TextBlock Text="{Binding SelectedUser.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedUser.Email}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,16"/>

                            <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                            <!-- Section: Role Configuration -->
                            <TextBlock Text="Vai trò hệ thống" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName" SelectedItem="{Binding SelectedRoleForUser}" Height="36" Margin="0,0,0,10" Padding="8,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                            
                            <!-- Update Role Button -->
                            <Button Content="Cập nhật vai trò" Command="{Binding UpdateUserRoleCommand}" Background="{StaticResource BrandPurple}" Foreground="#FFFFFF" Style="{StaticResource ActionButton}" Margin="0,0,0,18"/>

                            <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                            <!-- Section: Safety Actions (Ban/Activate) -->
                            <TextBlock Text="Bảo mật &amp; Quản trị" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                            
                            <Button Command="{Binding ToggleUserStatusCommand}" Foreground="#FFFFFF" Margin="0,0,0,18">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="True">
                                                <Setter Property="Content" Value="Khóa tài khoản thành viên"/>
                                                <Setter Property="Background" Value="#EF4444"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedUser.IsActive}" Value="False">
                                                <Setter Property="Content" Value="Kích hoạt tài khoản"/>
                                                <Setter Property="Background" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Separator Background="#F1F5F9" Margin="0,0,0,16"/>

                            <!-- Section: Reset Password -->
                            <TextBlock Text="Khôi phục mật khẩu" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NewPasswordText, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,10" BorderBrush="#DFE9FD" BorderThickness="1" Padding="8,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="12.5"/>
                            <Button Content="Đặt lại mật khẩu mới" Command="{Binding ResetPasswordCommand}" Background="#EA580C" Foreground="#FFFFFF" Style="{StaticResource ActionButton}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

