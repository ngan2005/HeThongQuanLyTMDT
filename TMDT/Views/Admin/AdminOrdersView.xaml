<UserControl x:Class="TMDT.Views.Admin.AdminOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#414750"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#004277"/>
        
        <!-- Command button styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Table + Detail Inspector -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE & SEARCH ROW -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý Đơn hàng Toàn sàn" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <TextBlock Text="Giám sát mọi giao dịch mua bán, can thiệp xử lý hủy đơn khẩn cấp hoặc hoàn tiền khi cần thiết" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#DFE9FD" Height="38" Padding="12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" 
                             VerticalAlignment="Center" FontSize="12.5" Padding="6,0,0,0" Margin="0" 
                             Tag="Tìm mã đơn, tên shop, người mua..." FontFamily="Be Vietnam Pro, Segoe UI"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. FILTER STATUS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Trạng thái:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" Width="160" Height="32" FontSize="12.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#DFE9FD"/>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN CONTENT: TABLE + INSPECTOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Orders DataGrid -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <!-- Detail Inspector Card -->
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid List -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>
                
                <DataGrid ItemsSource="{Binding FilteredOrders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column" RowHeight="44" FontFamily="Be Vietnam Pro, Segoe UI">
                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Order Code -->
                        <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding OrderCode}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Buyer Name -->
                        <DataGridTextColumn Header="NGƯỜI MUA" Binding="{Binding Buyer.FullName}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Shop Name -->
                        <DataGridTextColumn Header="CỬA HÀNG" Binding="{Binding Shop.ShopName}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Total Amount -->
                        <DataGridTextColumn Header="TỔNG TIỀN" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Chờ xác nhận">
                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Đang xử lý">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Đang giao hàng">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Hoàn thành">
                                                        <Setter Property="Background" Value="#E6FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Đã hủy">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OrderStatus}" Value="Hoàn tiền">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <TextBlock Text="{Binding OrderStatus}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Chờ xác nhận">
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Đang xử lý">
                                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Đang giao hàng">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Hoàn thành">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Đã hủy">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding OrderStatus}" Value="Hoàn tiền">
                                                            <Setter Property="Foreground" Value="#9333EA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Order Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <Grid>
                    <!-- Displayed only when an Order is selected -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrderSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header details -->
                            <RowDefinition Height="*"/>    <!-- Scrollable fields -->
                            <RowDefinition Height="Auto"/> <!-- Actions footer -->
                        </Grid.RowDefinitions>

                        <!-- Header Info -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                            <Border Width="60" Height="60" Background="#EFF3FF" CornerRadius="30" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedOrder.OrderCode}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,4" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="{Binding SelectedOrder.OrderDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="11.5" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>

                        <!-- Detail Fields ScrollView -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Basic Info -->
                                <TextBlock Text="THÔNG TIN NGƯỜI MUA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedOrder.Buyer.FullName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,12" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <TextBlock Text="THÔNG TIN CỬA HÀNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedOrder.Shop.ShopName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,12" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <TextBlock Text="PHƯƠNG THỨC THANH TOÁN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedOrder.PaymentMethod}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,12" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Items List -->
                                <TextBlock Text="SẢN PHẨM TRONG ĐƠN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding SelectedOrder.OrderDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="#F1F5F9" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Product.ProductName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Quantity, StringFormat={}Số lượng: {0}}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding UnitPrice, StringFormat={}{0:N0} đ}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Totals -->
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Tạm tính" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding SelectedOrder.SubTotal, StringFormat={}{0:N0} đ}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Phí vận chuyển" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding SelectedOrder.ShippingFee, StringFormat={}{0:N0} đ}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Giảm giá" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="{Binding SelectedOrder.Discount, StringFormat={}-{0:N0} đ}" FontSize="11.5" FontWeight="SemiBold" Foreground="#EF4444" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Margin="0,6" Padding="0,8,0,0">
                                            <Grid>
                                                <TextBlock Text="Tổng thanh toán" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding SelectedOrder.TotalAmount, StringFormat={}{0:N0} đ}" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons Footer -->
                        <StackPanel Grid.Row="2">
                            <!-- Refund button -->
                            <Button Content="Thực hiện Hoàn tiền" 
                                    Background="#F59E0B" Foreground="#FFFFFF"
                                    Command="{Binding RefundOrderCommand}"
                                    Style="{StaticResource ActionButton}">
                            </Button>

                            <!-- Cancel button -->
                            <Button Content="Hủy đơn khẩn cấp" 
                                    Background="#EF4444" Foreground="#FFFFFF"
                                    Command="{Binding CancelOrderCommand}"
                                    Style="{StaticResource ActionButton}">
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Unselected state placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOrderSelected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#DFE9FD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một đơn hàng để xem thông tin chi tiết và thao tác quản lý" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextAlignment="Center" Width="180" TextWrapping="Wrap" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

