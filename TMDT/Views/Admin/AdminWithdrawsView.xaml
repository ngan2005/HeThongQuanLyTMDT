<UserControl x:Class="TMDT.Views.Admin.AdminWithdrawsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#1C1B1A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#414750"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#004277"/>
        
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command button styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Table + Detail Inspector -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE & SEARCH ROW -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Yêu cầu rút tiền" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <TextBlock Text="Phê duyệt các giao dịch rút tiền tích lũy của Shop về tài khoản ngân hàng liên kết" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#DFE9FD" Height="38" Padding="12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" 
                             VerticalAlignment="Center" FontSize="12.5" Padding="6,0,0,0" Margin="0" 
                             Tag="Tìm kiếm tên Shop, ngân hàng..." FontFamily="Be Vietnam Pro, Segoe UI"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. FILTER STATUS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Tất cả yêu cầu" Style="{StaticResource FilterButton}" IsChecked="True" Command="{Binding FilterCommand}" CommandParameter="All" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Chờ xử lý" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Pending" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Đã duyệt chi" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Approved" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Bị từ chối" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Rejected" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN CONTENT: TABLE + INSPECTOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Withdraw Requests DataGrid -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <!-- Detail Inspector Card -->
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid List -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>
                
                <DataGrid ItemsSource="{Binding WithdrawRequests}" SelectedItem="{Binding SelectedRequest}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column" RowHeight="44" FontFamily="Be Vietnam Pro, Segoe UI">
                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Request ID -->
                        <DataGridTextColumn Header="MÃ YC" Binding="{Binding WithdrawId, StringFormat={}{0}}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Shop Selling -->
                        <DataGridTextColumn Header="CỬA HÀNG RÚT TIỀN" Binding="{Binding Shop.ShopName}" Width="1.3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Amount -->
                        <DataGridTextColumn Header="SỐ TIỀN RÚT" Binding="{Binding Amount, StringFormat={}{0:N0} đ}" Width="1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Bank Name -->
                        <DataGridTextColumn Header="NGÂN HÀNG" Binding="{Binding BankName}" Width="1.5*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Account Number -->
                        <DataGridTextColumn Header="SỐ TÀI KHOẢN" Binding="{Binding AccountNumber}" Width="1.1*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Date -->
                        <DataGridTextColumn Header="NGÀY YÊU CẦU" Binding="{Binding RequestedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                        <Setter Property="Background" Value="#E6FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Background" Value="#FEF2F2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Text" Value="Chờ xử lý"/>
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Text" Value="Đã duyệt chi"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Text" Value="Từ chối"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Withdraw Request Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <Grid>
                    <!-- Displayed only when a Request is selected -->
                    <Grid Visibility="{Binding SelectedRequest, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Wallet and Bank icons large -->
                            <RowDefinition Height="*"/>    <!-- Detail fields scroll -->
                            <RowDefinition Height="Auto"/> <!-- Actions footer -->
                        </Grid.RowDefinitions>

                        <!-- Large Icons Header -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                            <Border Width="60" Height="60" Background="#EFF3FF" CornerRadius="30" HorizontalAlignment="Center">
                                <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{StaticResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedRequest.Shop.ShopName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,4" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            
                            <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Pending">
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Approved">
                                                <Setter Property="Background" Value="#E6FDF4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Rejected">
                                                <Setter Property="Background" Value="#FEF2F2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Pending">
                                                    <Setter Property="Text" Value="YÊU CẦU ĐANG CHỜ PHÊ DUYỆT"/>
                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Approved">
                                                    <Setter Property="Text" Value="GIAO DỊCH ĐÃ HOÀN TẤT"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Rejected">
                                                    <Setter Property="Text" Value="ĐÃ TỪ CHỐI DUYỆT CHI"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Detail Fields ScrollView -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Amount requested -->
                                <TextBlock Text="SỐ TIỀN YÊU CẦU RÚT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedRequest.Amount, StringFormat={}{0:N0} đ}" FontSize="22" FontWeight="ExtraBold" Foreground="#EF4444" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Shop Current Balance -->
                                <TextBlock Text="SỐ DƯ VÍ HIỆN TẠI CỦA SHOP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedRequest.Shop.WalletBalance, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Bank Name -->
                                <TextBlock Text="NGÂN HÀNG LIÊN KẾT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedRequest.BankName}" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Account Number -->
                                <TextBlock Text="SỐ TÀI KHOẢN NHẬN TIỀN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12,10" Margin="0,4,0,16" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedRequest.AccountNumber}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sao chép" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource BrandPurple}" FontWeight="SemiBold" Cursor="Hand"/>
                                    </Grid>
                                </Border>

                                <!-- Requested date -->
                                <TextBlock Text="THỜI GIAN YÊU CẦU" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedRequest.RequestedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                                <!-- Processed date -->
                                <TextBlock Text="THỜI GIAN PHÊ DUYỆT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="{Binding SelectedRequest.ProcessedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='Chưa xử lý'}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons Footer -->
                        <StackPanel Grid.Row="2">
                            <!-- Approve button (Visible only when pending) -->
                            <Button Content="Phê duyệt &amp; Chuyển khoản" 
                                    Background="#10B981" Foreground="#FFFFFF"
                                    Command="{Binding ApproveWithdrawCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Reject button (Visible only when pending) -->
                            <Button Content="Từ chối yêu cầu" 
                                    Background="#EF4444" Foreground="#FFFFFF"
                                    Command="{Binding RejectWithdrawCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRequest.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Unselected state placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedRequest}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#DFE9FD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một yêu cầu để tiến hành duyệt chi tiền" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextAlignment="Center" Width="180" TextWrapping="Wrap" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

