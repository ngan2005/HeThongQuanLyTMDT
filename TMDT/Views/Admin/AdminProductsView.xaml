<UserControl x:Class="TMDT.Views.Admin.AdminProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.07" Color="#000" Direction="270"/>

        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceMid}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSlate}"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===== MAIN CONTENT ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,20">
                <!-- Page Header -->
                <TextBlock Text="Phê duyệt sản phẩm" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,4"/>
                <TextBlock Text="Kiểm duyệt thông tin, giá bán và nguồn gốc sản phẩm đăng bán của các Shop"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,24"/>

                <!-- Stats Row -->
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Tổng sản phẩm" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Đăng ký trên sàn" FontSize="10.5" Foreground="{DynamicResource BrandPurple}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Chờ phê duyệt" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="{Binding PendingProducts}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningOrange}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Cần duyệt bán ngay" FontSize="10.5" Foreground="{DynamicResource WarningOrange}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Đang bán (Đã duyệt)" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="{Binding ApprovedProducts}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Hiển thị trên sàn" FontSize="10.5" Foreground="{DynamicResource SuccessGreen}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Bị từ chối duyệt" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock Text="{Binding RejectedProducts}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerRed}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Yêu cầu sửa đổi" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Toolbar -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="Tất cả" Style="{StaticResource FilterPill}" IsChecked="True" Tag="All" Click="FilterPill_Click"/>
                        <RadioButton Content="Chờ duyệt" Style="{StaticResource FilterPill}" Tag="Pending" Click="FilterPill_Click" Margin="6,0,0,0"/>
                        <RadioButton Content="Đang bán" Style="{StaticResource FilterPill}" Tag="Approved" Click="FilterPill_Click" Margin="6,0,0,0"/>
                        <RadioButton Content="Bị từ chối" Style="{StaticResource FilterPill}" Tag="Rejected" Click="FilterPill_Click" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Search -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="36" Padding="12,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     FontSize="12.5" Padding="6,0,0,0" Tag="Tìm tên sản phẩm, shop..." FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Product List Table -->
                <Border Background="{DynamicResource CardBg}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Effect="{StaticResource CardShadow}" Padding="0">
                    <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False"
                               Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                               CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                               RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                               HeadersVisibility="Column" RowHeight="54"
                               FontFamily="Be Vietnam Pro, Segoe UI"
                               SelectionMode="Single"
                               Foreground="{DynamicResource TextPrimary}"
                               MouseDoubleClick="DataGrid_MouseDoubleClick"
                               SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSlate}"/>
                                <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource GridSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource GridSelectedBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="MÃ SP" Binding="{Binding ProductCode}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="SẢN PHẨM" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" Background="{DynamicResource SurfaceMid}" CornerRadius="8" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI" Text="{Binding Category.CategoryName, FallbackValue='-'}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="CỬA HÀNG" Binding="{Binding Shop.ShopName}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="GIÁ BÁN" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="1.1*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrandPurple}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="KHO" Binding="{Binding StockQuantity, StringFormat={}{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessGreenBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Background" Value="{DynamicResource DangerRedBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Text" Value="Chờ duyệt"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Text" Value="Đang bán"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Text" Value="Bị từ chối"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Text" Value="Chờ duyệt"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="Chờ duyệt"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="ViewProduct_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4"
                                                ToolTip="Xem chi tiết">
                                            <materialDesign:PackIcon Kind="ChevronRight" Foreground="{DynamicResource TextSecondary}" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== LIGHTBOX DETAIL OVERLAY ===== -->
        <Grid x:Name="LightboxOverlay" Visibility="Collapsed" Background="#CC000000" Margin="0,0,-8,0">
            <!-- Backdrop Click to Close -->
            <Button Click="CloseLightbox" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- MODAL CARD — Wide Bento Layout -->
            <Border Background="{DynamicResource CardBg}" CornerRadius="16" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderSlate}"
                    Width="860" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#818CF8" BlurRadius="40" ShadowDepth="0" Opacity="0.12"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Header -->
                        <RowDefinition Height="Auto"/>   <!-- Bento Stats -->
                        <RowDefinition Height="*"/>      <!-- Body -->
                        <RowDefinition Height="Auto"/>   <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- ── ROW 0: HEADER ─────────────────────────────────────────── -->
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="32,28,32,24" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource BgMain.Color}" Offset="0"/>
                                <GradientStop Color="{DynamicResource SurfaceHigh.Color}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>   <!-- Image box -->
                                <ColumnDefinition Width="*"/>      <!-- Name + status -->
                                <ColumnDefinition Width="Auto"/>   <!-- Close Button -->
                            </Grid.ColumnDefinitions>

                            <!-- Rotated Avatar Box -->
                            <Grid Grid.Column="0" Margin="0,0,24,0" Width="80" Height="80">
                                <Border CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource BrandPurple}"
                                        Background="{DynamicResource BrandActiveBg}" Width="80" Height="80">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="3" CenterX="40" CenterY="40"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="{DynamicResource BrandPurple}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Name & Status -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedProduct.ProductName}" FontSize="24" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Pending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Approved">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessGreenBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Rejected">
                                                        <Setter Property="Background" Value="{DynamicResource DangerRedBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Pending">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÊ DUYỆT ĐĂNG BÁN"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Approved">
                                                            <Setter Property="Text" Value="✅ SẢN PHẨM ĐANG BÁN"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Rejected">
                                                            <Setter Property="Text" Value="❌ BỊ TỪ CHỐI DUYỆT BÁN"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÊ DUYỆT ĐĂNG BÁN"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÊ DUYỆT ĐĂNG BÁN"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Close Button (top right) -->
                            <Button Grid.Column="2" Click="CloseLightbox" Background="Transparent"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}"
                                    Width="40" Height="40" Cursor="Hand" VerticalAlignment="Top">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHigh}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── ROW 1: BENTO STATS GRID ───────────────────────────────── -->
                    <Grid Grid.Row="1" Margin="32,8,32,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Price -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="GIÁ ĐỀ XUẤT ĐĂNG BÁN" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource BrandPurple}" FontFamily="Be Vietnam Pro, Segoe UI" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SelectedProduct.Price, StringFormat={}{0:N0}, TargetNullValue='0'}"/><Run Text=" đ"/>
                                </TextBlock>
                                <!-- Glow effect bar -->
                                <Border Height="3" CornerRadius="2" Background="{DynamicResource BorderSlate}" Margin="0,10,0,0">
                                    <Border.Child>
                                        <Border Width="80" Height="3" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource BrandPurple}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource BrandPurple.Color}" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border.Child>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Stock -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="SỐ LƯỢNG KHO SẴN CÓ" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource SuccessGreen}" FontFamily="Be Vietnam Pro, Segoe UI">
                                    <Run Text="{Binding SelectedProduct.StockQuantity, StringFormat={}{0:N0}, TargetNullValue='0'}"/><Run Text=" sp"/>
                                </TextBlock>
                                <Border Height="3" CornerRadius="2" Background="{DynamicResource BorderSlate}" Margin="0,10,0,0">
                                    <Border.Child>
                                        <Border Width="60" Height="3" CornerRadius="2" HorizontalAlignment="Left" Background="{DynamicResource SuccessGreen}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource SuccessGreen.Color}" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                            </Border.Effect>
                                        </Border>
                                    </Border.Child>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Sold count -->
                        <Border Grid.Column="4" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="ĐÃ BÁN TRÊN HỆ THỐNG" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock FontSize="20" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI">
                                    <Run Text="{Binding SelectedProduct.SoldCount, StringFormat={}{0:N0}, TargetNullValue='0'}"/><Run Text=" sp"/>
                                </TextBlock>
                                <TextBlock Text="Thống kê tích lũy" FontSize="9.5" Foreground="{DynamicResource TextMuted}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── ROW 2: BODY — Asymmetric Layout ───────────────────────── -->
                    <Grid Grid.Row="2" Margin="32,0,32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Product Info -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" MaxHeight="300">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Width="20" Height="1" Background="{DynamicResource BrandPurple}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Thông tin chi tiết sản phẩm" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource BrandPurple}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Shop selling -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="CỬA HÀNG ĐĂNG BÁN" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedProduct.Shop.ShopName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>

                                    <!-- Category -->
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="DANH MỤC SẢN PHẨM" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedProduct.Category.CategoryName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>

                                    <!-- Original Price -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="GIÁ GỐC NIÊM YẾT" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedProduct.OriginalPrice, StringFormat={}{0:N0} đ, TargetNullValue='-'}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextDecorations="Strikethrough" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>

                                    <!-- Date created -->
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="NGÀY ĐĂNG BÁN" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedProduct.CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='-'}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="MÔ TẢ CHI TIẾT" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"
                                                   FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedProduct.Description}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Opacity="0.9" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT: Action Panel -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceHigh}" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Kiểm duyệt đăng" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,14"/>

                                <TextBlock Text="Vui lòng kiểm tra kỹ nội dung, giá bán và xuất xứ sản phẩm trước khi phê duyệt hiển thị."
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,16"/>

                                <!-- Approve Button -->
                                <Button Command="{Binding ApproveProductCommand}" Background="{DynamicResource SuccessGreen}" BorderThickness="0"
                                        Height="40" Cursor="Hand" Margin="0,0,0,8">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Pending">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Rejected">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="CheckCircle" Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Phê duyệt hiển thị" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Reject Button -->
                                <Button Command="{Binding RejectProductCommand}" Background="{DynamicResource DangerRed}" BorderThickness="0"
                                        Height="40" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Pending">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="Approved">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedProduct.Status}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Cancel" Foreground="White" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Từ chối đăng bán" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── ROW 3: FOOTER ──────────────────────────────────────────── -->
                    <Border Grid.Row="3" CornerRadius="0,0,16,16" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderSlate}" Padding="32,12" Margin="0,16,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="#0A0E1A" Opacity="0.5"/>
                        </Border.Background>
                        <Grid>
                            <TextBlock HorizontalAlignment="Left" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="MÃ SẢN PHẨM: #{0}">
                                        <Binding Path="SelectedProduct.ProductCode"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="ID SẢN PHẨM: #{0}">
                                        <Binding Path="SelectedProduct.ProductId"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
