<UserControl x:Class="TMDT.Views.Admin.AdminComplaintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#000" Direction="270"/>

        <!-- Pill-style Filters -->
        <Style x:Key="FilterPill" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SurfaceLow}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceMid}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrandAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSlate}"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===== MAIN CONTENT ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,20">
                <!-- Page Header -->
                <TextBlock Text="Giải quyết khiếu nại" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <TextBlock Text="Phân xử tranh chấp, khiếu nại từ Người mua đối với các Shop và Đơn hàng trên hệ thống"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI" Margin="0,0,0,24"/>

                <!-- Stats Row (Bento Grid Style) -->
                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <!-- Total Complaints -->
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Tổng khiếu nại" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding TotalComplaints}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Yêu cầu từ khách hàng" FontSize="10.5" Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Pending Complaints -->
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Chờ giải quyết" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding PendingComplaints}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource WarningOrange}" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Cần phân xử gấp" FontSize="10.5" Foreground="{DynamicResource WarningOrange}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Resolved Complaints -->
                    <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Đã xử lý" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding ResolvedComplaints}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Đã đưa ra phương án" FontSize="10.5" Foreground="{DynamicResource SuccessGreen}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Dismissed Complaints -->
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="Đã bác bỏ" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                            <TextBlock Text="{Binding DismissedComplaints}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                            <TextBlock Text="Yêu cầu không hợp lệ" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- AI SUMMARIZER BANNER -->
                <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrandPurple}" Margin="0,0,0,24" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource BrandPurple.Color}" BlurRadius="20" ShadowDepth="0" Opacity="0.15"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="48" Height="48" Background="{DynamicResource BrandActiveBg}" CornerRadius="12" Margin="0,0,16,0" VerticalAlignment="Top">
                            <TextBlock Text="&#xE8B3;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="AI Tóm tắt Khiếu nại" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            
                            <TextBlock Text="Bấm 'AI Tóm tắt' để hệ thống đọc toàn bộ khiếu nại đang lọc bên dưới và rút ra xu hướng chung." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AiSummary}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AiSummary}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <TextBlock Text="{Binding AiSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" TextWrapping="Wrap" LineHeight="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AiSummary}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AiSummary}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        
                        <Button Grid.Column="2" Command="{Binding SummarizeComplaintsCommand}" Background="{DynamicResource BrandPurple}" BorderThickness="0" Height="40" Padding="16,0" Cursor="Hand" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsAiSummarizing, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAiSummarizing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="AI Tóm tắt" Foreground="White" FontSize="12.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Toolbar -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Filter Pills -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton Content="Tất cả khiếu nại" Style="{StaticResource FilterPill}" IsChecked="True" Tag="All" Click="FilterPill_Click"/>
                        <RadioButton Content="Chờ giải quyết" Style="{StaticResource FilterPill}" Tag="Pending" Click="FilterPill_Click" Margin="6,0,0,0"/>
                        <RadioButton Content="Đã xử lý" Style="{StaticResource FilterPill}" Tag="Resolved" Click="FilterPill_Click" Margin="6,0,0,0"/>
                        <RadioButton Content="Đã bác bỏ" Style="{StaticResource FilterPill}" Tag="Dismissed" Click="FilterPill_Click" Margin="6,0,0,0"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="36" Padding="12,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                     FontSize="12.5" Padding="6,0,0,0" Tag="Tìm tên khách, nội dung..." FontFamily="Segoe UI"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Complaints DataGrid -->
                <Border Background="{DynamicResource CardBg}" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Effect="{StaticResource CardShadow}" Padding="0">
                    <DataGrid x:Name="ComplaintsGrid" ItemsSource="{Binding Complaints}" SelectedItem="{Binding SelectedComplaint}" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              RowBackground="{DynamicResource GridRowBg}" AlternatingRowBackground="{DynamicResource GridAltRowBg}"
                              HeadersVisibility="Column" RowHeight="54"
                              FontFamily="Segoe UI"
                              SelectionMode="Single"
                              Foreground="{DynamicResource TextPrimary}"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              SelectionChanged="DataGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSlate}"/>
                                <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource GridSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource GridHoverBg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- Complaint ID -->
                            <DataGridTextColumn Header="MÃ KN" Binding="{Binding ComplaintId}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Buyer Name -->
                            <DataGridTextColumn Header="NGƯỜI KHIẾU NẠI" Binding="{Binding Buyer.FullName}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Order ID -->
                            <DataGridTextColumn Header="MÃ ĐƠN HÀNG" Binding="{Binding OrderId}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrandPurple}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Content -->
                            <DataGridTextColumn Header="NỘI DUNG KHIẾU NẠI" Binding="{Binding Content}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Date Submitted -->
                            <DataGridTextColumn Header="NGÀY GỬI" Binding="{Binding SubmittedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessGreenBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                            <Setter Property="Background" Value="{DynamicResource BorderSlate}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Text" Value="⏳ Chờ xử lý"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                                <Setter Property="Text" Value="✅ Đã giải quyết"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                                <Setter Property="Text" Value="❌ Đã bác bỏ"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="">
                                                                <Setter Property="Text" Value="⏳ Chờ xử lý"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="⏳ Chờ xử lý"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Click="ViewComplaint_Click" Content="Chi tiết" Background="Transparent"
                                                BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1"
                                                Height="28" Padding="12,0" Cursor="Hand" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceLow}"/>
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandPurple}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== LIGHTBOX MODAL OVERLAY ===== -->
        <Grid x:Name="LightboxOverlay" Visibility="Collapsed" Background="#C0000000" MouseDown="LightboxOverlay_MouseDown">
            <Border Width="860" Height="580" Background="{DynamicResource CardBg}" CornerRadius="16"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Bento Stats Row -->
                        <RowDefinition Height="*"/>    <!-- Body Content -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- ── ROW 0: HEADER ─────────────────────────────────────────── -->
                    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSlate}" Padding="32,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Chi tiết phân xử khiếu nại" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="TRẠNG THÁI:" FontSize="10.5" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Resolved">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessGreenBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Dismissed">
                                                        <Setter Property="Background" Value="{DynamicResource BorderSlate}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="{x:Null}">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÂN XỬ"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Resolved">
                                                            <Setter Property="Text" Value="✅ ĐÃ GIẢI QUYẾT XONG"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Dismissed">
                                                            <Setter Property="Text" Value="❌ ĐÃ BÁC BỎ YÊU CẦU"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÂN XỬ"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="⏳ CHỜ PHÂN XỬ"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningOrange}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Close Button -->
                            <Button Grid.Column="2" Click="CloseLightbox" Background="Transparent"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}"
                                    Width="40" Height="40" Cursor="Hand" VerticalAlignment="Top">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHigh}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ── ROW 1: BENTO STATS GRID ───────────────────────────────── -->
                    <Grid Grid.Row="1" Margin="32,20,32,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Buyer Info -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="NGƯỜI GỬI KHIẾU NẠI" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedComplaint.Buyer.FullName}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedComplaint.Buyer.Email}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Order Info -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="ĐƠN HÀNG TRANH CHẤP" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI">
                                    <Run Text="Mã đơn: #"/><Run Text="{Binding SelectedComplaint.OrderId}"/>
                                </TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" Margin="0,4,0,0">
                                    <Run Text="Trị giá: "/><Run Text="{Binding SelectedComplaint.Order.TotalAmount, StringFormat={}{0:N0}}"/><Run Text=" đ"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Date Submitted -->
                        <Border Grid.Column="4" Background="{DynamicResource SurfaceHigh}" CornerRadius="10"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="NGÀY GỬI KHIẾU NẠI" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontFamily="Segoe UI" Margin="0,0,0,6"/>
                                <TextBlock FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI">
                                    <Run Text="{Binding SelectedComplaint.SubmittedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue='Chưa rõ'}"/>
                                </TextBlock>
                                <TextBlock Text="Đã ghi nhận trên hệ thống" FontSize="9.5" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── ROW 2: BODY — Asymmetric Layout ───────────────────────── -->
                    <Grid Grid.Row="2" Margin="32,0,32,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Complaint Content -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceHigh}" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Text="NỘI DUNG KHIẾU NẠI CHI TIẾT" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource DangerRed}" FontFamily="Segoe UI" Margin="0,0,0,10"/>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                    <TextBlock Text="{Binding SelectedComplaint.Content}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" 
                                               TextWrapping="Wrap" LineHeight="20" FontFamily="Segoe UI"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Right: Resolution Entry -->
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceHigh}" CornerRadius="12"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="PHƯƠNG ÁN PHÂN XỬ &amp; LÝ DO BÁC BỎ" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                                <Border Grid.Row="1" Background="{DynamicResource CardBg}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="8">
                                    <TextBox Text="{Binding ResolutionText, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                             FontSize="12.5" FontFamily="Segoe UI" Foreground="{DynamicResource TextPrimary}"
                                             CaretBrush="{DynamicResource TextPrimary}" VerticalScrollBarVisibility="Auto"
                                             Tag="Nhập phương án giải quyết đền bù hoặc lý do bác bỏ khiếu nại này..."/>
                                </Border>

                                <TextBlock Grid.Row="2" Text="* Thông tin này sẽ được gửi trực tiếp đến hộp thư của Người mua và Chủ shop."
                                           FontSize="10" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ── ROW 3: FOOTER ACTIONS ────────────────────────────────── -->
                    <Border Grid.Row="3" CornerRadius="0,0,16,16" BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderSlate}" Padding="32,16">
                        <Border.Background>
                            <SolidColorBrush Color="#0A0E1A" Opacity="0.5"/>
                        </Border.Background>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MÃ KHIẾU NẠI: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding SelectedComplaint.ComplaintId, StringFormat={}{0}}" FontSize="10.5" FontWeight="ExtraBold" Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI"/>
                            </StackPanel>

                            <!-- Actions when Pending -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- Dismiss Button -->
                                <Button Command="{Binding DismissComplaintCommand}" Background="{DynamicResource DangerRed}" BorderThickness="0"
                                        Height="38" Width="150" Cursor="Hand" Margin="0,0,12,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Bác bỏ khiếu nại" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Resolve Button -->
                                <Button Command="{Binding ResolveComplaintCommand}" Background="{DynamicResource SuccessGreen}" BorderThickness="0"
                                        Height="38" Width="190" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Chấp nhận &amp; Xử lý" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <!-- Read-only Resolution Info when already Resolved or Dismissed -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Resolved">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Dismissed">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="ĐÃ XỬ LÝ LÚC: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" FontFamily="Segoe UI"/>
                                <TextBlock Text="{Binding SelectedComplaint.ResolvedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
