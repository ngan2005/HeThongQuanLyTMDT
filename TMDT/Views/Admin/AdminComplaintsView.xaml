<UserControl x:Class="TMDT.Views.Admin.AdminComplaintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- Style tokens -->
        <SolidColorBrush x:Key="TextPrimary" Color="#121C2A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#593AD8"/>
        
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Command button styles -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <!-- Title & Search bar -->
            <RowDefinition Height="Auto"/>
            <!-- Action Filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area: Table + Detail Inspector -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TITLE & SEARCH ROW -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Giải quyết khiếu nại" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                <TextBlock Text="Phân xử tranh chấp, khiếu nại từ Người mua đối với các Shop và Đơn hàng trên hệ thống" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
            </StackPanel>

            <!-- Search box -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#DFE9FD" Height="38" Padding="12,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" 
                             VerticalAlignment="Center" FontSize="12.5" Padding="6,0,0,0" Margin="0" 
                             Tag="Tìm tên khách, nội dung..." FontFamily="Be Vietnam Pro, Segoe UI"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. FILTER STATUS BAR -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Tất cả khiếu nại" Style="{StaticResource FilterButton}" IsChecked="True" Command="{Binding FilterCommand}" CommandParameter="All" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Chờ giải quyết" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Pending" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Đã xử lý" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Resolved" FontSize="12.5" FontWeight="SemiBold"/>
                <RadioButton Content="Đã bác bỏ" Style="{StaticResource FilterButton}" Command="{Binding FilterCommand}" CommandParameter="Dismissed" FontSize="12.5" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <!-- 3. MAIN CONTENT: TABLE + INSPECTOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Complaints DataGrid -->
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <!-- Detail Inspector Card -->
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DataGrid List -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#2D3282" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>
                
                <DataGrid ItemsSource="{Binding Complaints}" SelectedItem="{Binding SelectedComplaint}" AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column" RowHeight="44" FontFamily="Be Vietnam Pro, Segoe UI">
                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Complaint ID -->
                        <DataGridTextColumn Header="MÃ KN" Binding="{Binding ComplaintId}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Buyer Name -->
                        <DataGridTextColumn Header="NGƯỜI KHIẾU NẠI" Binding="{Binding Buyer.FullName}" Width="1.2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Order ID -->
                        <DataGridTextColumn Header="MÃ ĐƠN" Binding="{Binding OrderId, StringFormat={}{0}}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrandPurple}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Content Summary -->
                        <DataGridTextColumn Header="NỘI DUNG KHIẾU NẠI" Binding="{Binding Content}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Date Submitted -->
                        <DataGridTextColumn Header="NGÀY GỬI" Binding="{Binding SubmittedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                        <Setter Property="Background" Value="#E6FDF4"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Text" Value="Đang xử lý"/>
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                            <Setter Property="Text" Value="Đã phân xử"/>
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Dismissed">
                                                            <Setter Property="Text" Value="Đã bác bỏ"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Complaint Detail Inspector Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#2D3282" BlurRadius="15" ShadowDepth="2" Opacity="0.02"/>
                </Border.Effect>

                <Grid>
                    <!-- Displayed only when a Complaint is selected -->
                    <Grid Visibility="{Binding SelectedComplaint, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header details -->
                            <RowDefinition Height="*"/>    <!-- Scrollable fields -->
                            <RowDefinition Height="Auto"/> <!-- Actions footer -->
                        </Grid.RowDefinitions>

                        <!-- Header Info -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                            <Border Width="60" Height="60" Background="#FEF2F2" CornerRadius="30" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE1A5;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedComplaint.Buyer.FullName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,12,0,4" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            
                            <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                <Setter Property="Background" Value="#FFF7ED"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Resolved">
                                                <Setter Property="Background" Value="#E6FDF4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Dismissed">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                    <Setter Property="Text" Value="ĐANG CHỜ PHÂN XỬ"/>
                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Resolved">
                                                    <Setter Property="Text" Value="ĐÃ GIẢI QUYẾT XONG"/>
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Dismissed">
                                                    <Setter Property="Text" Value="YÊU CẦU BỊ BÁC BỎ"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Detail Fields ScrollView -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Order Link info -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MÃ ĐƠN HÀNG" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedComplaint.OrderId, StringFormat={}{0}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrandPurple}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="GIÁ TRỊ ĐƠN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedComplaint.Order.TotalAmount, StringFormat={}{0:N0} đ}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Content details -->
                                <TextBlock Text="NỘI DUNG KHIẾU NẠI CHI TIẾT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="12" Margin="0,4,0,16" BorderThickness="1" BorderBrush="#FEE2E2">
                                    <TextBlock Text="{Binding SelectedComplaint.Content}" TextWrapping="Wrap" FontSize="12" Foreground="#991B1B" FontFamily="Be Vietnam Pro, Segoe UI" LineHeight="18"/>
                                </Border>

                                <!-- Resolution text area -->
                                <TextBlock Text="PHƯƠNG ÁN GIẢI QUYẾT &amp; LÝ DO BÁC BỎ" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <Border Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#DFE9FD" MinHeight="100" Margin="0,4,0,0" Padding="8">
                                    <TextBox Text="{Binding ResolutionText, UpdateSourceTrigger=PropertyChanged}" 
                                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                             FontSize="12" FontFamily="Be Vietnam Pro, Segoe UI"
                                             Tag="Nhập phương án giải quyết đền bù hoặc lý do bác bỏ khiếu nại này..."/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Action Buttons Footer -->
                        <StackPanel Grid.Row="2">
                            <!-- Resolve button (Visible only when pending) -->
                            <Button Content="Chấp nhận &amp; Xử lý khiếu nại" 
                                    Background="#10B981" Foreground="#FFFFFF"
                                    Command="{Binding ResolveComplaintCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Dismiss button (Visible only when pending) -->
                            <Button Content="Bác bỏ khiếu nại này" 
                                    Background="#EF4444" Foreground="#FFFFFF"
                                    Command="{Binding DismissComplaintCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedComplaint.Status}" Value="Pending">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Unselected state placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedComplaint}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </StackPanel.Style>
                        
                        <TextBlock Text="&#xE1A5;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#DFE9FD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Chọn một khiếu nại để tiến hành phân xử giải quyết" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextAlignment="Center" Width="180" TextWrapping="Wrap" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
