<Window x:Class="TMDT.Views.Admin.AdminMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Admin"
        xmlns:views="clr-namespace:TMDT.Views.Admin"
        xmlns:converters="clr-namespace:TMDT.Converters"
        mc:Ignorable="d"
        Title="Admin Portal | MyShop" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:AdminMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter for checking active menu -->
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>

        <!-- Mapping ViewModels to Views using DataTemplates -->
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminOrdersViewModel}">
            <views:AdminOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminShopsViewModel}">
            <views:AdminShopsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminProductsViewModel}">
            <views:AdminProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminWithdrawsViewModel}">
            <views:AdminWithdrawsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminComplaintsViewModel}">
            <views:AdminComplaintsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminMarketingViewModel}">
            <views:AdminMarketingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminCategoriesViewModel}">
            <views:AdminCategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminReportsViewModel}">
            <views:AdminReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminUsersViewModel}">
            <views:AdminUsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminSettingsViewModel}">
            <views:AdminSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminAuditLogsViewModel}">
            <views:AdminAuditLogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminProfileViewModel}">
            <views:AdminProfileView/>
        </DataTemplate>

        <!-- Modern Colors -->
        <SolidColorBrush x:Key="SidebarBg" Color="#131130"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#6366F1"/>
        <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgMain" Color="#FAF9FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSlate" Color="#E2E8F0"/>

        <!-- Sidebar RadioButton Style with Smooth Hover Translate & Glow Active Indicator -->
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarMenu"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Glow effect behind active item -->
                            <Border x:Name="glow" CornerRadius="8" Opacity="0" Background="#6366F1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#6366F1" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>

                            <!-- Background Highlight Border -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="translate" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- Indicator vertical stripe -->
                                    <Border x:Name="indicator" Width="3" Height="16" Background="#6366F1" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                                    
                                    <!-- Content Area -->
                                    <ContentPresenter x:Name="content" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Hover state: Translucent light background & Translate X -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.06"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Checked/Active state: Glow + Indicator + Solid Highlight -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.08"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.05"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle arrow button style -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25215A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Styles -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border Background="{StaticResource BgMain}" CornerRadius="16" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#2D3282" Direction="270" ShadowDepth="4" Opacity="0.08"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Sidebar -->
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <!-- Column 1: Main Content Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (DARK INDIGO THEME) -->
            <!-- ========================================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBg}" CornerRadius="15,0,0,15" Width="240" ClipToBounds="True">
                <Grid Margin="8,16">
                    <Grid.RowDefinitions>
                        <!-- Brand logo & System tag -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Admin Account Profile -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header with collapse toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock x:Name="BrandTitle" Text="MyShop" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            <TextBlock x:Name="BrandSubtitle" Text="HỆ THỐNG QUẢN TRỊ VIÊN" FontSize="9.5" FontWeight="Bold" Foreground="#818CF8" Margin="2,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>
                        <!-- Collapse/Expand toggle arrow -->
                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource SidebarToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Click="SidebarToggle_Click" ToolTip="Thu/Mở thanh điều hướng">
                            <TextBlock x:Name="ToggleArrow" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#818CF8"/>
                        </Button>
                    </Grid>

                    <!-- Navigation Menu -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Dashboard -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowDashboardCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                         ToolTip="Tổng quan Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="t0" Text="Tổng quan Dashboard" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Orders -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Orders, Mode=OneWay}"
                                         ToolTip="Quản lý Đơn hàng">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quản lý Đơn hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Shops -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowShopsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Shops, Mode=OneWay}"
                                         ToolTip="Duyệt cửa hàng">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Duyệt cửa hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Products -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProductsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Products, Mode=OneWay}"
                                         ToolTip="Duyệt sản phẩm">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Duyệt sản phẩm" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Withdraws -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowWithdrawsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Withdraws, Mode=OneWay}"
                                         ToolTip="Yêu cầu rút tiền">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yêu cầu rút tiền" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Complaints -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowComplaintsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Complaints, Mode=OneWay}"
                                         ToolTip="Giải quyết khiếu nại">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Giải quyết khiếu nại" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Marketing -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowMarketingCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Marketing, Mode=OneWay}"
                                         ToolTip="Kênh Marketing">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kênh Marketing" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Categories -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowCategoriesCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Categories, Mode=OneWay}"
                                         ToolTip="Quản lý Danh mục">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quản lý Danh mục" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Reports -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowReportsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Reports, Mode=OneWay}"
                                         ToolTip="Báo cáo &amp; Thống kê">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Báo cáo &amp; Thống kê" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Users -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowUsersCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Users, Mode=OneWay}"
                                         ToolTip="Quản lý Thành viên">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quản lý Thành viên" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Settings -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowSettingsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                         ToolTip="Cấu hình Hệ thống">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cấu hình Hệ thống" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- AuditLogs -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowAuditLogsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AuditLogs, Mode=OneWay}"
                                         ToolTip="Nhật ký Hoạt động">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nhật ký Hoạt động" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Profile Info -->
                    <Border Grid.Row="2" Background="#1B1938" CornerRadius="10" Padding="12" Opacity="0.95" BorderThickness="1" BorderBrush="#0DFFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Clickable Profile Area -->
                            <Button Grid.Column="0" Command="{Binding ShowProfileCommand}" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Cursor="Hand" ToolTip="Xem thông tin cá nhân">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Avatar Circle -->
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandPurple}">
                                                    <TextBlock Text="A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </Border>

                                                <!-- Admin details (hidden when collapsed) -->
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </StackPanel.Style>
                                                     <TextBlock Text="{Binding AdminName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                     <TextBlock Text="Quản trị tối cao" FontSize="10.5" Foreground="#A5B4FC" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>
                                     </ControlTemplate>
                                 </Button.Template>
                             </Button>

                             <!-- Logout button -->
                             <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logout_Click" ToolTip="Đăng xuất" Margin="8,0,0,0">
                                 <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                             </Button>
                         </Grid>
                     </Border>
                 </Grid>
             </Border>

             <!-- ========================================== -->
             <!-- COLUMN 1: MAIN WORKSPACE (LIGHT CLEAN THEME) -->
             <!-- ========================================== -->
             <Grid Grid.Column="1" Margin="24,0,24,24">
                 <Grid.RowDefinitions>
                     <!-- Top Window controls Header -->
                     <RowDefinition Height="64"/>
                     <!-- Dynamic Body Workspace -->
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

                 <!-- TOP BAR HEADER -->
                 <Grid Grid.Row="0">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>

                     <!-- Subtitle status / Search bar placeholder -->
                     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                         <TextBlock Text="Cổng quản trị" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                         <TextBlock Text=" / " FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                         <TextBlock Text="{Binding ActiveMenu}" FontSize="11.5" Foreground="{StaticResource BrandPurple}" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                     </StackPanel>

                     <!-- Top Window action controls -->
                     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                         <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0">
                             <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                         </Button>
                         <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click">
                             <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                         </Button>
                     </StackPanel>
                 </Grid>

                 <!-- DYNAMIC CONTENT BODY -->
                 <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
             </Grid>
         </Grid>
     </Grid>
 </Window>
