<Window x:Class="TMDT.Views.Admin.AdminMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Admin"
        xmlns:views="clr-namespace:TMDT.Views.Admin"
        xmlns:converters="clr-namespace:TMDT.Converters"
        mc:Ignorable="d"
        Title="Admin Portal | Volox" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:AdminMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter for checking active menu -->
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Mapping ViewModels to Views using DataTemplates -->
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminOrdersViewModel}">
            <views:AdminOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminShopsViewModel}">
            <views:AdminShopsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminProductsViewModel}">
            <views:AdminProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminWithdrawsViewModel}">
            <views:AdminWithdrawsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminComplaintsViewModel}">
            <views:AdminComplaintsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminMarketingViewModel}">
            <views:AdminMarketingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminCategoriesViewModel}">
            <views:AdminCategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminReportsViewModel}">
            <views:AdminReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminUsersViewModel}">
            <views:AdminUsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminSettingsViewModel}">
            <views:AdminSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminAuditLogsViewModel}">
            <views:AdminAuditLogsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminProfileViewModel}">
            <views:AdminProfileView/>
        </DataTemplate>

        <!-- ⚠️ Colors are defined in AdminDarkTheme.xaml / AdminLightTheme.xaml — do NOT hardcode here -->

        <!-- Sidebar RadioButton Style — LogisticsPro Warm MD3 Light Sidebar -->
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarMenu"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <!-- Background Highlight Border -->
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="translate" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- Active indicator stripe: brand blue -->
                                    <Border x:Name="indicator" Width="3" Height="16" Background="{DynamicResource BrandPurple}" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                                    <!-- Content Area -->
                                    <ContentPresenter x:Name="content" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Hover: soft warm tint -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Active: blue pill + indicator -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarActiveBg}"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource SidebarActiveText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Expander Category Style -->
        <Style x:Key="SidebarCategoryHeader" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextDefault}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0" Height="40">
                            <Border.RenderTransform><TranslateTransform x:Name="tr" X="0"/></Border.RenderTransform>
                            <Grid>
                                <ContentPresenter Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock x:Name="chevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SidebarTextDefault}" Margin="0,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chevron" Property="Text" Value="&#xE70E;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle arrow button style -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Styles -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DangerRedBg}"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border x:Name="MainBorder" Background="{DynamicResource BgMain}" CornerRadius="16" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#2B1B69" Direction="270" ShadowDepth="4" Opacity="0.10"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Sidebar -->
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <!-- Column 1: Main Content Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (DARK INDIGO THEME) -->
            <!-- ========================================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderSlate}" BorderThickness="0,0,1,0" CornerRadius="15,0,0,15" Width="240" ClipToBounds="True">
                <Grid Margin="8,16">
                    <Grid.RowDefinitions>
                        <!-- Brand logo & System tag -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Admin Account Profile -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header with collapse toggle -->
                    <Grid Grid.Row="0" Margin="0,16,0,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="BrandLogo" Source="pack://application:,,,/Resources/Images/logo.png" Height="120" Width="220" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,-25,0,-20" />
                            <TextBlock x:Name="BrandSubtitle" Text="HỆ THỐNG QUẢN TRỊ VIÊN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" Margin="0,0,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>
                        <!-- Collapse/Expand toggle arrow -->
                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource SidebarToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Click="SidebarToggle_Click" ToolTip="Thu/Mở thanh điều hướng">
                            <TextBlock x:Name="ToggleArrow" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}"/>
                        </Button>
                    </Grid>

                    <!-- Navigation Menu -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Dashboard -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowDashboardCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                         ToolTip="Tổng quan Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="t0" Text="Tổng quan Dashboard" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Orders Accordion Menu -->
                            <StackPanel Margin="0,2">
                                <CheckBox x:Name="OrdersExpander" Style="{StaticResource SidebarCategoryHeader}" IsChecked="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quản lý Đơn hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=OrdersExpander, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,0">
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Orders, Mode=OneWay}" ToolTip="Tất cả đơn hàng" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tất cả đơn hàng" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersPendingCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=OrdersPending, Mode=OneWay}" ToolTip="Chờ xác nhận" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chờ xác nhận" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersShippingCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=OrdersShipping, Mode=OneWay}" ToolTip="Đang giao hàng" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE8F3;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đang giao hàng" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersRefundCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=OrdersRefund, Mode=OneWay}" ToolTip="Hoàn tiền / Trả hàng" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Hoàn tiền / Trả hàng" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Shops Accordion Menu -->
                            <StackPanel Margin="0,2">
                                <CheckBox x:Name="ShopsExpander" Style="{StaticResource SidebarCategoryHeader}" IsChecked="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Duyệt cửa hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ShopsExpander, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,0">
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowShopsCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Shops, Mode=OneWay}" ToolTip="Tất cả cửa hàng" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tất cả cửa hàng" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowShopsPendingCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ShopsPending, Mode=OneWay}" ToolTip="Chờ duyệt" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Chờ duyệt" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowShopsActiveCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ShopsActive, Mode=OneWay}" ToolTip="Đang hoạt động" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE8F3;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Đang hoạt động" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowShopsSuspendedCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ShopsSuspended, Mode=OneWay}" ToolTip="Tạm khóa / Vi phạm" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Tạm khóa / Vi phạm" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Products Accordion Menu -->
                            <StackPanel Margin="0,2">
                                <CheckBox x:Name="ProductsExpander" Style="{StaticResource SidebarCategoryHeader}" IsChecked="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Duyệt sản phẩm" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=ProductsExpander, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,0">
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProductsPendingCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ProductsPending, Mode=OneWay}" ToolTip="Sản phẩm chờ duyệt" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Sản phẩm chờ duyệt" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProductsActiveCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ProductsActive, Mode=OneWay}" ToolTip="Sản phẩm đang bán" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Sản phẩm đang bán" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProductsReviewsCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ProductsReviews, Mode=OneWay}" ToolTip="Quản lý đánh giá" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE8F3;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quản lý đánh giá" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Withdraws -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowWithdrawsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Withdraws, Mode=OneWay}"
                                         ToolTip="Yêu cầu rút tiền">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yêu cầu rút tiền" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Complaints -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowComplaintsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Complaints, Mode=OneWay}"
                                         ToolTip="Giải quyết khiếu nại">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Giải quyết khiếu nại" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Marketing Accordion Menu -->
                            <StackPanel Margin="0,2">
                                <CheckBox x:Name="MarketingExpander" Style="{StaticResource SidebarCategoryHeader}" IsChecked="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kênh Marketing" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=MarketingExpander, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,0">
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowMarketingBannersCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=MarketingBanners, Mode=OneWay}" ToolTip="Quản lý Banner" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quản lý Banner" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowMarketingVouchersCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=MarketingVouchers, Mode=OneWay}" ToolTip="Quản lý Voucher sàn" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quản lý Voucher sàn" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowMarketingFlashSalesCommand}" IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=MarketingFlashSales, Mode=OneWay}" ToolTip="Quản lý Flash Sale" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quản lý Flash Sale" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Categories -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowCategoriesCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Categories, Mode=OneWay}"
                                         ToolTip="Quản lý Danh mục">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Quản lý Danh mục" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Reports -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowReportsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Reports, Mode=OneWay}"
                                         ToolTip="Báo cáo &amp; Thống kê">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Báo cáo &amp; Thống kê" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Users Accordion Menu -->
                            <StackPanel Margin="0,2">
                                <!-- Parent: Quản lý Thành viên -->
                                <CheckBox x:Name="UsersExpander"
                                          Style="{StaticResource SidebarCategoryHeader}"
                                          IsChecked="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quản lý Thành viên" FontSize="12.5" FontWeight="Medium"
                                                   FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </CheckBox>

                                <!-- Sub-items (visible when expanded) -->
                                <StackPanel Visibility="{Binding IsChecked, ElementName=UsersExpander, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,0">

                                    <!-- Admin -->
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowAdminsCommand}"
                                                 IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Admins, Mode=OneWay}"
                                                 ToolTip="Quản lý Admin" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE971;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Quản lý Admin" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Nhà kinh doanh -->
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowSellersCommand}"
                                                 IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Sellers, Mode=OneWay}"
                                                 ToolTip="Nhà kinh doanh" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE8F9;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Nhà kinh doanh" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Khách hàng -->
                                    <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowBuyersCommand}"
                                                 IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Buyers, Mode=OneWay}"
                                                 ToolTip="Khách hàng" Margin="0,1">
                                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{DynamicResource BrandPurple}" Width="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khách hàng" FontSize="11.5" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                </StackPanel>
                            </StackPanel>

                            <!-- Settings -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowSettingsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                         ToolTip="Cấu hình Hệ thống">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cấu hình Hệ thống" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- AuditLogs -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowAuditLogsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=AuditLogs, Mode=OneWay}"
                                         ToolTip="Nhật ký Hoạt động">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrandPurple}" Width="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nhật ký Hoạt động" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Profile Info -->
                    <Border Grid.Row="2" Background="{DynamicResource SidebarHoverBg}" CornerRadius="10" Padding="12" Opacity="0.95" BorderThickness="1" BorderBrush="{DynamicResource SidebarBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Clickable Profile Area -->
                            <Button Grid.Column="0" Command="{Binding ShowProfileCommand}" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Cursor="Hand" ToolTip="Xem thông tin cá nhân">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Avatar Circle — hiển thị ảnh thật hoặc fallback chữ cái -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{DynamicResource BrandActiveBg}"
                                                        BorderThickness="2" BorderBrush="{DynamicResource BrandPurple}">
                                                    <Grid>
                                                        <!-- Ảnh đại diện thật (hiện khi có avatar) -->
                                                        <Ellipse Width="32" Height="32">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding DataContext.AdminAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Base64ToImageConverter}}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.AdminAvatar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StringNullOrEmptyToBool}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>

                                                        <!-- Fallback: chữ cái đầu của tên (hiện khi chưa có avatar) -->
                                                        <TextBlock Text="{Binding DataContext.AdminName,
                                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                                          Converter={StaticResource InitialLetterConverter}}"
                                                                   Foreground="{DynamicResource BrandPurple}"
                                                                   FontWeight="Bold" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontFamily="Be Vietnam Pro, Segoe UI">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.AdminAvatar,
                                                                                              RelativeSource={RelativeSource AncestorType=Window},
                                                                                              Converter={StaticResource StringNullOrEmptyToBool}}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>

                                                <!-- Admin details (hidden when collapsed) -->
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                         </Style>
                                                     </StackPanel.Style>
                                                     <TextBlock Text="{Binding AdminName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                     <TextBlock Text="Quản trị tối cao" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>
                                     </ControlTemplate>
                                 </Button.Template>
                             </Button>

                             <!-- Logout button -->
                             <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logout_Click" ToolTip="Đăng xuất" Margin="8,0,0,0">
                                 <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource DangerRed}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                             </Button>
                         </Grid>
                     </Border>
                 </Grid>
             </Border>

             <!-- ========================================== -->
             <!-- COLUMN 1: MAIN WORKSPACE (LIGHT CLEAN THEME) -->
             <!-- ========================================== -->
             <Grid Grid.Column="1" Margin="24,0,24,24">
                 <Grid.RowDefinitions>
                     <!-- Top Window controls Header -->
                     <RowDefinition Height="64"/>
                     <!-- Dynamic Body Workspace -->
                     <RowDefinition Height="*"/>
                 </Grid.RowDefinitions>

                 <!-- TOP BAR HEADER -->
                 <Grid Grid.Row="0">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>

                     <!-- Subtitle status / Search bar placeholder -->
                     <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                         <TextBlock Text="Cổng quản trị" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" FontWeight="SemiBold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                         <TextBlock Text=" / " FontSize="11.5" Foreground="{DynamicResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                         <TextBlock Text="{Binding ActiveMenu}" FontSize="11.5" Foreground="{DynamicResource BrandPurple}" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                     </StackPanel>

                     <!-- Top Window action controls -->
                     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                         <!-- ☀️/🌙 Theme Toggle Button -->
                         <Button x:Name="ThemeToggleBtn"
                                 Click="ThemeToggle_Click"
                                 Margin="0,0,6,0"
                                 ToolTip="Chuyển chế độ Sáng / Tối"
                                 Cursor="Hand"
                                 Width="32" Height="32"
                                 BorderThickness="0">
                             <Button.Template>
                                 <ControlTemplate TargetType="Button">
                                     <Border x:Name="toggleBd"
                                             Background="Transparent"
                                             CornerRadius="8"
                                             BorderThickness="1"
                                             BorderBrush="{DynamicResource BorderSlate}">
                                         <TextBlock x:Name="ThemeIcon"
                                                    Text="&#xE708;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="13"
                                                    Foreground="{DynamicResource BrandPurple}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                     </Border>
                                     <ControlTemplate.Triggers>
                                         <Trigger Property="IsMouseOver" Value="True">
                                             <Setter TargetName="toggleBd" Property="Background" Value="{DynamicResource BrandActiveBg}"/>
                                             <Setter TargetName="toggleBd" Property="BorderBrush" Value="{DynamicResource BrandPurple}"/>
                                         </Trigger>
                                     </ControlTemplate.Triggers>
                                 </ControlTemplate>
                             </Button.Template>
                         </Button>

                         <!-- Divider -->
                         <Border Width="1" Height="16" Background="{DynamicResource BorderSlate}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                         <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0" ToolTip="Thu nhỏ">
                             <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                         </Button>
                         <Button x:Name="MaximizeButton" Style="{StaticResource WindowNavButton}" Click="MaximizeButton_Click" Margin="0,0,4,0" ToolTip="Phóng to">
                             <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                         </Button>
                         <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click" ToolTip="Đóng">
                             <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                         </Button>
                     </StackPanel>
                 </Grid>

                 <!-- DYNAMIC CONTENT BODY -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
        
        <!-- FLOATING CHAT WIDGET -->
        <views:AdminChatWidget DataContext="{Binding ChatViewModel}"/>
    </Grid>
</Window>
