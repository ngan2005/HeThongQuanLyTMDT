<Window x:Class="TMDT.Views.Admin.AdminMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Admin"
        xmlns:views="clr-namespace:TMDT.Views.Admin"
        mc:Ignorable="d"
        Title="Admin Portal | MyShop" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:AdminMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Mapping ViewModels to Views using DataTemplates -->
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminShopsViewModel}">
            <views:AdminShopsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminProductsViewModel}">
            <views:AdminProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminWithdrawsViewModel}">
            <views:AdminWithdrawsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminComplaintsViewModel}">
            <views:AdminComplaintsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminMarketingViewModel}">
            <views:AdminMarketingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminCategoriesViewModel}">
            <views:AdminCategoriesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminReportsViewModel}">
            <views:AdminReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminUsersViewModel}">
            <views:AdminUsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminSettingsViewModel}">
            <views:AdminSettingsView/>
        </DataTemplate>

        <!-- Modern Colors -->
        <SolidColorBrush x:Key="SidebarBg" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="SidebarHover" Color="#312E81"/>
        <SolidColorBrush x:Key="SidebarActive" Color="#4338CA"/>
        <SolidColorBrush x:Key="BrandPurple" Color="#593AD8"/>
        
        <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgMain" Color="#F8F9FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#121C2A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSlate" Color="#F1F5F9"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C7D2FE"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter x:Name="iconPresenter" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Styles -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border Background="{StaticResource BgMain}" CornerRadius="16" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#2D3282" Direction="270" ShadowDepth="4" Opacity="0.08"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Sidebar -->
                <ColumnDefinition Width="240"/>
                <!-- Column 1: Main Content Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (DARK INDIGO THEME) -->
            <!-- ========================================== -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}" CornerRadius="15,0,0,15">
                <Grid Margin="16,24">
                    <Grid.RowDefinitions>
                        <!-- Brand logo & System tag -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Admin Account Profile -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Margin="8,0,0,32">
                        <TextBlock Text="MyShop" FontSize="22" FontWeight="ExtraBold" Foreground="#FFFFFF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text="HỆ THỐNG QUẢN TRỊ VIÊN" FontSize="9.5" FontWeight="Bold" Foreground="#818CF8" Margin="2,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1">
                        <!-- Dashboard Button -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Tổng quan Dashboard" Command="{Binding ShowDashboardCommand}">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Moderation: Shop -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Duyệt cửa hàng" Command="{Binding ShowShopsCommand}">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Moderation: Product -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Duyệt sản phẩm" Command="{Binding ShowProductsCommand}">
                            <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Financial: Withdraw -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Yêu cầu rút tiền" Command="{Binding ShowWithdrawsCommand}">
                            <TextBlock Text="&#xEDF4;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Customer Support: Complaint -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Giải quyết khiếu nại" Command="{Binding ShowComplaintsCommand}">
                            <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Marketing & Promotions -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Kênh Marketing" Command="{Binding ShowMarketingCommand}">
                            <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Catalog: Categories -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Quản lý Danh mục" Command="{Binding ShowCategoriesCommand}">
                            <TextBlock Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Reporting: Analytics Reports -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Báo cáo &amp; Thống kê" Command="{Binding ShowReportsCommand}">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Member: User Management -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Quản lý Thành viên" Command="{Binding ShowUsersCommand}">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Config: System Settings -->
                        <Button Style="{StaticResource SidebarButton}" Tag="Cấu hình Hệ thống" Command="{Binding ShowSettingsCommand}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Profile Info -->
                    <Border Grid.Row="2" Background="#1E1A5A" CornerRadius="10" Padding="12" Opacity="0.95">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Avatar Circle -->
                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandPurple}">
                                <TextBlock Text="A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </Border>

                            <!-- Admin details -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdminName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                <TextBlock Text="Quản trị tối cao" FontSize="10.5" Foreground="#A5B4FC" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </StackPanel>

                            <!-- Logout button -->
                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logout_Click" ToolTip="Đăng xuất">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- COLUMN 1: MAIN WORKSPACE (LIGHT CLEAN THEME) -->
            <!-- ========================================== -->
            <Grid Grid.Column="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <!-- Top Window controls Header -->
                    <RowDefinition Height="64"/>
                    <!-- Dynamic Body Workspace -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Subtitle status / Search bar placeholder -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Cổng quản trị" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text=" / " FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text="{Binding ActiveMenu}" FontSize="11.5" Foreground="{StaticResource BrandPurple}" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>

                    <!-- Top Window action controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- DYNAMIC CONTENT BODY -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
