<UserControl x:Class="TMDT.Views.Admin.AdminProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Admin"
             xmlns:helpers="clr-namespace:TMDT.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#000" Direction="270"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. TITLE ROW -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Thông tin tài khoản" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                    <TextBlock Text="Quản lý hồ sơ cá nhân, cập nhật ảnh đại diện và thiết lập bảo mật mật khẩu" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                </StackPanel>
            </Grid>

            <!-- 2. CONTENT CARDS (Bento Grid) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT COLUMN: BENTO PROFILE CARD ================= -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24" VerticalAlignment="Top" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- Avatar Section with Glow & Hover Effects -->
                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <!-- Glow Outer Ring -->
                            <Ellipse Stroke="{DynamicResource BrandPurple}" StrokeThickness="2" Margin="-4">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource BrandPurple.Color}" BlurRadius="8" Opacity="0.4" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            
                            <!-- Inner Avatar Background -->
                            <Ellipse Fill="{DynamicResource SurfaceMid}"/>
                            
                            <!-- Avatar Image (Clipped) -->
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                                </Grid.Clip>
                                <Image Source="{Binding Avatar, Converter={StaticResource Base64ToImageConverter}}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}, ConverterParameter=Inverse}"/>
                            </Grid>
                            
                            <!-- Placeholder Letter when No Avatar -->
                            <TextBlock Text="A" FontSize="44" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPurple}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}}"/>

                            <!-- Uploading / Processing overlay -->
                            <Border Background="#A0000000" CornerRadius="60" Visibility="{Binding IsUploadingAvatar, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Ellipse Width="24" Height="24" Stroke="White" StrokeThickness="2" StrokeDashArray="3 1.5" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                            </Border>

                            <!-- Camera overlay upload button -->
                            <Button Command="{Binding ChangeAvatarCommand}"
                                    Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Cursor="Hand" ToolTip="Đổi ảnh đại diện">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{DynamicResource BrandPurple}" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource CardBg}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
                                            </Border.Effect>
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,20,0,6" FontFamily="Segoe UI" TextAlignment="Center"/>
                        
                        <!-- Role Badge -->
                        <Border BorderBrush="{DynamicResource BrandPurple}" BorderThickness="1" Background="Transparent" CornerRadius="12" Padding="12,3" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock Text="{Binding Role}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrandPurple}" FontFamily="Segoe UI"/>
                        </Border>

                        <Border Height="1" Background="{DynamicResource BorderSlate}" Margin="0,0,0,20" Opacity="0.5"/>

                        <!-- Details Rows with premium Icons -->
                        <StackPanel Margin="0,0,0,10">
                            <!-- Row 1: Email -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource SurfaceLow}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Email đăng nhập" FontSize="10" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Email}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Phone -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource SurfaceLow}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Số điện thoại" FontSize="10" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Join Date -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="28" Height="28" Background="{DynamicResource SurfaceLow}" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource BrandPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Ngày tham gia" FontSize="10" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Text="{Binding JoinedDateText}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= RIGHT COLUMN: EDIT FORMS ================= -->
                <StackPanel Grid.Column="2">
                    <!-- Form 1: Edit Profile -->
                    <Border Background="{DynamicResource CardBg}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24" Margin="0,0,0,20" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Chỉnh sửa thông tin cá nhân" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" Margin="0,0,0,18"/>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Email liên hệ (Không thể thay đổi)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Border Background="{DynamicResource SurfaceMid}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0" Opacity="0.7">
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" CaretBrush="{DynamicResource TextSecondary}" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>

                            <!-- Save changes Button -->
                            <Button Command="{Binding SaveProfileCommand}" HorizontalAlignment="Right" Width="150" Height="38" Background="{DynamicResource BrandPurple}" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Lưu thay đổi" FontSize="12.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Form 2: Change Password -->
                    <Border Background="{DynamicResource CardBg}" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24" Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="Thiết lập mật khẩu mới" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" Margin="0,0,0,18"/>
                            
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Mật khẩu hiện tại" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0">
                                    <PasswordBox x:Name="TxtCurrentPassword"
                                                 helpers:PasswordBoxHelper.BindPassword="True"
                                                 helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>

                             <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu mới" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0">
                                        <PasswordBox x:Name="TxtNewPassword"
                                                     helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Xác nhận mật khẩu mới" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" FontFamily="Segoe UI"/>
                                    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Height="40" Padding="12,0">
                                        <PasswordBox x:Name="TxtConfirmNewPassword"
                                                     helpers:PasswordBoxHelper.BindPassword="True"
                                                     helpers:PasswordBoxHelper.BoundPassword="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}" FontFamily="Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Update Password Button -->
                            <Button Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Right" Width="150" Height="38" Background="{DynamicResource BrandPurple}" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="11.5" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Đổi mật khẩu" FontSize="12.5" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
