<UserControl x:Class="TMDT.Views.Admin.AdminProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="880">

    <UserControl.Resources>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. TITLE ROW -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Thông tin Tài khoản" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Quản lý thông tin cá nhân và bảo mật của tài khoản quản trị" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Grid>

            <!-- 2. CONTENT CARDS -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Profile Card -->
                <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24" VerticalAlignment="Top">
                    <Border.Effect><DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.03"/></Border.Effect>
                    <StackPanel>
                        <!-- Avatar: circular with base64 image or letter placeholder -->
                        <Grid Width="100" Height="100" HorizontalAlignment="Center">
                            <!-- Background circle -->
                            <Ellipse Fill="{DynamicResource BrandActiveBg}"/>
                            <!-- Avatar image (clipped to circle) -->
                            <Grid>
                                <Grid.Clip>
                                    <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                                </Grid.Clip>
                                <Image Source="{Binding Avatar, Converter={StaticResource Base64ToImageConverter}}"
                                       Stretch="UniformToFill"
                                       Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}, ConverterParameter=Inverse}"/>
                            </Grid>
                            <!-- Placeholder letter -->
                            <TextBlock Text="A" FontSize="40" FontWeight="Bold"
                                       Foreground="{DynamicResource BrandPurple}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Be Vietnam Pro, Segoe UI"
                                       Visibility="{Binding Avatar, Converter={StaticResource StringNullOrEmptyToBool}}"/>

                            <!-- Camera overlay button -->
                            <Button Command="{Binding ChangeAvatarCommand}"
                                    Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Cursor="Hand" ToolTip="Đổi ảnh đại diện">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{DynamicResource BrandPurple}" CornerRadius="14">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                                            </Border.Effect>
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        
                        <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,16,0,4" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <Border Background="#E0E7FF" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandPurple}"/>
                        </Border>

                        <Rectangle Height="1" Fill="#F1F5F9" Margin="0,8,0,16"/>

                        <!-- Details -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Email}" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Số điện thoại" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Ngày tham gia" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding JoinedDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="13" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Edit Forms -->
                <StackPanel Grid.Column="2">
                    <!-- Form 1: Edit Profile -->
                    <Border Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24" Margin="0,0,0,24">
                        <Border.Effect><DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.03"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Chỉnh sửa thông tin" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,16"/>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Số điện thoại" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="Email liên hệ (Được dùng để đăng nhập)" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                            </StackPanel>

                            <Button Command="{Binding SaveProfileCommand}" HorizontalAlignment="Right" Width="140" Height="40" Background="{StaticResource BrandPurple}" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <TextBlock Text="Lưu thay đổi" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#4C30BA"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Form 2: Change Password -->
                    <Border Background="{DynamicResource CardBg}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderSlate}" Padding="24">
                        <Border.Effect><DropShadowEffect Color="#1C1B1A" BlurRadius="15" ShadowDepth="2" Opacity="0.03"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Đổi mật khẩu" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,16"/>
                            
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Mật khẩu hiện tại" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                    <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mật khẩu mới" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Xác nhận mật khẩu mới" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Height="40" Padding="12,0">
                                        <TextBox Text="{Binding ConfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Button Command="{Binding ChangePasswordCommand}" HorizontalAlignment="Right" Width="140" Height="40" Background="#F1F5F9" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <TextBlock Text="Cập nhật mật khẩu" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderSlate}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>




