<Window x:Class="TMDT.Views.Components.VNPayMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán VNPAY (Mô phỏng)" Height="640" Width="430"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">

            <!-- VNPay Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Border Background="#005A9C" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                    <TextBlock Text="VN" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </Border>
                <Border Background="#D71921" CornerRadius="4" Padding="8,4">
                    <TextBlock Text="PAY" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Quét mã QR để thanh toán" FontSize="13" Foreground="#444" HorizontalAlignment="Center" Margin="0,4,0,16"/>

            <!-- QR Code Image (generated in code-behind) -->
            <Border Width="210" Height="210" Background="White" BorderBrush="#005A9C" BorderThickness="3"
                    CornerRadius="10" Margin="0,0,0,12" Padding="8">
                <Grid>
                    <!-- Placeholder khi chưa generate xong -->
                    <TextBlock x:Name="txtQrPlaceholder" Text="⏳" FontSize="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                    <!-- QR Code thực tế -->
                    <Image x:Name="imgQrCode" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 🟢 Cảnh báo khi chưa có QR upload — chỉ hiện khi code-behind bật Visibility -->
            <Border x:Name="txtWarning" Background="#FFF4E5" BorderBrush="#E0A75E" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="txtWarningText" FontSize="11" Foreground="#7A4F0A"
                           TextWrapping="Wrap" LineHeight="16" HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="26" FontWeight="Bold"
                       Foreground="#111111" HorizontalAlignment="Center" Margin="0,4,0,6"/>
            <TextBlock x:Name="txtOrderCode" Text="" FontSize="12" Foreground="#005A9C"
                       HorizontalAlignment="Center" Margin="0,0,0,4" FontWeight="SemiBold"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="txtBankInfo" Text="MB Bank · 0123456789 · NGUYEN VAN A"
                       FontSize="11" Foreground="#666" HorizontalAlignment="Center"
                       Margin="0,0,0,18" FontStyle="Italic"/>

            <!-- Confirm Button -->
            <Button x:Name="BtnConfirm" Content="✅  XÁC NHẬN ĐÃ CHUYỂN KHOẢN" Background="#005A9C" Foreground="White"
                    FontWeight="Bold" FontSize="13" Height="46" Width="270" Click="BtnConfirm_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Hủy giao dịch" Background="Transparent" Foreground="Gray"
                    FontSize="12" BorderThickness="0" Margin="0,12,0,0" Click="BtnCancel_Click"/>

            <!-- Sửa đơn -->
            <Button Content="✎  SỬA ĐƠN (quay lại POS)" Background="Transparent" Foreground="#005A9C"
                    FontSize="12" FontWeight="SemiBold" BorderThickness="0" Margin="0,6,0,0"
                    Click="BtnEditOrder_Click" Cursor="Hand"/>

            <!-- Offline -->
            <Button Content="🔌  Đã nhận tiền (offline - sync sau)" Background="Transparent" Foreground="#0D9488"
                    FontSize="12" FontWeight="SemiBold" BorderThickness="0" Margin="0,4,0,0"
                    Click="BtnOfflineConfirm_Click" Cursor="Hand"
                    ToolTip="Khách đã chuyển nhưng POS không kết nối được server — lưu offline và đồng bộ sau"/>

            <TextBlock Text="Môi trường thử nghiệm — chỉ dùng khi đã upload ảnh QR từ app ngân hàng" FontSize="10" Foreground="#CCC"
                       HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
