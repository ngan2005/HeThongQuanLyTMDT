<Window x:Class="TMDT.Views.Components.VNPayMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán VNPAY (Mô phỏng)" Height="550" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="12" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- VNPay Header -->
            <TextBlock Text="VNPAY PAYMENT" FontSize="22" FontWeight="Bold" Foreground="#005A9C" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Môi trường thử nghiệm (Đồ án)" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <!-- Fake QR Code Box -->
            <Border Width="200" Height="200" Background="White" BorderBrush="#005A9C" BorderThickness="2" CornerRadius="10" Margin="0,0,0,20">
                <Grid>
                    <TextBlock Text="📱" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
                    <TextBlock Text="Quét mã QR bằng VNPAY" FontSize="14" Foreground="#005A9C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <TextBlock Text="Số tiền thanh toán:" FontSize="14" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="24" FontWeight="Bold" Foreground="#111111" HorizontalAlignment="Center" Margin="0,5,0,30"/>

            <Button Content="XÁC NHẬN ĐÃ CHUYỂN KHOẢN" Background="#005A9C" Foreground="White" FontWeight="Bold" FontSize="14" Height="45" Width="250" Click="BtnConfirm_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <Button Content="Hủy giao dịch" Background="Transparent" Foreground="Gray" FontSize="13" BorderThickness="0" Margin="0,15,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Border>
</Window>
