<UserControl x:Class="TMDT.Views.Components.BuyerFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignWidth="1920"
             Background="{StaticResource BackgroundBrush}">
    <Border Padding="40,60" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Col 1: Volox info -->
                <StackPanel Grid.Column="0" Margin="0,0,40,0">
                    <TextBlock Text="Volox" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,15"/>
                    <TextBlock Text="Nền tảng mua sắm trực tuyến hàng đầu, mang đến những sản phẩm chất lượng nhất cho cuộc sống của bạn." 
                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" LineHeight="24" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Background="White" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Facebook" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Background="White" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Instagram" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Background="White" Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Youtube" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Col 2: Thông tin -->
                <StackPanel Grid.Column="1" Margin="20,0">
                    <TextBlock Text="THÔNG TIN" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Về chúng tôi" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Hệ thống cửa hàng" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Tuyển dụng" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Liên hệ" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                </StackPanel>

                <!-- Col 3: Hỗ trợ khách hàng -->
                <StackPanel Grid.Column="2" Margin="20,0">
                    <TextBlock Text="HỖ TRỢ KHÁCH HÀNG" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Chính sách bảo mật" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Điều khoản dịch vụ" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Trung tâm trợ giúp" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Chính sách vận chuyển" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5" Padding="0"/>
                </StackPanel>

                <!-- Col 4: Đăng ký nhận tin -->
                <StackPanel Grid.Column="3" Margin="20,0,0,0">
                    <TextBlock Text="ĐĂNG KÝ NHẬN TIN" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                    <TextBlock Text="Nhận thông báo về các chương trình khuyến mãi mới nhất từ Volox." 
                               TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource SearchBoxStyle}" Width="Auto" Margin="0,0,10,0" Padding="10" materialDesign:HintAssist.Hint="Email của bạn" />
                        <Button Grid.Column="1" Style="{StaticResource ModernButtonStyle}" Content="GỬI" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Bottom border -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,40,0,0" Padding="0,30,0,0">
                <Grid>
                    <TextBlock Text="© 2024 Volox Vietnam. Mua sắm thông minh." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Chấp nhận thanh toán: " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <materialDesign:PackIcon Kind="CashMultiple" Foreground="{StaticResource TextMutedBrush}" Width="24" Height="24" Margin="5,0"/>
                        <materialDesign:PackIcon Kind="CreditCardOutline" Foreground="{StaticResource TextMutedBrush}" Width="24" Height="24" Margin="5,0"/>
                        <materialDesign:PackIcon Kind="BankOutline" Foreground="{StaticResource TextMutedBrush}" Width="24" Height="24" Margin="5,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
