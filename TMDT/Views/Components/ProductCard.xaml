<UserControl x:Class="TMDT.Views.Components.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="220"
             TextElement.FontFamily="Segoe UI, sans-serif">
    
    <UserControl.Resources>
    <!-- Color Brushes -->
    <SolidColorBrush x:Key="Primary" Color="#5221E7"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextMain" Color="#1A1B22"/>
    <SolidColorBrush x:Key="TextMuted" Color="#797588"/>
    <SolidColorBrush x:Key="Error" Color="#BA1A1A"/>
    <SolidColorBrush x:Key="Warning" Color="#FFB300"/>

    <!-- Image style: keep max size, uniform stretch, subtle shadow -->
    <Style x:Key="ProductImageStyle" TargetType="Image">
        <Setter Property="MaxWidth" Value="180"/>
        <Setter Property="MaxHeight" Value="180"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="6" Opacity="0.2" ShadowDepth="2"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card container style -->
    <Style x:Key="CardContainer" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
</UserControl.Resources>

    <Border Style="{StaticResource CardContainer}" CornerRadius="16" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="CardBorder_MouseLeftButtonUp" Cursor="Hand" x:Name="CardBorder">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1" />
                <TranslateTransform X="0" Y="0" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-4" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <!-- Thêm bóng đổ mạnh hơn khi hover (Cần TargetName, xử lý qua Code or Style Trigger, tạm dùng Scale) -->
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Product Image Area -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#F4F5F7" ClipToBounds="True">
                <Grid>
                    <materialDesign:PackIcon Kind="ImageOutline" Width="40" Height="40" 
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{StaticResource TextMuted}"
                                             Visibility="{Binding Product.MainImageUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>
                    <Image Source="{Binding Product.MainImageUrl}" Style="{StaticResource ProductImageStyle}"/>
                    
                    <!-- Sale Tag overlay if needed -->
                    <Border Background="{StaticResource Error}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" CornerRadius="6"
                            Visibility="{Binding Product.OriginalPrice, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="SALE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    
                    <!-- Heart Icon -->
                    <ToggleButton x:Name="HeartToggle"
                                  Style="{StaticResource MaterialDesignActionToggleButton}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="8" Width="36" Height="36"
                                  Background="#B3FFFFFF" BorderThickness="0"
                                  IsChecked="{Binding IsWishlisted, Mode=TwoWay}"
                                  Click="HeartToggle_Click"
                                  RenderTransformOrigin="0.5,0.5"
                                  ToolTip="Thêm vào yêu thích">
                        <ToggleButton.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </ToggleButton.RenderTransform>
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         From="1.0" To="1.3" Duration="0:0:0.15" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                         From="1.0" To="1.3" Duration="0:0:0.15" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                        <ToggleButton.Content>
                            <materialDesign:PackIcon Kind="HeartOutline" Foreground="{StaticResource TextMain}" Width="20" Height="20"/>
                        </ToggleButton.Content>
                        <materialDesign:ToggleButtonAssist.OnContent>
                            <materialDesign:PackIcon Kind="Heart" Foreground="{StaticResource Error}" Width="20" Height="20"/>
                        </materialDesign:ToggleButtonAssist.OnContent>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- Product Info -->
            <StackPanel Grid.Row="1" Margin="16,12,16,16">
                <!-- Tên sản phẩm -->
                <TextBlock Text="{Binding Product.ProductName}" 
                           FontSize="14" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextMain}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,4"/>

                <!-- Shop Name -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="StorefrontOutline" Width="12" Height="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Product.Shop.ShopName, TargetNullValue='Chính hãng'}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Giá tiền -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N0}đ}" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="{StaticResource Primary}"
                               Margin="0,0,8,0"/>
                    <!-- Original Price -->
                    <TextBlock Text="{Binding Product.OriginalPrice, StringFormat={}{0:N0}đ}" 
                               FontSize="12" Foreground="{StaticResource TextMuted}"
                               TextDecorations="Strikethrough"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Đánh giá & Lượt bán -->
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="Star" Foreground="{StaticResource Warning}" Width="14" Height="14"/>
                        <TextBlock Text="4.9" FontSize="12" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" Margin="2,0,4,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Product.SoldCount, TargetNullValue=0, StringFormat='Đã bán {0}'}" 
                               FontSize="12" Foreground="{StaticResource TextMuted}" 
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
