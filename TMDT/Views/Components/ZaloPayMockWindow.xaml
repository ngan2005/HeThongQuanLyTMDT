<Window x:Class="TMDT.Views.Components.ZaloPayMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán ZaloPay (Mô phỏng)" Height="560" Width="420"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.12"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">

            <!-- ZaloPay Header -->
            <Border Background="#0052CC" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="ZALOPAY" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </Border>
            <TextBlock Text="Quét mã QR để thanh toán" FontSize="13" Foreground="#444"
                       HorizontalAlignment="Center" Margin="0,6,0,16"/>

            <!-- QR Code Image (generated in code-behind) -->
            <Border Width="210" Height="210" Background="White" BorderBrush="#0052CC" BorderThickness="3"
                    CornerRadius="10" Margin="0,0,0,16" Padding="8">
                <Grid>
                    <TextBlock x:Name="txtQrPlaceholder" Text="⏳" FontSize="40"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                    <Image x:Name="imgQrCode" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="26" FontWeight="Bold"
                       Foreground="#111111" HorizontalAlignment="Center" Margin="0,4,0,6"/>
            <TextBlock x:Name="txtOrderCode" Text="" FontSize="12" Foreground="#0052CC"
                       HorizontalAlignment="Center" Margin="0,0,0,4" FontWeight="SemiBold"
                       Visibility="Collapsed"/>
            <TextBlock Text="ZaloPay · ID: 0987654321" FontSize="11" Foreground="#666"
                       HorizontalAlignment="Center" Margin="0,0,0,18" FontStyle="Italic"/>

            <!-- Confirm Button -->
            <Button Content="✅  XÁC NHẬN ĐÃ CHUYỂN KHOẢN" Background="#0052CC" Foreground="White"
                    FontWeight="Bold" FontSize="13" Height="46" Width="270" Click="BtnConfirm_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Hủy giao dịch" Background="Transparent" Foreground="Gray"
                    FontSize="12" BorderThickness="0" Margin="0,12,0,0" Click="BtnCancel_Click"/>

            <TextBlock Text="Môi trường thử nghiệm (Đồ án)" FontSize="10" Foreground="#CCC"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
