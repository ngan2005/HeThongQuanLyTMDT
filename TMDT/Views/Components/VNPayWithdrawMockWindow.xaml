<Window x:Class="TMDT.Views.Components.VNPayWithdrawMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rút tiền qua VNPay (Mô phỏng)" Height="580" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F4FF">

    <Border Background="White" CornerRadius="16" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="#1a237e"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">

            <!-- VNPay Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Border Width="36" Height="36" Background="#0057A8" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="V" FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="VNPay" FontSize="28" FontWeight="Bold" Foreground="#0057A8" VerticalAlignment="Center"/>
                <TextBlock Text="pay" FontSize="28" FontWeight="Bold" Foreground="#E53935" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Cổng Thanh toán Điện tử" FontSize="12" Foreground="#9E9E9E"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock Text="Môi trường thử nghiệm (Đồ án)" FontSize="11" Foreground="#BDBDBD"
                       HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Separator -->
            <Border Height="1" Background="#E8EAF6" Margin="0,0,0,24"/>

            <!-- Transaction Info -->
            <Border Background="#F5F7FF" CornerRadius="10" Padding="20,16" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN GIAO DỊCH" FontSize="10" FontWeight="SemiBold"
                               Foreground="#9E9E9E" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Loại:" FontSize="13" Foreground="#616161"/>
                        <TextBlock Text="Rút tiền từ ví Seller" FontSize="13" FontWeight="Medium"
                                   Foreground="#0057A8" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Đến tài khoản:" FontSize="13" Foreground="#616161"/>
                        <TextBlock x:Name="txtAccountName" Text="VNPay Wallet" FontSize="13" FontWeight="Medium"
                                   Foreground="#212121" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Mã giao dịch:" FontSize="13" Foreground="#616161"/>
                        <TextBlock x:Name="txtTxnRef" Text="" FontSize="13" FontWeight="Medium"
                                   Foreground="#757575" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Số tiền rút:" FontSize="13" Foreground="#616161" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="36" FontWeight="Bold"
                       Foreground="#0057A8" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="Tiền sẽ về tài khoản VNPay của bạn" FontSize="12" Foreground="#9E9E9E"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <!-- Confirm Button -->
            <Button Content="XÁC NHẬN RÚT TIỀN" Click="BtnConfirm_Click"
                    Height="48" Width="280" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#0057A8" CornerRadius="10" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0046A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#003580"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Hủy giao dịch" Click="BtnCancel_Click"
                    Background="Transparent" Foreground="#9E9E9E" FontSize="13"
                    BorderThickness="0" Margin="0,12,0,0" Cursor="Hand"/>

            <!-- Footer -->
            <TextBlock Text="🔒  Kết nối an toàn SSL · Được bảo mật bởi VNPay" FontSize="11"
                       Foreground="#BDBDBD" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</Window>
