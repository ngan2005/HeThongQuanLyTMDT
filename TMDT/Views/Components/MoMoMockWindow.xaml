<Window x:Class="TMDT.Views.Components.MoMoMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán MoMo" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">

            <!-- MoMo Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Ellipse Width="36" Height="36" Margin="0,0,8,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#AE2070"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="MoMo" FontSize="26" FontWeight="Bold" Foreground="#AE2070" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Quét mã QR để thanh toán" FontSize="13" Foreground="#555"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtPhoneInfo" Text="" FontSize="11" Foreground="#AE2070"
                       HorizontalAlignment="Center" Margin="0,0,0,16" FontWeight="SemiBold"/>

            <!-- QR Code Image (real, generated from MoMo link) -->
            <Border BorderBrush="#AE2070" BorderThickness="3" CornerRadius="10"
                    Padding="8" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Image x:Name="imgQR" Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="#555" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="26" FontWeight="Bold"
                       Foreground="#AE2070" HorizontalAlignment="Center" Margin="0,4,0,4"/>

            <!-- Instructions -->
            <Border Background="#FFF0F7" CornerRadius="8" Padding="12,8" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="1. Mở app MoMo trên điện thoại" FontSize="12" Foreground="#555"/>
                    <TextBlock Text="2. Bấm Quét mã QR" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                    <TextBlock Text="3. Quét mã bên trên và xác nhận chuyển tiền" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                    <TextBlock Text="4. Bấm XÁC NHẬN sau khi đã chuyển thành công" FontSize="12" Foreground="#AE2070" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Button Content="✓  ĐÃ CHUYỂN TIỀN THÀNH CÔNG" Background="#AE2070" Foreground="White"
                    FontWeight="Bold" FontSize="13" Height="44" Width="300"
                    Click="BtnConfirm_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#AE2070" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9B1A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Hủy giao dịch" Background="Transparent" Foreground="#999"
                    FontSize="12" BorderThickness="0" Margin="0,10,0,0" Click="BtnCancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Border>
</Window>
