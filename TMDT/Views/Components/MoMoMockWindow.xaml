<Window x:Class="TMDT.Views.Components.MoMoMockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán MoMo" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4" ResizeMode="NoResize">
    <Border Background="White" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">

            <!-- MoMo Header -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Ellipse Width="36" Height="36" Margin="0,0,8,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#AE2070"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="MoMo" FontSize="26" FontWeight="Bold" Foreground="#AE2070" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Quét mã QR để thanh toán" FontSize="13" Foreground="#555"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="txtPhoneInfo" Text="" FontSize="11" Foreground="#AE2070"
                       HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtOrderCode" Text="" FontSize="12" Foreground="#475569"
                       HorizontalAlignment="Center" Margin="0,0,0,8" FontWeight="SemiBold"
                       Visibility="Collapsed"/>

            <!-- QR Code Image (real, generated from MoMo link) -->
            <Border BorderBrush="#AE2070" BorderThickness="3" CornerRadius="10"
                    Padding="8" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Grid Width="200" Height="200">
                    <Image x:Name="imgQR" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform"/>
                    <!-- 🟢 Placeholder khi không có QR upload — hiện icon cảnh báo -->
                    <TextBlock x:Name="txtNoQrPlaceholder" Text="⚠" FontSize="70"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#E0A75E" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 🟢 Cảnh báo khi chưa upload QR -->
            <Border x:Name="txtWarning" Background="#FFF4E5" BorderBrush="#E0A75E" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="txtWarningText" FontSize="11" Foreground="#7A4F0A"
                           TextWrapping="Wrap" LineHeight="16" HorizontalAlignment="Center"
                           TextAlignment="Center"/>
            </Border>

            <!-- Amount -->
            <TextBlock Text="Số tiền thanh toán:" FontSize="13" Foreground="#555" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtAmount" Text="0 đ" FontSize="26" FontWeight="Bold"
                       Foreground="#AE2070" HorizontalAlignment="Center" Margin="0,4,0,4"/>

            <!-- Instructions -->
            <Border Background="#FFF0F7" CornerRadius="8" Padding="12,8" Margin="0,4,0,16">
                <StackPanel>
                    <TextBlock Text="1. Mở app MoMo trên điện thoại" FontSize="12" Foreground="#555"/>
                    <TextBlock Text="2. Bấm Quét mã QR" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                    <TextBlock Text="3. Quét mã bên trên và xác nhận chuyển tiền" FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                    <TextBlock Text="4. Bấm XÁC NHẬN sau khi đã chuyển thành công" FontSize="12" Foreground="#AE2070" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Button x:Name="BtnConfirm" Content="✓  ĐÃ CHUYỂN TIỀN THÀNH CÔNG" Background="#AE2070" Foreground="White"
                    FontWeight="Bold" FontSize="13" Height="44" Width="300"
                    Click="BtnConfirm_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#AE2070" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#9B1A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 🟢 Offline: xác nhận đã nhận tiền trong khi mạng lỗi — sẽ auto sync khi có mạng lại -->
            <Button x:Name="btnOfflineConfirm" Margin="0,8,0,0"
                    Background="Transparent" Foreground="#0D9488" FontWeight="SemiBold"
                    FontSize="12.5" BorderThickness="0" Click="BtnOfflineConfirm_Click"
                    Cursor="Hand" ToolTip="Khách đã chuyển nhưng POS không kết nối được server — lưu offline và đồng bộ sau">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🔌  Đã nhận tiền (offline - sync sau)" Foreground="#0D9488" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Content="Hủy giao dịch" Background="Transparent" Foreground="#999"
                    FontSize="12" BorderThickness="0" Margin="0,10,0,0" Click="BtnCancel_Click" Cursor="Hand"/>

            <!-- 🟢 Nút Sửa đơn: quay về POS để chỉnh SL/SP trước khi xác nhận (chỉ hỗ trợ khi AwaitingPayment) -->
            <Button x:Name="btnEditOrder" Background="Transparent" Foreground="#0D9488" FontWeight="SemiBold"
                    FontSize="12.5" BorderThickness="0" Margin="0,8,0,0" Click="BtnEditOrder_Click"
                    Cursor="Hand" ToolTip="Quay về POS để chỉnh sửa số lượng / thêm sản phẩm trước khi thanh toán">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✎  SỬA ĐƠN (quay lại POS)" Foreground="#0D9488" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
