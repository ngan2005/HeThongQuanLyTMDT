<Window x:Class="TMDT.Views.AddressPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Chọn địa chỉ"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Border Background="White" CornerRadius="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#00000022" ShadowDepth="4" Opacity="1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#1E1B4B" Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Địa chỉ giao hàng" FontSize="18" FontWeight="Bold"
                                   Foreground="White" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text="Chọn địa chỉ nhận hàng chính xác"
                                   FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip="Đóng">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,0">

                    <!-- Recipient Name -->
                    <TextBlock Text="Tên người nhận *" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,0,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="42">
                        <TextBox x:Name="RecipientNameBox"
                                 Text="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="13"
                                 FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </Border>

                    <!-- Phone -->
                    <TextBlock Text="Số điện thoại *" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,14,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="42">
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="13"
                                 FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </Border>

                    <!-- Province -->
                    <TextBlock Text="Tỉnh / Thành phố *" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,14,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="42">
                        <ComboBox x:Name="ProvinceCombo"
                                  ItemsSource="{Binding Provinces}"
                                  SelectedItem="{Binding SelectedProvince}"
                                  DisplayMemberPath="Name"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalAlignment="Center" FontSize="13"
                                  FontFamily="Be Vietnam Pro, Segoe UI"
                                  IsSynchronizedWithCurrentItem="False"/>
                    </Border>

                    <!-- District -->
                    <TextBlock Text="Quận / Huyện *" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,14,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="42">
                        <ComboBox ItemsSource="{Binding Districts}"
                                  SelectedItem="{Binding SelectedDistrict}"
                                  DisplayMemberPath="Name"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalAlignment="Center" FontSize="13"
                                  FontFamily="Be Vietnam Pro, Segoe UI"
                                  IsSynchronizedWithCurrentItem="False"/>
                    </Border>

                    <!-- Ward -->
                    <TextBlock Text="Phường / Xã *" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,14,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="42">
                        <ComboBox ItemsSource="{Binding Wards}"
                                  SelectedItem="{Binding SelectedWard}"
                                  DisplayMemberPath="Name"
                                  BorderThickness="0" Background="Transparent"
                                  VerticalAlignment="Center" FontSize="13"
                                  FontFamily="Be Vietnam Pro, Segoe UI"
                                  IsSynchronizedWithCurrentItem="False"/>
                    </Border>

                    <!-- Street -->
                    <TextBlock Text="Số nhà, tên đường" FontSize="12.5" FontWeight="Medium"
                               Foreground="#374151" Margin="0,14,0,6"/>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                            CornerRadius="8" Padding="12,0" Height="80">
                        <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center" FontSize="13"
                                 FontFamily="Be Vietnam Pro, Segoe UI"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Center"/>
                    </Border>

                    <!-- Default Address Checkbox -->
                    <CheckBox Content="Đặt làm địa chỉ mặc định"
                              IsChecked="{Binding IsDefaultAddress}"
                              FontFamily="Be Vietnam Pro, Segoe UI"
                              FontSize="13" Foreground="#374151"
                              Margin="0,14,0,0"/>

                    <!-- Loading Indicator -->
                    <TextBlock Text="Đang tải dữ liệu địa chỉ..."
                               Foreground="#6B7280" FontSize="12"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                               Margin="0,8,0,0"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Padding="24,16" Background="#F9FAFB">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="40" Background="#F3F4F6"
                            Foreground="#374151" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CancelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="Hủy bỏ" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Height="40" Width="140" Background="#0D9488"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Command="{Binding ConfirmCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="Xác nhận" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
