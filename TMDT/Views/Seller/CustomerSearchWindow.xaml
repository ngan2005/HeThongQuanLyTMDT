<Window x:Class="TMDT.Views.Seller.CustomerSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TMDT.Converters"
        Title="Tìm Khách Hàng Thành Viên" Height="600" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InitialLetterConverter x:Key="InitialLetterConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="14" Margin="16" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Border Grid.Row="0" Background="#0F766E" CornerRadius="14,14,0,0" Padding="20,16"
                    MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="26" Height="26"
                                                     Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Tìm Khách Hàng Thành Viên" FontSize="18" FontWeight="Bold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Chọn khách hàng đã đăng ký để áp dụng điểm tích lũy cho đơn hàng"
                                   FontSize="12.5" Foreground="#CCFBF1" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Click="BtnCancel_Click" Margin="0,-4,-4,0" Padding="0" Width="30" Height="30"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#99F6E4" ToolTip="Đóng">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== SEARCH BOX ===== -->
            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtSearch"
                                 materialDesign:HintAssist.Hint="Tìm theo tên hoặc số điện thoại..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="14"
                                 Foreground="#334155" Height="42" VerticalContentAlignment="Center"
                                 TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"/>
                        <Button Grid.Column="2" x:Name="btnClearSearch" Click="BtnClearSearch_Click"
                                ToolTip="Xóa" Padding="4" Width="28" Height="28" VerticalAlignment="Center"
                                Visibility="Collapsed" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== CUSTOMERS LIST ===== -->
            <Grid Grid.Row="2" Margin="20,8,20,8">
                <DataGrid x:Name="dgCustomers"
                          ItemsSource="{Binding FilteredCustomers}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1" RowHeight="56" ColumnHeaderHeight="44"
                          HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="Transparent"
                          HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                          MouseDoubleClick="DgCustomers_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="14,0"/>
                        </Style>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0FDFA"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#CCFBF1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#334155"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="KHÁCH HÀNG" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,8">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#E0F2FE" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FullName, Converter={StaticResource InitialLetterConverter}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="#0369A1" FontWeight="Bold" FontSize="14"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="14"/>
                                            <TextBlock Text="{Binding Phone}" Foreground="#64748B" FontSize="12.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="SỐ ĐƠN" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ShoppingOutline" Width="16" Height="16"
                                                                 Foreground="#0D9488" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding OrderCount}" FontWeight="Medium" Foreground="#0F172A"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ĐIỂM TÍCH LŨY" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="StarCircleOutline" Width="18" Height="18"
                                                                 Foreground="#F59E0B" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding LoyaltyPoints, StringFormat={}{0:N0}}"
                                                   FontWeight="Bold" Foreground="#F59E0B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            x:Name="emptyState"
                            Visibility="{Binding ElementName=dgCustomers, Path=Items.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
                    <materialDesign:PackIcon Kind="AccountSearchOutline" Width="80" Height="80"
                                             Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Không tìm thấy khách hàng" FontSize="18" FontWeight="SemiBold"
                               Foreground="#475569" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="emptyHint" Text="Thử gõ tên hoặc số điện thoại khác để tìm kiếm."
                               FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Loading state -->
                <Border x:Name="loadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="32" Height="32" Foreground="#0D9488"/>
                        <TextBlock Text="Đang tải..." Foreground="#475569" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtResultCount" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="#64748B" FontSize="13" FontStyle="Italic"/>

                    <Button Grid.Column="1" x:Name="btnCancel" Content="Hủy bỏ" Width="110" Height="38"
                            Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" BorderThickness="0"
                            Click="BtnCancel_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="3" x:Name="btnSelect" Content="Chọn khách hàng" Width="160" Height="38"
                            Background="#0D9488" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                            IsEnabled="False" Click="BtnSelect_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                                        <Setter Property="Cursor" Value="No"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
