<UserControl x:Class="TMDT.Views.Seller.SellerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Seller"
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="820">
    <UserControl.Resources>
        <!-- Style for Stats Cards -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.02"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Stats cards -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Charts & Lists -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: STATISTICS CARDS -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Wallet Balance -->
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Ví Số Dư Shop" FontSize="11.5" Foreground="#64748B" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="{Binding WalletBalance, StringFormat={}{0:N0} đ}" FontSize="18" Foreground="#0D9488" FontWeight="ExtraBold" Margin="0,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Sẵn sàng rút tiền" FontSize="9.5" Foreground="#10B981" FontWeight="Medium" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Sold -->
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Đã Bán Hàng" FontSize="11.5" Foreground="#64748B" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="{Binding TotalSold, StringFormat={}{0:N0}}" FontSize="18" Foreground="#1E293B" FontWeight="ExtraBold" Margin="0,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Sản phẩm giao thành công" FontSize="9.5" Foreground="#64748B" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Active Orders -->
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Đơn Hàng Mới" FontSize="11.5" Foreground="#64748B" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="{Binding ActiveOrders}" FontSize="18" Foreground="#EA580C" FontWeight="ExtraBold" Margin="0,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Đơn hàng chờ xác nhận" FontSize="9.5" Foreground="#EA580C" FontWeight="Medium" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Total Products -->
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Tổng Sản Phẩm" FontSize="11.5" Foreground="#64748B" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="{Binding TotalProducts}" FontSize="18" Foreground="#6366F1" FontWeight="ExtraBold" Margin="0,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Trong kho hàng shop" FontSize="9.5" Foreground="#64748B" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Shop Rating -->
            <Border Grid.Column="4" Style="{StaticResource StatCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="Đánh Giá Shop" FontSize="11.5" Foreground="#64748B" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="{Binding Rating, StringFormat={}{0:F1} ★}" FontSize="18" Foreground="#EAB308" FontWeight="ExtraBold" Margin="0,8,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <TextBlock Text="Được đánh giá bởi khách" FontSize="9.5" Foreground="#EAB308" FontWeight="Medium" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 1: CHARTS & DYNAMIC CONTENT -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Sales Trend -->
                <ColumnDefinition Width="1.2*"/>
                <!-- Right: Recent orders & Top sellers -->
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT PANEL: SALES REVENUE TREND (BAR CHART) -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Doanh Thu Cửa Hàng" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text="Thống kê doanh số bán hàng trong 7 ngày gần nhất" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>

                    <!-- Bar Chart Canvas -->
                    <Grid Grid.Row="1" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Bars -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding RevenueTrend}" VerticalAlignment="Bottom" Height="180">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Bottom" Margin="4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Hover tooltip representation -->
                                        <TextBlock Grid.Row="0" Text="{Binding RevenueDisplay}" FontSize="9" FontWeight="Bold" Foreground="#0D9488" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        
                                        <!-- The Bar -->
                                        <Border Grid.Row="1" Height="{Binding BarHeight}" Background="#0D9488" CornerRadius="4,4,0,0" Width="18" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                            <Setter Property="Cursor" Value="Help"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- X Axis labels -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RevenueTrend}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DayName}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" FontWeight="Medium" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2. RIGHT PANEL: TWO HORIZONTAL SPLIT LISTS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Recent Orders -->
                    <RowDefinition Height="*"/>
                    <!-- Best Sellers -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Recent Orders List -->
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Đơn Hàng Gần Đây" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" FontFamily="Be Vietnam Pro, Segoe UI"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentOrders}" AutoGenerateColumns="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" 
                                  BorderThickness="0" RowHeight="36" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã Đơn" Binding="{Binding OrderCode}" Width="80"/>
                                <DataGridTextColumn Header="Khách Hàng" Binding="{Binding BuyerName}" Width="*"/>
                                <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TotalAmount, StringFormat={}{0:N0} đ}" Width="100"/>
                                <DataGridTemplateColumn Header="Trạng Thái" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Background" Value="#FFEFE2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Shipping">
                                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#ECFDF5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9.5" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="Text" Value="Chờ duyệt"/>
                                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Shipping">
                                                                    <Setter Property="Text" Value="Đang giao"/>
                                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Text" Value="Đã xong"/>
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Best Sellers List -->
                <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sản Phẩm Bán Chạy Nhất" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" FontFamily="Be Vietnam Pro, Segoe UI"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" 
                                  HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" 
                                  BorderThickness="0" RowHeight="36" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã SP" Binding="{Binding ProductCode}" Width="80"/>
                                <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Giá Bán" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="90"/>
                                <DataGridTextColumn Header="Đã Bán" Binding="{Binding SoldCount}" Width="60"/>
                                <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockQuantity}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
