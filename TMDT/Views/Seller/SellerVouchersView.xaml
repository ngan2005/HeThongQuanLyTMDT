<UserControl x:Class="TMDT.Views.Seller.SellerVouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Seller"
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="820">

    <UserControl.Resources>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D9488"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: Vouchers list (as premium cards) -->
            <ColumnDefinition Width="1.3*"/>
            <!-- Right: Create Voucher Form -->
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT COLUMN: VOUCHERS CARDS LIST -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Khuyến Mãi &amp; Voucher Của Shop" FontSize="15.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Vouchers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Custom Coupon Card Style with Dashed Border and Circle Cuts -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,0,0,14" Height="100" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Left side: Discount Type/Logo -->
                                            <ColumnDefinition Width="90"/>
                                            <!-- Split dashed line -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Right side: Details -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Side: Large discount tag -->
                                        <Border Grid.Column="0" Background="#0D9488" CornerRadius="11,0,0,11">
                                            <Grid>
                                                <!-- Circular Cutouts at top and bottom of split line -->
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Icon coupon -->
                                                    <TextBlock Text="&#xE1A1;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="VOUCHER" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Dashed divider -->
                                        <Rectangle Grid.Column="1" Width="1" Stroke="#E2E8F0" StrokeDashArray="4 3" VerticalAlignment="Stretch"/>

                                        <!-- Right Side: Details & Actions -->
                                        <Grid Grid.Column="2" Margin="14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <!-- Coupon Code Badge -->
                                                    <Border Background="#F0FDFA" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding VoucherCode}" FontSize="11" FontWeight="Bold" Foreground="#0D9488" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding VoucherName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                </StackPanel>

                                                <!-- Discount Value text -->
                                                <TextBlock FontSize="12" Foreground="#64748B" FontFamily="Be Vietnam Pro, Segoe UI">
                                                    <Run Text="Giảm: "/>
                                                    <Run Text="{Binding DiscountValue, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#EA580C"/>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DiscountType}" Value="Percentage">
                                                                <Setter Property="Text">
                                                                    <Setter.Value>
                                                                        <TextBlock FontSize="12" Foreground="#64748B" FontFamily="Be Vietnam Pro, Segoe UI">
                                                                            <Run Text="Giảm: "/>
                                                                            <Run Text="{Binding DiscountValue, StringFormat={}{0:N0}%}" FontWeight="Bold" Foreground="#EA580C"/>
                                                                            <Run Text=" (Tối đa "/>
                                                                            <Run Text="{Binding MaxDiscount, StringFormat={}{0:N0} đ}"/>
                                                                            <Run Text=")"/>
                                                                        </TextBlock>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock>

                                                <!-- Order requirement -->
                                                <TextBlock Text="{Binding MinOrderValue, StringFormat={}Đơn tối thiểu: {0:N0} đ}" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                <TextBlock Text="{Binding EndDate, StringFormat={}Hạn dùng: {0:dd/MM/yyyy}}" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                            </StackPanel>

                                            <!-- Quick Action: Toggle Status -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <!-- Used count -->
                                                <TextBlock Text="{Binding UsedCount, StringFormat={}{0} đã dùng}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,0,10" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                
                                                <!-- Toggle active button -->
                                                <Button Content="Tạm dừng" FontSize="10" Padding="8,4" Cursor="Hand"
                                                        Command="{Binding DataContext.ToggleVoucherStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#0D9488"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    <Setter Property="Content" Value="Kích hoạt"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- RIGHT COLUMN: CREATE VOUCHER FORM -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tạo Mã Giảm Giá Mới" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16" FontFamily="Be Vietnam Pro, Segoe UI"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Voucher Code -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Mã Code Voucher (Nên viết liền không dấu) *"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding VoucherCodeInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" ToolTip="Ví dụ: GIAM20K, MYSUMMER"/>

                        <!-- Voucher Name -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Tên Voucher (Mô tả hiển thị) *"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding VoucherNameInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12" ToolTip="Ví dụ: Giảm giá mùa hè cho tất cả đơn hàng"/>

                        <!-- Discount Type -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Loại Hình Giảm Giá"/>
                        <ComboBox Height="36" SelectedValuePath="Tag" SelectedValue="{Binding DiscountTypeInput}" Margin="0,0,0,12">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Theo phần trăm (%)" Tag="Percentage" IsSelected="True"/>
                            <ComboBoxItem Content="Số tiền cố định (đ)" Tag="Fixed"/>
                        </ComboBox>

                        <!-- Discount Value -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Mức Giảm Giá (Số tiền hoặc số %)*"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding DiscountValueInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12"/>

                        <!-- Max Discount (enabled only if Percentage is active) -->
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DiscountTypeInput}" Value="Fixed">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource InputLabel}" Text="Mức giảm tối đa (đ)"/>
                            <TextBox Style="{StaticResource FormInput}" Text="{Binding MaxDiscountInput, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                        </StackPanel>

                        <!-- Min Order Value -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Giá trị đơn hàng tối thiểu (đ)"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding MinOrderValueInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12"/>

                        <!-- Row: Total Qty & Duration -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Total quantity -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource InputLabel}" Text="Số lượng phát hành"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding TotalQuantityInput, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>

                            <!-- Duration days -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InputLabel}" Text="Thời hạn dùng (ngày)"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding DurationDaysInput, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Create Voucher Action button -->
                <Button Grid.Row="2" Command="{Binding SaveVoucherCommand}" Background="#0D9488" BorderThickness="0" Height="38" Cursor="Hand">
                    <Button.Template>
                         <ControlTemplate TargetType="Button">
                             <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                             </Border>
                         </ControlTemplate>
                     </Button.Template>
                     <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text=" Tạo &amp; Phát Hành Voucher" FontSize="12.5" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
