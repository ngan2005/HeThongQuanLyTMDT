<Window x:Class="TMDT.Views.Seller.HeldOrdersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đơn đang treo" Height="500" Width="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ActionBtn" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Danh sách đơn đang treo" FontSize="18" FontWeight="Bold"
                   Foreground="#0F172A" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" x:Name="lstHeld" ItemsSource="{Binding}"
                 Background="White" BorderBrush="#E2E8F0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="8" Background="White"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding CustomerName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding CustomerPhone}" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding CartItems.Count, StringFormat=' · {0} sản phẩm'}" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding HeldAt, StringFormat=' · {0:HH:mm}'}" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding NetPayment, StringFormat={}{0:N0} đ}"
                                       FontWeight="Bold" FontSize="16" Foreground="#EF4444"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <Button Grid.Column="2" Content="Khôi phục" Click="Resume_Click" Tag="{Binding}"
                                    Background="#0D9488" Foreground="White" Padding="14,6"
                                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đóng" Click="Close_Click" Style="{StaticResource ActionBtn}" Foreground="#64748B"/>
        </StackPanel>
    </Grid>
</Window>