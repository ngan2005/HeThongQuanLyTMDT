<UserControl x:Class="TMDT.Views.Seller.SellerProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Seller"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="580" d:DesignWidth="820">

    <UserControl.Resources>
        <!-- Converter for checking active status filter -->
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>

        <!-- Premium Button Styles -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D9488"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="ProductFilter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0D9488"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D9488"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D9488"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: Products List -->
            <ColumnDefinition Width="1.4*"/>
            <!-- Right: Product Inspector Panel -->
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT COLUMN: PRODUCTS LIST -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Search & Filter buttons Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- DataGrid -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Search -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Danh Sách Sản Phẩm" FontSize="15.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Tìm theo Tên hoặc Mã sản phẩm"/>
                        <TextBlock IsHitTestVisible="False" Text="&#xE721; Tìm sản phẩm..." FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Filters bar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource FilterBtn}" Content="Tất cả" Command="{Binding SetFilterCommand}" CommandParameter="All" IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=All, Mode=OneWay}" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource FilterBtn}" Content="Đang bán" Command="{Binding SetFilterCommand}" CommandParameter="Approved" IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Approved, Mode=OneWay}" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource FilterBtn}" Content="Chờ duyệt" Command="{Binding SetFilterCommand}" CommandParameter="Pending" IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Pending, Mode=OneWay}" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource FilterBtn}" Content="Từ chối" Command="{Binding SetFilterCommand}" CommandParameter="Rejected" IsChecked="{Binding StatusFilter, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Rejected, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid List of Products -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" 
                          BorderThickness="0" RowHeight="42" IsReadOnly="True">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F0FDFA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#0D9488"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Code" Binding="{Binding ProductCode}" Width="100"/>
                        <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Giá Bán" Binding="{Binding Price, StringFormat={}{0:N0} đ}" Width="90"/>
                        <DataGridTextColumn Header="Tồn Kho" Binding="{Binding StockQuantity}" Width="60"/>
                        <DataGridTemplateColumn Header="Trạng Thái" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFEFE2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                        <Setter Property="Background" Value="#ECFDF5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9.5" FontWeight="Bold" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Text" Value="Chờ duyệt"/>
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Text" Value="Đang bán"/>
                                                            <Setter Property="Foreground" Value="#059669"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Text" Value="Từ chối"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- RIGHT COLUMN: PRODUCT INSPECTOR PANEL -->
        <!-- ========================================== -->
        <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="#F1F5F9" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Fields Form -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Actions -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Chi Tiết / Đăng Bán" FontSize="14" FontWeight="Bold" Foreground="#1E293B" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    <Button Command="{Binding ResetFieldsCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Làm mới form thêm sản phẩm mới">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#0D9488" VerticalAlignment="Center"/>
                            <TextBlock Text=" Thêm Mới" FontSize="11" Foreground="#0D9488" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Form Inputs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Product Code -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Mã Sản Phẩm (Mã SKU)"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding ProductCodeInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12"/>

                        <!-- Product Name -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Tên Sản Phẩm *"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding ProductNameInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12"/>

                        <!-- Category ComboBox -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Danh Mục Ngành Hàng"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategoryInput}" DisplayMemberPath="CategoryName" Height="36" Margin="0,0,0,12">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </ComboBox.Resources>
                        </ComboBox>

                        <!-- Row for Price & Original Price -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Price -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource InputLabel}" Text="Giá Bán (đ) *"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding PriceInput, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                            
                            <!-- Original Price -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InputLabel}" Text="Giá Gốc Gốc (đ)"/>
                                <TextBox Style="{StaticResource FormInput}" Text="{Binding OriginalPriceInput, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <!-- Stock -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Số Lượng Tồn Kho"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding StockInput, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,12"/>

                        <!-- Description -->
                        <TextBlock Style="{StaticResource InputLabel}" Text="Mô Tả Sản Phẩm"/>
                        <TextBox Style="{StaticResource FormInput}" Text="{Binding DescriptionInput, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Delete button -->
                    <Button Grid.Column="0" Command="{Binding DeleteProductCommand}" Background="#FEE2E2" BorderThickness="0" Height="36" Width="36" Cursor="Hand" ToolTip="Xóa sản phẩm" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Save / Add button -->
                    <Button Grid.Column="1" Command="{Binding SaveProductCommand}" Background="#0D9488" BorderThickness="0" Height="36" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE105;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text=" Lưu Sản Phẩm" FontSize="12.5" Foreground="#FFFFFF" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Be Vietnam Pro, Segoe UI"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
