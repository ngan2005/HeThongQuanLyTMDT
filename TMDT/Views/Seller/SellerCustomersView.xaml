<UserControl x:Class="TMDT.Views.Seller.SellerCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:TMDT.ViewModels.Seller"
             xmlns:converters="clr-namespace:TMDT.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="#F8FAFC"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             FontFamily="Segoe UI">

    <!-- Resources for Converters -->
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:InitialLetterConverter x:Key="InitialLetterConverter"/>
    </UserControl.Resources>

    <!-- Design Time DataContext -->
    <d:UserControl.DataContext>
        <vm:SellerCustomersViewModel/>
    </d:UserControl.DataContext>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Khách hàng của Shop" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Quản lý thông tin thành viên, điểm tích lũy và lịch sử mua sắm" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar: Search & Add Button -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:HintAssist.Hint="Tìm kiếm theo Tên hoặc Số điện thoại..." 
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                             BorderThickness="0" VerticalAlignment="Center" FontSize="14" Foreground="#334155" Height="40" VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="20" Height="20" Foreground="#0D9488"/>
                <TextBlock Text="Đang tải dữ liệu..." Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Add Button -->
            <Button Grid.Column="2" Command="{Binding AddCustomerCommand}" 
                    Background="#0D9488" Foreground="White" BorderThickness="0" Height="42" Padding="20,0"
                    materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Thêm Khách Hàng" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Data Grid -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Customers}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0" RowHeight="56" ColumnHeaderHeight="48"
                      HorizontalGridLinesBrush="#F1F5F9" VerticalGridLinesBrush="Transparent"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
                
                <!-- Styling cho DataGrid -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="16,0"/>
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0FDFA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCFBF1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Foreground" Value="#334155"/>
                    </Style>
                </DataGrid.Resources>

                <!-- Cột dữ liệu -->
                <DataGrid.Columns>
                    
                    <!-- Khách hàng (Tên & SĐT) -->
                    <DataGridTemplateColumn Header="KHÁCH HÀNG" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,8">
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E0F2FE" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FullName, Converter={StaticResource InitialLetterConverter}}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                   Foreground="#0369A1" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="14"/>
                                        <TextBlock Text="{Binding Phone}" Foreground="#64748B" FontSize="12.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Số lượng đơn hàng -->
                    <DataGridTemplateColumn Header="SỐ ĐƠN ĐÃ MUA" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShoppingOutline" Width="16" Height="16" Foreground="#0D9488" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding OrderCount, StringFormat={}{0} đơn}" FontWeight="Medium" Foreground="#0F172A"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Điểm tích lũy -->
                    <DataGridTemplateColumn Header="ĐIỂM TÍCH LŨY" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="StarCircleOutline" Width="18" Height="18" Foreground="#F59E0B" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding LoyaltyPoints, StringFormat={}{0:N0} điểm}" FontWeight="Bold" Foreground="#F59E0B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Ngày tham gia -->
                    <DataGridTextColumn Header="NGÀY THAM GIA" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="150" Foreground="#64748B"/>
                    
                    <!-- Nguồn/Email -->
                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*" Foreground="#94A3B8"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty State -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Visibility="{Binding Customers.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}">
            <materialDesign:PackIcon Kind="AccountSearchOutline" Width="80" Height="80" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Chưa có khách hàng nào" FontSize="18" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
            <TextBlock Text="Bấm 'Thêm Khách Hàng' để đăng ký khách hàng mới nhé." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

    </Grid>
</UserControl>
