<Window x:Class="TMDT.Views.Seller.SellerMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Seller"
        xmlns:views="clr-namespace:TMDT.Views.Seller"
        xmlns:converters="clr-namespace:TMDT.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Seller Portal | Volox" Height="680" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseDown="Window_MouseDown"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:SellerMainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Converter for checking active menu -->
        <converters:EqualityToBooleanConverter x:Key="EqualityToBooleanConverter"/>
        <converters:StringNullOrEmptyToBoolConverter x:Key="StringNullOrEmptyToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Mapping ViewModels to Views using DataTemplates -->
        <DataTemplate DataType="{x:Type vm:SellerDashboardViewModel}">
            <views:SellerDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerPosViewModel}">
            <views:SellerPosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerProductsViewModel}">
            <views:SellerProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerOrdersViewModel}">
            <views:SellerOrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerReturnRequestsViewModel}">
            <views:SellerReturnRequestsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerVouchersViewModel}">
            <views:SellerVouchersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerReviewsViewModel}">
            <views:SellerReviewsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerChatViewModel}">
            <views:SellerChatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerWalletViewModel}">
            <views:SellerWalletView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerProfileViewModel}">
            <views:SellerProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SellerSalesHistoryViewModel}">
            <views:SellerSalesHistoryView/>
        </DataTemplate>

        <!-- Design System Colors — Seller Teal & Indigo Theme -->
        <SolidColorBrush x:Key="SidebarBg" Color="#1E1B4B"/> <!-- Very dark Indigo -->
        <SolidColorBrush x:Key="BrandTeal" Color="#0D9488"/> <!-- Modern Teal -->
        <SolidColorBrush x:Key="BgWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderSlate" Color="#E2E8F0"/>

        <!-- Sidebar RadioButton Style with Smooth Hover Translate & Glow Active Indicator -->
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SidebarMenu"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <!-- Background overlay (for hover/active states) -->
                            <Border x:Name="bgOverlay" CornerRadius="8" Background="Transparent" />

                            <!-- Hover glow: subtle brand teal -->
                            <Border x:Name="glow" CornerRadius="8" Opacity="0" Background="#0D9488">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0D9488" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                </Border.Effect>
                            </Border>

                            <!-- Content Wrapper -->
                            <Border Padding="12,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="translate" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- Active indicator stripe: brand teal -->
                                    <Border x:Name="indicator" Width="3" Height="16" Background="#0D9488" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/>
                                    
                                    <!-- Content Area -->
                                    <ContentPresenter x:Name="content" Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Hover: soft teal tint -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 1A hex = 10% opacity -->
                                <Setter TargetName="bgOverlay" Property="Background" Value="#1A0D9488"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="translate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            
                            <!-- Active: gradient pill + indicator glow -->
                            <Trigger Property="IsChecked" Value="True">
                                <!-- 33 hex = 20% opacity -->
                                <Setter TargetName="bgOverlay" Property="Background" Value="#330D9488"/>
                                <Setter TargetName="indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.08"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle arrow button style -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E2A66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button Styles -->
        <Style x:Key="WindowNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Window Container -->
        <Border Background="{StaticResource BgMain}" CornerRadius="16" BorderBrush="{StaticResource BorderSlate}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#1E1B4B" Direction="270" ShadowDepth="4" Opacity="0.10"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Column 0: Sidebar -->
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                <!-- Column 1: Main Content Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- COLUMN 0: SIDEBAR (DARK INDIGO THEME) -->
            <!-- ========================================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBg}" CornerRadius="15,0,0,15" Width="240" ClipToBounds="True">
                <Grid Margin="8,16">
                    <Grid.RowDefinitions>
                        <!-- Brand logo & System tag -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Admin Account Profile -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header with collapse toggle -->
                    <Grid Grid.Row="0" Margin="0,16,0,8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="BrandLogo" Source="pack://application:,,,/Resources/Images/logo.png" Height="120" Width="220" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,-25,0,-20">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock x:Name="BrandSubtitle" Text="KÊNH NGƯỜI BÁN" FontSize="11" FontWeight="Bold" Foreground="#0D9488" HorizontalAlignment="Center" Margin="0,0,0,0" FontFamily="Segoe UI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Collapse/Expand toggle arrow -->
                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource SidebarToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Click="SidebarToggle_Click" ToolTip="Thu/Mở thanh điều hướng">
                            <TextBlock x:Name="ToggleArrow" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#0D9488"/>
                        </Button>
                    </Grid>

                    <!-- Navigation Menu -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                        <StackPanel>

                            <!-- Register Shop Button (only when no shop yet) -->
                            <Button Command="{Binding RegisterShopCommand}"
                                    Height="40" Margin="0,2,0,12"
                                    Cursor="Hand"
                                    ToolTip="Đăng ký mở cửa hàng">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasShop}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#0D9488" CornerRadius="8" Padding="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="Đăng ký Shop mới" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="White" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Divider -->
                            <Border Height="1" Background="#2E2A66" Margin="0,0,0,8" Opacity="0.5"/>

                            <!-- Dashboard -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowDashboardCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Dashboard, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Tổng quan Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="t0" Text="Tổng quan Dashboard" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Bán tại quầy (POS) -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowPosCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=POS, Mode=OneWay}"
                                         ToolTip="Bán tại quầy (POS)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Bán tại quầy (POS)" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Products -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProductsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Products, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Sản phẩm của Shop">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sản phẩm của Shop" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Orders -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowOrdersCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Orders, Mode=OneWay}"
                                         ToolTip="Đơn hàng khách đặt">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đơn hàng khách đặt" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Lịch sử bán hàng -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowSalesHistoryCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=SalesHistory, Mode=OneWay}"
                                         ToolTip="Lịch sử bán hàng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lịch sử bán hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Return Requests -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowReturnRequestsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=ReturnRequests, Mode=OneWay}"
                                         ToolTip="Trả hàng / Hoàn tiền">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Trả hàng / Hoàn tiền" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Vouchers -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowVouchersCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Vouchers, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Mã giảm giá (Voucher)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TicketPercentOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mã giảm giá (Voucher)" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Reviews -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowReviewsCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Reviews, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Đánh giá Shop">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="StarOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đánh giá Shop" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Chat -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowChatCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Chat, Mode=OneWay}"
                                         ToolTip="Tin nhắn khách hàng">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ForumOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tin nhắn khách hàng" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Wallet -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowWalletCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Wallet, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Ví tiền &amp; Rút tiền">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="WalletOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ví tiền &amp; Rút tiền" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                            <!-- Profile -->
                            <RadioButton Style="{StaticResource SidebarButton}" Command="{Binding ShowProfileCommand}" 
                                         IsChecked="{Binding ActiveMenu, Converter={StaticResource EqualityToBooleanConverter}, ConverterParameter=Profile, Mode=OneWay}"
                                         Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Cài đặt Shop">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="Cài đặt Shop" FontSize="12.5" FontWeight="Medium" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Profile Info -->
                    <Border Grid.Row="2" Background="#262261" CornerRadius="10" Padding="12" Opacity="0.95" BorderThickness="1" BorderBrush="#20FFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Clickable Profile Area -->
                            <Button Grid.Column="0" Command="{Binding ShowProfileCommand}" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" Cursor="Hand" ToolTip="Xem thông tin Shop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Avatar Circle (S for Seller) -->
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandTeal}">
                                                    <TextBlock Text="S" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                                </Border>

                                                <!-- Details (hidden when collapsed) -->
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding ShopName}" TextTrimming="CharacterEllipsis" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" FontFamily="Segoe UI"/>
                                                    <TextBlock Text="Kênh Người Bán" FontSize="9.5" Foreground="#94A3B8" FontFamily="Segoe UI"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Logout button -->
                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logout_Click" ToolTip="Đăng xuất" Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- COLUMN 1: MAIN WORKSPACE (LIGHT CLEAN THEME) -->
            <!-- ========================================== -->
            <Grid Grid.Column="1" Margin="24,0,24,24">
                <Grid.RowDefinitions>
                    <!-- Top Window controls Header -->
                    <RowDefinition Height="64"/>
                    <!-- Dynamic Body Workspace -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR HEADER -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Subtitle status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Kênh Người Bán" FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        <TextBlock Text=" / " FontSize="11.5" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ActiveMenu}" FontSize="11.5" Foreground="{StaticResource BrandTeal}" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Top Window action controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowNavButton}" Click="MinimizeButton_Click" Margin="0,0,4,0" ToolTip="Thu nhỏ">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowNavButton}" Click="MaximizeButton_Click" Margin="0,0,4,0" ToolTip="Phóng to">
                            <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="ExitButton_Click" ToolTip="Đóng">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- DYNAMIC CONTENT BODY -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
