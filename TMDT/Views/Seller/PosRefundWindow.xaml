<Window x:Class="TMDT.Views.Seller.PosRefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:TMDT.Converters"
        Title="Đổi / Trả Hàng tại Quầy" Height="540" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#DC2626" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Restore" Width="26" Height="26" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Hoàn Trả Đơn Hàng" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Tìm đơn hàng theo Mã Đơn để hoàn trả" FontSize="12" Foreground="#FCA5A5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <!-- Search -->
                <TextBlock Text="Nhập Mã Đơn Hàng" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtOrderCode"
                             materialDesign:HintAssist.Hint="VD: ORD-20240703-001"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="44" FontSize="14"
                             KeyDown="txtOrderCode_KeyDown"/>
                    <Button x:Name="btnSearch" Grid.Column="1" Content="Tìm" Width="80" Height="44"
                            Margin="8,0,0,0" Background="#0D9488" Foreground="White"
                            Click="btnSearch_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Order Info -->
                <Border x:Name="pnlOrderInfo" Margin="0,20,0,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="16" Background="#F8FAFC"
                        Visibility="{Binding ElementName=pnlOrderInfo, Path=Tag, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtOrderCodeDisplay" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                            <Border Grid.Column="1" x:Name="badgeStatus" Background="#FEF3C7" CornerRadius="12" Padding="10,3">
                                <TextBlock x:Name="txtStatus" FontSize="12" FontWeight="SemiBold" Foreground="#D97706"/>
                            </Border>
                        </Grid>

                        <Separator Margin="0,10"/>

                        <ItemsControl x:Name="lstDetails">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat={}{0:N0} đ}" FontWeight="Medium" Foreground="#0D9488"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tổng tiền hoàn lại cho khách:" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="txtRefundAmount" Grid.Column="1" FontWeight="Bold" FontSize="18" Foreground="#DC2626"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Warning -->
                <Border x:Name="pnlWarning" Margin="0,16,0,0" Background="#FEF2F2" BorderBrush="#FECACA"
                        BorderThickness="1" CornerRadius="6" Padding="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#DC2626" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtWarning" Foreground="#DC2626" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Đóng" Width="100" Height="40" Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Click="btnCancel_Click"/>
                <Button x:Name="btnRefund" Content="✓  Xác nhận Hoàn Trả" Height="40" Padding="16,0"
                        Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                        IsEnabled="False" Click="btnRefund_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,8"
                                    Opacity="{TemplateBinding Opacity}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
