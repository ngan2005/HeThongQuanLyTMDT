<UserControl x:Class="TMDT.Views.Seller.SellerReviewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMDT.Views.Seller"
             xmlns:vm="clr-namespace:TMDT.ViewModels.Seller"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000" Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Converter To Boolean Visibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="FilterButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="0,0,12,0" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0FDFA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#F0FDFA"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#0D9488"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D9488"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontFamily" Value="Be Vietnam Pro, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Stats & Filters -->
            <RowDefinition Height="*"/>
            <!-- Review List -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Đánh giá Shop" FontSize="24" FontWeight="Bold" Foreground="#1E293B" FontFamily="Be Vietnam Pro, Segoe UI" Margin="0,0,0,24"/>

        <!-- Stats & Filters Section -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" Padding="24" Margin="0,0,0,24" BorderThickness="1" BorderBrush="#E2E8F0">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.03"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Stats -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="150">
                    <TextBlock Text="{Binding AverageRating, StringFormat={}{0:N1} trên 5}" FontSize="32" FontWeight="Bold" Foreground="#0D9488" FontFamily="Be Vietnam Pro, Segoe UI" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
                        <TextBlock Text="&#xE735; &#xE735; &#xE735; &#xE735; &#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#F59E0B"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalReviews, StringFormat={}Tổng {0} đánh giá}" FontSize="13" Foreground="#64748B" FontFamily="Be Vietnam Pro, Segoe UI" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="15,0,16,0" VerticalAlignment="Stretch"/>

                <!-- Right Filters -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Tất cả" Style="{StaticResource FilterButtonStyle}" IsChecked="True" Command="{Binding SetStarFilterCommand}" CommandParameter="All"/>
                        <RadioButton Content="5 Sao" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStarFilterCommand}" CommandParameter="5"/>
                        <RadioButton Content="4 Sao" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStarFilterCommand}" CommandParameter="4"/>
                        <RadioButton Content="3 Sao" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStarFilterCommand}" CommandParameter="3"/>
                        <RadioButton Content="2 Sao" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStarFilterCommand}" CommandParameter="2"/>
                        <RadioButton Content="1 Sao" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStarFilterCommand}" CommandParameter="1"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Trạng thái:" VerticalAlignment="Center" Foreground="#64748B" FontFamily="Be Vietnam Pro, Segoe UI" FontSize="13" Margin="0,0,12,0"/>
                        <RadioButton Content="Tất cả" GroupName="StatusGrp" IsChecked="True" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStatusFilterCommand}" CommandParameter="All"/>
                        <RadioButton Content="Chưa trả lời" GroupName="StatusGrp" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStatusFilterCommand}" CommandParameter="NotReplied"/>
                        <RadioButton Content="Đã trả lời" GroupName="StatusGrp" Style="{StaticResource FilterButtonStyle}" Command="{Binding SetStatusFilterCommand}" CommandParameter="Replied"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Review List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Reviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Review Card -->
                        <Border Background="#FFFFFF" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#E2E8F0">
                            <Border.Effect>
                                <DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="4" Opacity="0.03"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#F1F5F9" VerticalAlignment="Top" HorizontalAlignment="Left" ClipToBounds="True">
                                    <Image Source="{Binding BuyerAvatar}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Content Area -->
                                <StackPanel Grid.Column="1">
                                    <!-- User Info & Stars -->
                                    <Grid>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding BuyerName}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <!-- Custom Star Rendering Logic based on StarRating could go here, for now simple representation -->
                                                <TextBlock Text="&#xE735; &#xE735; &#xE735; &#xE735; &#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" Visibility="{Binding StarRating, ConverterParameter=5, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <!-- If not using converter just show numeric for simplicity or a colored badge -->
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding StarRating}" FontSize="11" FontWeight="Bold" Foreground="#D97706" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D97706" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding ReviewDate}" FontSize="12" Foreground="#94A3B8" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Product Info Tag -->
                                    <Border Background="#F8FAFC" CornerRadius="6" Padding="8,4" Margin="0,12,0,0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE118;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ProductName}" FontSize="12" Foreground="#475569" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Review Content -->
                                    <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#334155" FontFamily="Be Vietnam Pro, Segoe UI" TextWrapping="Wrap" Margin="0,12,0,0"/>

                                    <!-- Review Image (If any) -->
                                    <Border Margin="0,12,0,0" Width="100" Height="100" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding ReviewImageUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Seller Reply Block -->
                                    <Border Background="#F0FDFA" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderThickness="1" BorderBrush="#CCFBF1" Visibility="{Binding HasReply, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Phản hồi của Shop" FontWeight="Bold" FontSize="13" Foreground="#0F766E" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                                <TextBlock Text=" • " Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding ReplyDate}" FontSize="12" Foreground="#64748B" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ReplyContent}" FontSize="13" Foreground="#115E59" FontFamily="Be Vietnam Pro, Segoe UI" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Reply Actions -->
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Command="{Binding DataContext.ToggleReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE115;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0D9488" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Trả lời đánh giá" FontSize="13" FontWeight="SemiBold" Foreground="#0D9488" FontFamily="Be Vietnam Pro, Segoe UI" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasReply}" Value="True">
                                                                    <Setter Property="Text" Value="Chỉnh sửa phản hồi"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Reply Input Box (Visible when IsReplying = True) -->
                                    <Border Margin="0,12,0,0" Background="#F8FAFC" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#E2E8F0" Visibility="{Binding IsReplying, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBox Text="{Binding ReplyInputText, UpdateSourceTrigger=PropertyChanged}" 
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" 
                                                     Background="#FFFFFF" BorderThickness="1" BorderBrush="#CBD5E1" 
                                                     Padding="10" FontSize="13" FontFamily="Be Vietnam Pro, Segoe UI"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button Content="Hủy" 
                                                        Command="{Binding DataContext.ToggleReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" Foreground="#64748B" BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="0,0,8,0" FontFamily="Be Vietnam Pro, Segoe UI" FontWeight="SemiBold"/>
                                                <Button Content="Gửi phản hồi" 
                                                        Command="{Binding DataContext.SubmitReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ActionButtonStyle}" Padding="16,6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
