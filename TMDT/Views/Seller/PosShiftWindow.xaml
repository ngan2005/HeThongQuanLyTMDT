<Window x:Class="TMDT.Views.Seller.PosShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Mở Ca Làm Việc" Height="360" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}">
    <Border Background="White" CornerRadius="14" Margin="16" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F766E" CornerRadius="14,14,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StoreClock" Width="28" Height="28" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Bắt đầu Ca Làm Việc" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Nhập số tiền lẻ trong két khi bắt đầu ca" FontSize="13" Foreground="#CCFBF1" Margin="0,6,0,0"/>
                </StackPanel>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Click="btnClose_Click" Margin="0,-4,-4,0" Padding="0" Width="30" Height="30"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#99F6E4" ToolTip="Đóng">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="Thông tin Ca làm việc" FontWeight="Bold" FontSize="15" Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                <TextBlock x:Name="txtCashierName" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Foreground="#334155"/>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,8,0"/>
                <TextBlock x:Name="txtDateTime" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Foreground="#334155"/>
            </Grid>

            <Separator Margin="0,4,0,16"/>

            <TextBlock Text="Tiền mặt đầu ca (Tiền lẻ trong két)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
            <TextBox x:Name="txtOpeningFloat"
                     materialDesign:HintAssist.Hint="Nhập số tiền (VD: 500000)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="44" FontSize="15" TextAlignment="Right"
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     KeyDown="txtOpeningFloat_KeyDown"/>
            <TextBlock Text="*Nhập 0 nếu không có tiền lẻ ban đầu" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnStart" Content="Bắt Đầu Ca" Width="140" Height="40"
                        Background="#0D9488" Foreground="White" FontWeight="SemiBold"
                        Click="btnStart_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0F766E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
        </Grid>
    </Border>
</Window>
