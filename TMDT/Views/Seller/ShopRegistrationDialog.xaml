<Window x:Class="TMDT.Views.Seller.ShopRegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TMDT.ViewModels.Seller"
        mc:Ignorable="d"
        Title="Đăng ký Cửa hàng"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        MouseDown="Window_MouseDown">

    <Window.DataContext>
        <vm:ShopRegistrationViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Input Field Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#00000022" ShadowDepth="4" Opacity="1"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="#1E1B4B" Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Đăng ký Cửa hàng" FontSize="18" FontWeight="Bold"
                                   Foreground="White" FontFamily="Be Vietnam Pro, Segoe UI"/>
                        <TextBlock Text="Tạo cửa hàng của riêng bạn trên MyShop"
                                   FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" FontFamily="Be Vietnam Pro, Segoe UI"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CloseButton_Click" ToolTip="Đóng">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#94A3B8"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="24,24,24,0">

                <!-- Shop Name -->
                <TextBlock Text="Tên cửa hàng *" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource FieldBorder}">
                    <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" FontSize="13"
                             FontFamily="Be Vietnam Pro, Segoe UI"
                             Padding="0"/>
                </Border>
                <TextBlock Text="Tên shop sẽ hiển thị trên sản phẩm và trang mua sắm"
                           FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,16"/>

                <!-- Warehouse Address -->
                <TextBlock Text="Địa chỉ kho hàng *" Style="{StaticResource FieldLabel}"/>
                <Border Style="{StaticResource FieldBorder}" Height="80">
                    <TextBox Text="{Binding WarehouseAddress, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center" FontSize="13"
                             FontFamily="Be Vietnam Pro, Segoe UI"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Padding="0" VerticalContentAlignment="Center"/>
                </Border>
                <TextBlock Text="Địa chỉ đầy đủ (số nhà, đường, phường/xã, quận/huyện, tỉnh/thành)"
                           FontSize="11" Foreground="#9CA3AF" Margin="0,4,0,16" TextWrapping="Wrap"/>

                <!-- Commission Rate Info -->
                <Border Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="#16A34A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Phí hoa hồng: 3%" FontSize="12" FontWeight="SemiBold" Foreground="#15803D"/>
                            <TextBlock Text="Phí hoa hồng sẽ được áp dụng sau khi shop được duyệt."
                                       FontSize="11" Foreground="#166534" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626" FontSize="12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToBool}}"
                           Margin="0,0,0,8"/>

            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Padding="24,16" Background="#F9FAFB">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="40" Background="#F3F4F6"
                            Foreground="#374151" BorderThickness="0" Cursor="Hand"
                            Command="{Binding CancelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="Hủy bỏ" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Height="40" Width="140" Background="#0D9488"
                            Foreground="White" BorderThickness="0" Cursor="Hand"
                            Command="{Binding SubmitCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <TextBlock Text="Gửi yêu cầu" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Be Vietnam Pro, Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
