<Window x:Class="TMDT.Views.Seller.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng Ký Thành Viên Mới" Height="400" Width="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <Border Background="White" CornerRadius="14" Margin="16" Effect="{StaticResource CardShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F766E" CornerRadius="14,14,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
            <Grid>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="26" Height="26" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Thêm Thành Viên Mới" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Đăng ký nhanh khách hàng tích điểm tại quầy" FontSize="12.5" Foreground="#CCFBF1" Margin="0,4,0,0"/>
                </StackPanel>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Click="btnCancel_Click" Margin="0,-4,-4,0" Padding="0" Width="30" Height="30"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="#99F6E4" ToolTip="Đóng">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <!-- Số điện thoại -->
            <TextBlock Text="Số điện thoại *" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,6"/>
            <TextBox x:Name="txtPhone"
                     materialDesign:HintAssist.Hint="Nhập SĐT khách hàng (VD: 0987654321)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="42" Padding="12,0" FontSize="13.5" VerticalContentAlignment="Center" Margin="0,0,0,14"
                     PreviewTextInput="NumberOnly_PreviewTextInput"
                     MaxLength="11"/>

            <!-- Họ tên -->
            <TextBlock Text="Họ và tên khách hàng *" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B" Margin="0,0,0,6"/>
            <TextBox x:Name="txtFullName"
                     materialDesign:HintAssist.Hint="Nhập Họ và Tên khách hàng"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="42" Padding="12,0" FontSize="13.5" VerticalContentAlignment="Center" Margin="0,0,0,10"
                     MaxLength="50" KeyDown="txtFullName_KeyDown"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="1" x:Name="btnCancel" Content="Hủy bỏ" Width="100" Height="36"
                        Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" BorderThickness="0"
                        Click="btnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3" x:Name="btnSave" Content="Lưu Thành Viên" Width="140" Height="36"
                        Background="#0D9488" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                        Click="btnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
