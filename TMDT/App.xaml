<Application x:Class="TMDT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TMDT"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="Views/Auth/LoginView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Cấu hình Theme và Màu sắc (Không bọc trong ResourceDictionary khác) -->
                <materialDesign:BundledTheme BaseTheme="Light" 
                                             PrimaryColor="DeepPurple" 
                                             SecondaryColor="Lime" />

                <!-- 2. Thư viện Style mặc định của Material Design 3 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- 3. Custom Design System -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/ControlStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/MainStyles.xaml" />
                <ResourceDictionary Source="Resources/Converters.xaml" />
                <!-- 4. Admin Theme (Dark by default) -->
                <ResourceDictionary x:Name="AdminThemeDict" Source="Resources/Themes/AdminDarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
